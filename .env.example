# ==========================================
# NAM HÂN LOGISTICS - MẪU BIẾN MÔI TRƯỜNG (.env)
# ==========================================
# Khi triển khai lên Vercel (hoặc Netlify), hãy thêm các biến này vào:
# Vercel: Project Settings -> Environment Variables
# Netlify: Site configuration -> Environment variables

# ------------------------------------------
# 1. BẢO MẬT & QUẢN TRỊ (BẮT BUỘC)
# ------------------------------------------
# Mật khẩu đăng nhập vào khu vực Quản trị (/admin/)
ADMIN_PASSWORD="namhan@2026!SecureAdmin"

# Khóa bí mật dùng để mã hóa AES-256 các khóa kết nối và ký cookie phiên làm việc (HMAC-SHA256)
# Yêu cầu: Chuỗi ngẫu nhiên có độ dài tối thiểu 32 ký tự
ADMIN_SECRET="namhan_logistics_production_secret_key_8f9e2b1c4a7d6e5f0a3b2c1d"

# ------------------------------------------
# 2. CƠ SỞ DỮ LIỆU ĐÁM MÂY (KHUYÊN DÙNG CHO PRODUCTION TRÊN VERCEL)
# ------------------------------------------
# Dùng Upstash Redis để lưu trữ bài viết Bảng tin, file upload và cấu hình form.
# Miễn phí 100% tại console.upstash.com (Free tier: 10.000 requests/ngày).
# Nếu tích hợp qua Vercel KV, Vercel sẽ tự sinh biến KV_REST_API_URL/TOKEN tương đương.
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-token"

# ------------------------------------------
# 3. TIẾP NHẬN FORM (TÙY CHỌN BỔ SUNG)
# ------------------------------------------
# Khi sử dụng Google Apps Script Web App, toàn bộ URL và Khóa kết nối 
# được cấu hình và lưu trực tiếp trong trang quản trị /admin/google-sheets/,
# KHÔNG CẦN thêm biến môi trường bên dưới.
#
# Chỉ khai báo nếu muốn sử dụng phương án Google Cloud OAuth 2.0:
# GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="your-client-secret"
# GOOGLE_REDIRECT_URI="https://your-domain.vercel.app/api/auth/google/callback"
