# ==========================================
# NAM HÂN LOGISTICS - MẪU BIẾN MÔI TRƯỜNG (.env)
# ==========================================
# Khi triển khai lên Netlify (hoặc môi trường production), hãy thêm các biến này vào:
# Netlify Dashboard -> Site configuration -> Environment variables

# 1. BẮT BUỘC: Mật khẩu đăng nhập trang Quản trị (/admin/)
# Thay đổi thành mật khẩu mạnh của bạn
ADMIN_PASSWORD="namhan@2026!SecureAdmin"

# 2. BẮT BUỘC: Khóa bí mật dùng để mã hóa AES-256 các khóa kết nối và ký cookie phiên làm việc (HMAC-SHA256)
# Yêu cầu: Chuỗi ngẫu nhiên có độ dài tối thiểu 32 ký tự
ADMIN_SECRET="namhan_logistics_production_secret_key_8f9e2b1c4a7d6e5f0a3b2c1d"

# ------------------------------------------
# CÁC BIẾN TÙY CHỌN (KHÔNG BẮT BUỘC)
# ------------------------------------------
# Lưu ý: Khi sử dụng Google Apps Script Web App, toàn bộ URL và Khóa kết nối 
# được cấu hình và lưu trực tiếp trong trang quản trị /admin/google-sheets/
# được lưu trữ an toàn trên Netlify Blobs, KHÔNG CẦN thêm biến môi trường bên dưới.

# Chỉ cần khai báo nếu muốn sử dụng phương án Google Cloud OAuth 2.0:
# GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="your-client-secret"
# GOOGLE_REDIRECT_URI="https://your-domain.netlify.app/api/auth/google/callback"
