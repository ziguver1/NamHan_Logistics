---
import { ROUTES } from '@/lib/routes';
import { aboutAssets } from '@/content/about-assets';
import ImageSlot from '@/components/ui/ImageSlot.astro';

const heroImage = aboutAssets.heroVehicle;
---

<section class="about-hero-section" aria-label="Giới thiệu Nam Hân Logistics">
  <div class="container hero-container">
    <!-- Left: Content & Stats -->
    <div class="hero-content">
      <div class="hero-badge">
        <span class="badge-dot" aria-hidden="true"></span>
        <span>VẬN TẢI HÀNG HÓA ĐƯỜNG BỘ NỘI ĐỊA</span>
      </div>

      <h1 class="hero-title">
        Nam Hân Logistics –<br />
        <span class="text-highlight">Đồng Hành Cùng</span> Mọi Hành Trình
      </h1>

      <p class="hero-desc">
        Đơn vị vận tải hàng hóa đường bộ nội địa, cung cấp giải pháp vận chuyển linh hoạt và đáng tin cậy cho khách hàng doanh nghiệp trên toàn quốc.
      </p>

      <div class="hero-actions">
        <a href="#gioi-thieu" class="btn-primary">
          <span>Khám phá Nam Hân</span>
          <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M10 4.167v11.666m0 0l-4.167-4.166m4.167 4.166l4.167-4.166" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href={ROUTES.CONTACT} class="btn-secondary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 18v-6a9 9 0 0 1 18 0v6"/>
            <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/>
          </svg>
          <span>Liên hệ với chúng tôi</span>
        </a>
      </div>

      <!-- Trust highlights -->
      <div class="hero-stats">
        <div class="stat-item">
          <span class="stat-highlight">24/7/365</span>
          <span class="stat-label">Giám sát lộ trình liên tục</span>
        </div>
        <div class="stat-divider" aria-hidden="true"></div>
        <div class="stat-item">
          <span class="stat-highlight">100% B2B</span>
          <span class="stat-label">Hợp đồng pháp lý minh bạch</span>
        </div>
        <div class="stat-divider" aria-hidden="true"></div>
        <div class="stat-item">
          <span class="stat-highlight">BẮC - TRUNG - NAM</span>
          <span class="stat-label">Trục giao thương huyết mạch</span>
        </div>
      </div>
    </div>

    <!-- Right: Visual Media Slot -->
    <div class="hero-media">
      <div class="hero-image-card">
        <ImageSlot
          src={heroImage?.src}
          alt={heroImage?.alt}
          label={heroImage?.label}
          aspectRatio="4/5"
          rounded="xl"
          priority={true}
          class="hero-slot"
        />

        <!-- Floating Card Badge -->
        <div class="floating-truck-card">
          <div class="truck-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="1" y="3" width="15" height="13" rx="1"/>
              <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
              <circle cx="5.5" cy="18.5" r="2.5"/>
              <circle cx="18.5" cy="18.5" r="2.5"/>
            </svg>
          </div>
          <div class="truck-info">
            <span class="truck-title">Đội xe container chuyên dụng</span>
            <span class="truck-sub">Lộ trình QL1A & Cao tốc Bắc - Nam</span>
          </div>
          <div class="truck-status">
            <span class="status-dot" aria-hidden="true"></span>
            <span>ACTIVE</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-hero-section {
    background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
    padding-top: clamp(2.5rem, 5vw, 4.5rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
    border-bottom: 1px solid var(--color-border);
    position: relative;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
    min-width: 0;
  }

  @media (min-width: 1024px) {
    .hero-container {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 3.5rem;
    }
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    min-width: 0;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    align-self: flex-start;
    padding: 0.375rem 0.875rem;
    background-color: #fff1eb;
    border: 1px solid #fed7aa;
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--color-brand-orange);
  }

  .badge-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: var(--radius-full);
    background-color: var(--color-brand-orange);
  }

  .hero-title {
    font-size: clamp(1.5rem, 6.5vw, 3.25rem);
    font-weight: 900;
    line-height: 1.15;
    color: var(--color-brand-navy);
    letter-spacing: -0.025em;
    word-break: break-word;
  }

  .text-highlight {
    color: var(--color-brand-orange);
  }

  .hero-desc {
    font-size: var(--font-body);
    color: var(--color-text-secondary);
    line-height: 1.65;
    max-width: 36rem;
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    margin-top: 0.5rem;
  }

  @media (min-width: 640px) {
    .hero-actions {
      flex-direction: row;
      align-items: center;
    }
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: var(--touch-target-min);
    background-color: var(--color-brand-orange);
    color: var(--color-text-inverse);
    font-weight: 700;
    font-size: 0.9375rem;
    padding: 0.875rem 1.75rem;
    border-radius: var(--radius-md);
    box-shadow: 0 4px 12px rgba(249, 80, 22, 0.25);
    transition: all var(--transition-fast);
  }

  .btn-primary:hover {
    background-color: var(--color-brand-orange-hover);
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(249, 80, 22, 0.35);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: var(--touch-target-min);
    background-color: var(--color-bg-page);
    color: var(--color-brand-navy);
    border: 1px solid var(--color-border-strong);
    font-weight: 600;
    font-size: 0.9375rem;
    padding: 0.875rem 1.75rem;
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
  }

  .btn-secondary:hover {
    background-color: var(--color-bg-muted);
    border-color: var(--color-brand-navy);
  }

  /* Stats Row */
  .hero-stats {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 640px) {
    .hero-stats {
      grid-template-columns: repeat(3, auto);
      align-items: center;
      gap: 1.25rem;
    }
  }

  .stat-item {
    display: flex;
    flex-direction: column;
  }

  .stat-highlight {
    font-size: 1.125rem;
    font-weight: 800;
    color: var(--color-brand-navy);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .stat-label {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    margin-top: 0.25rem;
  }

  .stat-divider {
    display: none;
    width: 1px;
    height: 2.25rem;
    background-color: var(--color-border);
  }

  @media (min-width: 640px) {
    .stat-divider {
      display: block;
    }
  }

  /* Media Card */
  .hero-media {
    position: relative;
    width: 100%;
  }

  .hero-image-card {
    position: relative;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
  }

  .floating-truck-card {
    position: absolute;
    bottom: -1rem;
    left: 1rem;
    right: 1rem;
    background-color: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    padding: 0.875rem 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.875rem;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
    z-index: 2;
  }

  @media (min-width: 640px) {
    .floating-truck-card {
      left: 1.5rem;
      right: auto;
      max-width: calc(100% - 3rem);
    }
  }

  .truck-icon {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-md);
    background-color: #fff1eb;
    color: var(--color-brand-orange);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .truck-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .truck-title {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-brand-navy);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .truck-sub {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .truck-status {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    background-color: #dcfce7;
    color: #166534;
    font-size: 0.6875rem;
    font-weight: 700;
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-full);
    flex-shrink: 0;
  }

  .status-dot {
    width: 0.375rem;
    height: 0.375rem;
    border-radius: var(--radius-full);
    background-color: #22c55e;
  }

  @media (max-width: 480px) {
    .floating-truck-card {
      position: static;
      margin-top: 1rem;
      padding: 0.75rem;
      gap: 0.625rem;
    }

    .truck-title,
    .truck-sub {
      white-space: normal;
    }
  }
</style>
