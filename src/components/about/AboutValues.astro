---
const values = [
  {
    num: '01',
    name: 'UY TÍN',
    subtitle: 'Nền tảng phát triển',
    desc: 'Cam kết giữ đúng hẹn, bảo toàn nguyên vẹn hàng hóa và minh bạch trong mọi thỏa thuận hợp tác.',
    points: [
      'Chuẩn mực giờ xuất bến',
      'Bảo hiểm hàng hóa minh bạch',
      'Đối soát số liệu trung thực',
    ],
  },
  {
    num: '02',
    name: 'LINH HOẠT',
    subtitle: 'Thích ứng vận hành',
    desc: 'Nhanh nhạy điều chỉnh phương án vận chuyển theo biến động thực tế của thị trường và nhu cầu của đối tác.',
    points: [
      'Ghép hàng đa phương thức',
      'Huy động xe đột xuất',
      'Lộ trình tùy biến tối ưu',
    ],
  },
  {
    num: '03',
    name: 'ĐỒNG HÀNH',
    subtitle: 'Hợp tác bền vững',
    desc: 'Coi thành công của khách hàng là mục tiêu phấn đấu, xây dựng mối quan hệ tin cậy và gắn kết dài lâu.',
    points: [
      'Hỗ trợ 24/7 chuyên trách',
      'Chính sách công nợ ưu đãi',
      'Giải quyết khiếu nại nhanh chóng',
    ],
  },
];
---

<section class="about-values-section" aria-label="Giá trị cốt lõi">
  <div class="container">
    <div class="section-header">
      <div class="section-tag">NGUYÊN TẮC HÀNH ĐỘNG</div>
      <h2 class="section-title">Giá trị Nam Hân theo đuổi</h2>
      <p class="section-desc">
        Ba trụ cột định hướng cho mọi quyết định và hành động trong hành trình phát triển của chúng tôi.
      </p>
    </div>

    <div class="values-grid">
      {values.map((val) => (
        <div class="value-card">
          <div class="val-header">
            <span class="val-num">{val.num}</span>
            <div class="val-titles">
              <span class="val-name">{val.name}</span>
              <span class="val-subtitle">{val.subtitle}</span>
            </div>
          </div>

          <p class="val-desc">{val.desc}</p>

          <ul class="val-points">
            {val.points.map((p) => (
              <li>
                <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="check-icon" aria-hidden="true">
                  <polyline points="4 11 8 15 16 6"/>
                </svg>
                <span>{p}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .about-values-section {
    padding-top: var(--section-space);
    padding-bottom: var(--section-space);
    background-color: #f8fafc;
    border-bottom: 1px solid var(--color-border);
  }

  .section-header {
    text-align: center;
    max-width: 44rem;
    margin-inline: auto;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .section-tag {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-brand-orange);
  }

  .section-title {
    font-size: clamp(1.75rem, 2.5vw + 0.75rem, 2.5rem);
    font-weight: 800;
    color: var(--color-brand-navy);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .section-desc {
    font-size: var(--font-body);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .values-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }

  @media (min-width: 768px) {
    .values-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .value-card {
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: clamp(1.5rem, 3vw, 2rem);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02);
    transition: transform var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .value-card:hover {
    transform: translateY(-3px);
    border-color: #fed7aa;
    box-shadow: 0 12px 20px -3px rgba(0, 0, 0, 0.06);
  }

  .val-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .val-num {
    font-size: 1.5rem;
    font-weight: 900;
    color: var(--color-brand-orange);
    background-color: #fff1eb;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .val-titles {
    display: flex;
    flex-direction: column;
  }

  .val-name {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-brand-navy);
    letter-spacing: 0.02em;
  }

  .val-subtitle {
    font-size: 0.8125rem;
    color: var(--color-brand-orange);
    font-weight: 600;
  }

  .val-desc {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .val-points {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: auto;
  }

  .val-points li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: #475569;
    line-height: 1.45;
  }

  .check-icon {
    color: var(--color-brand-orange);
    flex-shrink: 0;
    margin-top: 0.125rem;
  }
</style>
