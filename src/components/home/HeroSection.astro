---
// Hero Section for Home page (Frame 44:1456)
---

<section class="hero-section" aria-label="Giới thiệu Nam Hân Logistics">
  <!-- Hero Background Image & High-Contrast Overlay -->
  <div class="hero-bg" aria-hidden="true">
    <img
      src="/images/home/hero-truck.webp"
      alt=""
      class="hero-bg-img"
      width="1280"
      height="500"
      fetchpriority="high"
      decoding="async"
    />
    <div class="hero-overlay"></div>
  </div>

  <div class="container hero-container">
    <div class="hero-content">
      <p class="hero-tag">NAM HÂN LOGISTICS</p>
      <h1 class="hero-title">
        DOANH NGHIỆP VẬN TẢI ĐƯỜNG BỘ<br class="br-desktop" />
        CUNG CẤP GIẢI PHÁP LOGISTICS<br class="br-desktop" />
        TOÀN QUỐC
      </h1>
      <div class="hero-actions">
        <a href="#overview" class="btn-hero">
          <span>Xem thêm</span>
          <span class="btn-arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    width: 100%;
    min-height: 380px;
    display: flex;
    align-items: center;
    overflow: hidden;
    background-color: var(--color-brand-navy, #0b2545);
  }

  @media (min-width: 768px) {
    .hero-section {
      min-height: 440px;
    }
  }

  @media (min-width: 1024px) {
    .hero-section {
      min-height: 500px;
      height: 500px;
    }
  }

  /* Background Image & Overlay Layering */
  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
  }

  .hero-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 65% center;
    display: block;
  }

  @media (min-width: 1024px) {
    .hero-bg-img {
      object-position: center;
    }
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    /* High-contrast gradient overlay ensuring readability on both mobile and desktop */
    background: linear-gradient(
      180deg,
      rgba(7, 24, 46, 0.92) 0%,
      rgba(7, 24, 46, 0.82) 100%
    );
  }

  @media (min-width: 768px) {
    .hero-overlay {
      background: linear-gradient(
        90deg,
        rgba(7, 24, 46, 0.94) 0%,
        rgba(7, 24, 46, 0.85) 38%,
        rgba(7, 24, 46, 0.5) 65%,
        rgba(7, 24, 46, 0.12) 100%
      );
    }
  }

  /* Foreground Container */
  .hero-container {
    position: relative;
    z-index: 2;
    padding-top: clamp(3.5rem, 8vw, 9.25rem);
    padding-bottom: clamp(2.5rem, 5vw, 5.5rem);
  }

  .hero-content {
    max-width: 40rem; /* ~640px on desktop */
  }

  .hero-tag {
    color: #38bdf8; /* Cyan/sky-blue matching design */
    font-size: clamp(0.75rem, 1vw, 0.875rem);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 0.75rem 0;
    line-height: 1.2;
  }

  .hero-title {
    color: #ffffff;
    font-size: clamp(0.9375rem, 4.2vw, 2.25rem);
    font-weight: 800;
    line-height: 1.25;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    margin: 0 0 1.25rem 0;
    overflow-wrap: break-word;
  }

  .br-desktop {
    display: none;
  }

  @media (min-width: 640px) {
    .br-desktop {
      display: inline;
    }
  }

  .hero-actions {
    display: flex;
    align-items: center;
  }

  /* Blue Call to Action Button */
  .btn-hero {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    min-height: var(--touch-target-min, 44px);
    background-color: #0070ba;
    color: #ffffff;
    font-size: 0.875rem;
    font-weight: 600;
    padding: 0.5rem 1.125rem;
    border-radius: 6px;
    text-decoration: none;
    box-shadow: 0 2px 8px rgba(0, 112, 186, 0.35);
    transition: background-color var(--transition-fast, 150ms ease),
                transform var(--transition-fast, 150ms ease),
                box-shadow var(--transition-fast, 150ms ease);
  }

  .btn-hero:hover {
    background-color: #005a96;
    color: #ffffff;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(0, 112, 186, 0.45);
  }

  .btn-hero:active {
    transform: translateY(0);
  }

  .btn-hero:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 2px;
  }

  .btn-arrow {
    display: inline-block;
    transition: transform var(--transition-fast, 150ms ease);
  }

  .btn-hero:hover .btn-arrow {
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .btn-hero,
    .btn-arrow {
      transition: none;
      transform: none !important;
    }
  }
</style>
