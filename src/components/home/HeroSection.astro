---
// Hero Section for Home page (Frame 44:1456)
// Open, grand typography directly over high-definition background video.
// Zero orphan words, balanced two-line corporate statement & WCAG AAA contrast.
import HeroVideoBackground from './HeroVideoBackground.astro';
---

<section class="hero-section" aria-label="Giới thiệu Nam Hân Logistics">
  <!-- Cinematic Background Video with Preload Curtain & Audio Control -->
  <HeroVideoBackground />

  <div class="container hero-container">
    <div class="hero-content">
      <!-- Tag / Category Header -->
      <div class="hero-tag-wrap">
        <span class="hero-tag-bar"></span>
        <span class="hero-tag-text">NAM HÂN LOGISTICS &bull; GIẢI PHÁP VẬN TẢI CHUYÊN NGHIỆP</span>
      </div>

      <!-- Main Prestige Headline: Balanced 2 lines, ZERO orphan words -->
      <h1 class="hero-title">
        <span class="title-line-primary">DOANH NGHIỆP VẬN TẢI ĐƯỜNG BỘ</span>
        <span class="title-line-accent">CUNG CẤP GIẢI PHÁP LOGISTICS <span class="text-nowrap">TOÀN&nbsp;QUỐC</span></span>
      </h1>

      <!-- Executive Value Badges: Sleek Floating Translucent Capsules -->
      <div class="hero-badges">
        <div class="badge-item">
          <svg class="badge-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
          <span>Toàn trình Bắc — Nam 24/7</span>
        </div>
        <div class="badge-item">
          <svg class="badge-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
          <span>Đội xe Container &amp; Tải nặng</span>
        </div>
        <div class="badge-item">
          <svg class="badge-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
          <span>Bốc xếp &amp; Kho bãi trọn gói</span>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="hero-actions">
        <a href="#overview" class="btn-hero-primary">
          <span>Xem thêm dịch vụ</span>
          <span class="btn-arrow" aria-hidden="true">&rarr;</span>
        </a>
        <a href="/lien-he" class="btn-hero-secondary">
          <span>Liên hệ báo giá</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    width: 100%;
    max-width: 100%;
    min-height: clamp(520px, calc(100vh - 4.5rem), 880px);
    min-height: clamp(520px, calc(100svh - 4.5rem), 880px);
    display: flex;
    align-items: center; /* Balanced vertical centering */
    overflow: hidden;
    contain: paint;
    clip-path: inset(0);
    background-color: #050b14;
  }

  @media (min-width: 1024px) {
    .hero-section {
      min-height: clamp(580px, calc(100vh - 4.5rem), 880px);
      height: clamp(580px, calc(100vh - 4.5rem), 920px);
    }
  }

  /* Foreground Container - Aligned with site container grid */
  .hero-container {
    position: relative;
    z-index: 5;
    padding-top: clamp(2.5rem, 5vw, 4rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .hero-content {
    max-width: 48rem;
  }

  .text-nowrap {
    white-space: nowrap;
  }

  /* Tag / Category Header */
  .hero-tag-wrap {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 1.125rem;
    padding: 0.35rem 0.85rem;
    background: rgba(3, 7, 18, 0.55);
    border: 1px solid rgba(56, 189, 248, 0.35);
    border-radius: 9999px;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .hero-tag-bar {
    width: 8px;
    height: 8px;
    background-color: #38bdf8;
    border-radius: 50%;
    box-shadow: 0 0 8px #38bdf8;
    flex-shrink: 0;
  }

  .hero-tag-text {
    color: #e0f2fe;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* Main Headline - Grand, Powerful, Zero Orphan Words */
  .hero-title {
    margin: 0 0 1.5rem 0;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    line-height: 1.18;
  }

  .title-line-primary {
    display: block;
    color: #ffffff;
    font-size: clamp(1.625rem, 3.8vw, 2.75rem);
    font-weight: 900;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.85),
                 0 6px 24px rgba(0, 0, 0, 0.65);
    margin-bottom: 0.25rem;
  }

  .title-line-accent {
    display: block;
    color: #38bdf8;
    font-size: clamp(1.45rem, 3.4vw, 2.45rem);
    font-weight: 800;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.9),
                 0 0 28px rgba(56, 189, 248, 0.35);
  }

  /* Executive Value Badges: Sleek Translucent Capsules */
  .hero-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem 0.875rem;
    margin-bottom: 1.875rem;
  }

  .badge-item {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: rgba(3, 7, 18, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 9999px;
    padding: 0.45rem 1rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #f8fafc;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.35);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .badge-item:hover {
    border-color: rgba(56, 189, 248, 0.6);
    transform: translateY(-1px);
  }

  .badge-icon {
    width: 14px;
    height: 14px;
    color: #38bdf8;
    flex-shrink: 0;
  }

  /* Action Buttons */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.875rem;
  }

  /* Primary Blue Button */
  .btn-hero-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: var(--touch-target-min, 46px);
    background: linear-gradient(135deg, #0284c7 0%, #0070ba 100%);
    color: #ffffff;
    font-size: 0.875rem;
    font-weight: 700;
    padding: 0.65rem 1.5rem;
    border-radius: 8px;
    text-decoration: none;
    box-shadow: 0 4px 18px rgba(2, 132, 199, 0.45);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .btn-hero-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(2, 132, 199, 0.65);
  }

  .btn-hero-primary:active {
    transform: translateY(0);
  }

  .btn-hero-primary:focus-visible {
    outline: 2px solid #38bdf8;
    outline-offset: 2px;
  }

  .btn-arrow {
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .btn-hero-primary:hover .btn-arrow {
    transform: translateX(3px);
  }

  /* Secondary Button */
  .btn-hero-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-target-min, 46px);
    background-color: rgba(255, 255, 255, 0.12);
    color: #ffffff;
    font-size: 0.875rem;
    font-weight: 700;
    padding: 0.65rem 1.5rem;
    border-radius: 8px;
    border: 1.5px solid rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);
    transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
  }

  .btn-hero-secondary:hover {
    background-color: #ffffff;
    color: #0b2545;
    border-color: #ffffff;
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .btn-hero-primary,
    .btn-hero-secondary,
    .btn-arrow {
      transition: none;
      transform: none !important;
    }
  }
</style>
