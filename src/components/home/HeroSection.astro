---
// Hero Section for Home page (Frame 44:1456)
// Refined Corporate Logistics Layout: High-End Typography, Clean Separation from Highway Ground
import NightHighwayAnimation from './NightHighwayAnimation.astro';
---

<section class="hero-section" aria-label="Giới thiệu Nam Hân Logistics">
  <!-- Sky-Blue Canvas with Drifting Clouds, Roadway & Animated Truck Fleet -->
  <NightHighwayAnimation />

  <!-- Subtle gradient wash to enhance text contrast on the left -->
  <div class="hero-backdrop-wash" aria-hidden="true"></div>

  <div class="container hero-container">
    <div class="hero-content">
      <!-- Tag / Category Header -->
      <div class="hero-tag-wrap">
        <span class="hero-tag-bar"></span>
        <span class="hero-tag-text">NAM HÂN LOGISTICS &bull; GIẢI PHÁP VẬN TẢI CHUYÊN NGHIỆP</span>
      </div>

      <!-- Main Prestige Headline -->
      <h1 class="hero-title">
        DOANH NGHIỆP VẬN TẢI ĐƯỜNG BỘ<br class="br-desktop" />
        <span class="hero-title-accent">CUNG CẤP GIẢI PHÁP LOGISTICS <span class="text-nowrap">TOÀN&nbsp;QUỐC</span></span>
      </h1>

      <!-- Executive Value Badges -->
      <div class="hero-badges">
        <div class="badge-item">
          <svg class="badge-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
          <span>Toàn trình Bắc — Nam 24/7</span>
        </div>
        <div class="badge-item">
          <svg class="badge-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
          <span>Đội xe Container &amp; Tải nặng</span>
        </div>
        <div class="badge-item">
          <svg class="badge-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
          <span>Bốc xếp &amp; Kho bãi trọn gói</span>
        </div>
      </div>

      <!-- Action Buttons (Strictly positioned in the sky area, never touching the road) -->
      <div class="hero-actions">
        <a href="#overview" class="btn-hero-primary">
          <span>Xem thêm dịch vụ</span>
          <span class="btn-arrow" aria-hidden="true">&rarr;</span>
        </a>
        <a href="/lien-he" class="btn-hero-secondary">
          <span>Liên hệ báo giá</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    width: 100%;
    max-width: 100%;
    min-height: 540px;
    display: flex;
    align-items: flex-start; /* Aligns content to top so it stays in the sky zone */
    overflow: hidden;
    contain: paint;
    clip-path: inset(0);
    background-color: #72bbf6;
  }

  @media (min-width: 768px) {
    .hero-section {
      min-height: 560px;
    }
  }

  @media (min-width: 1024px) {
    .hero-section {
      min-height: 600px;
      height: 600px;
    }
  }

  /* Subtle gradient wash: soft white tint on the left, clear sky on the right */
  .hero-backdrop-wash {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
    background: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.72) 0%,
      rgba(255, 255, 255, 0.5) 36%,
      rgba(255, 255, 255, 0.1) 62%,
      transparent 85%
    );
  }

  @media (max-width: 767px) {
    .hero-backdrop-wash {
      background: linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.78) 0%,
        rgba(255, 255, 255, 0.55) 55%,
        transparent 100%
      );
    }
  }

  /* Foreground Container - Top-aligned with ample bottom spacing before road */
  .hero-container {
    position: relative;
    z-index: 3;
    width: 100%;
    padding-top: clamp(2.25rem, 5vw, 4.25rem);
    padding-bottom: clamp(9rem, 20vw, 11rem); /* Large bottom clearance guarantees text never touches road */
  }

  .hero-content {
    max-width: 50rem;
  }

  .text-nowrap {
    white-space: nowrap;
  }

  /* Tag Header */
  .hero-tag-wrap {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 0.75rem;
  }

  .hero-tag-bar {
    width: 24px;
    height: 3px;
    background-color: #0070ba;
    border-radius: 2px;
  }

  .hero-tag-text {
    color: #0070ba;
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* Main Headline */
  .hero-title {
    color: #0b2545;
    font-size: clamp(1.375rem, 4.8vw, 2.375rem);
    font-weight: 900;
    line-height: 1.25;
    text-transform: uppercase;
    letter-spacing: -0.015em;
    margin: 0 0 1.125rem 0;
    overflow-wrap: break-word;
    text-shadow: 0 1px 2px rgba(255, 255, 255, 0.85);
  }

  .hero-title-accent {
    color: #005a96;
  }

  .br-desktop {
    display: none;
  }

  @media (min-width: 640px) {
    .br-desktop {
      display: inline;
    }
  }

  /* Executive Badges */
  .hero-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin-bottom: 1.5rem;
  }

  .badge-item {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    background: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(0, 112, 186, 0.25);
    border-radius: 6px;
    padding: 0.35rem 0.75rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #1e3a5f;
    box-shadow: 0 2px 6px rgba(11, 37, 69, 0.05);
    backdrop-filter: blur(4px);
  }

  .badge-icon {
    width: 14px;
    height: 14px;
    color: #0070ba;
    flex-shrink: 0;
  }

  /* Action Buttons */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  /* Primary Blue Button */
  .btn-hero-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    min-height: var(--touch-target-min, 44px);
    background-color: #0070ba;
    color: #ffffff;
    font-size: 0.875rem;
    font-weight: 700;
    padding: 0.55rem 1.35rem;
    border-radius: 6px;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(0, 112, 186, 0.35);
    transition: background-color var(--transition-fast, 150ms ease),
                transform var(--transition-fast, 150ms ease),
                box-shadow var(--transition-fast, 150ms ease);
  }

  .btn-hero-primary:hover {
    background-color: #005a96;
    color: #ffffff;
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(0, 112, 186, 0.45);
  }

  .btn-hero-primary:active {
    transform: translateY(0);
  }

  .btn-hero-primary:focus-visible {
    outline: 2px solid #0070ba;
    outline-offset: 2px;
  }

  .btn-arrow {
    display: inline-block;
    transition: transform var(--transition-fast, 150ms ease);
  }

  .btn-hero-primary:hover .btn-arrow {
    transform: translateX(3px);
  }

  /* Secondary Button */
  .btn-hero-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-target-min, 44px);
    background-color: #ffffff;
    color: #0b2545;
    font-size: 0.875rem;
    font-weight: 700;
    padding: 0.55rem 1.35rem;
    border-radius: 6px;
    border: 1.5px solid #0070ba;
    text-decoration: none;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    transition: background-color var(--transition-fast, 150ms ease),
                color var(--transition-fast, 150ms ease),
                transform var(--transition-fast, 150ms ease);
  }

  .btn-hero-secondary:hover {
    background-color: #0070ba;
    color: #ffffff;
    transform: translateY(-1px);
  }

  @media (prefers-reduced-motion: reduce) {
    .btn-hero-primary,
    .btn-hero-secondary,
    .btn-arrow {
      transition: none;
      transform: none !important;
    }
  }
</style>
