---
// Hero Section for Home page (Frame 44:1456)
import NightHighwayAnimation from './NightHighwayAnimation.astro';
---

<section class="hero-section" aria-label="Giới thiệu Nam Hân Logistics">
  <!-- 2D Night Expressway Animation with Light-Trails -->
  <NightHighwayAnimation />

  <!-- High-contrast vignette ensuring text legibility on left side -->
  <div class="hero-overlay" aria-hidden="true"></div>

  <div class="container hero-container">
    <div class="hero-content">
      <p class="hero-tag">NAM HÂN LOGISTICS</p>
      <h1 class="hero-title">
        DOANH NGHIỆP VẬN TẢI ĐƯỜNG BỘ<br class="br-desktop" />
        CUNG CẤP GIẢI PHÁP LOGISTICS<br class="br-desktop" />
        TOÀN QUỐC
      </h1>
      <div class="hero-actions">
        <a href="#overview" class="btn-hero">
          <span>Xem thêm</span>
          <span class="btn-arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    width: 100%;
    max-width: 100%;
    min-height: 420px;
    display: flex;
    align-items: center;
    overflow: hidden;
    contain: paint;
    clip-path: inset(0);
    background-color: var(--color-brand-navy, #0b2545);
  }

  @media (min-width: 768px) {
    .hero-section {
      min-height: 460px;
    }
  }

  @media (min-width: 1024px) {
    .hero-section {
      min-height: 520px;
      height: 520px;
    }
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
    background: linear-gradient(
      180deg,
      rgba(3, 12, 24, 0.82) 0%,
      rgba(3, 12, 24, 0.45) 55%,
      rgba(3, 12, 24, 0.1) 100%
    );
  }

  @media (min-width: 768px) {
    .hero-overlay {
      background: linear-gradient(
        90deg,
        rgba(3, 12, 24, 0.94) 0%,
        rgba(3, 12, 24, 0.82) 42%,
        rgba(3, 12, 24, 0.25) 75%,
        transparent 100%
      );
    }
  }

  /* Foreground Container */
  .hero-container {
    position: relative;
    z-index: 3;
    padding-top: clamp(3.5rem, 8vw, 9.25rem);
    padding-bottom: clamp(2.5rem, 5vw, 5.5rem);
  }

  .hero-content {
    max-width: 40rem; /* ~640px on desktop */
  }

  .hero-tag {
    color: #38bdf8; /* Cyan/sky-blue matching design */
    font-size: clamp(0.75rem, 1vw, 0.875rem);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 0.75rem 0;
    line-height: 1.2;
  }

  .hero-title {
    color: #ffffff;
    font-size: clamp(0.9375rem, 4.2vw, 2.25rem);
    font-weight: 800;
    line-height: 1.25;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    margin: 0 0 1.25rem 0;
    overflow-wrap: break-word;
  }

  .br-desktop {
    display: none;
  }

  @media (min-width: 640px) {
    .br-desktop {
      display: inline;
    }
  }

  .hero-actions {
    display: flex;
    align-items: center;
  }

  /* Blue Call to Action Button */
  .btn-hero {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    min-height: var(--touch-target-min, 44px);
    background-color: #0070ba;
    color: #ffffff;
    font-size: 0.875rem;
    font-weight: 600;
    padding: 0.5rem 1.125rem;
    border-radius: 6px;
    text-decoration: none;
    box-shadow: 0 2px 8px rgba(0, 112, 186, 0.35);
    transition: background-color var(--transition-fast, 150ms ease),
                transform var(--transition-fast, 150ms ease),
                box-shadow var(--transition-fast, 150ms ease);
  }

  .btn-hero:hover {
    background-color: #005a96;
    color: #ffffff;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(0, 112, 186, 0.45);
  }

  .btn-hero:active {
    transform: translateY(0);
  }

  .btn-hero:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 2px;
  }

  .btn-arrow {
    display: inline-block;
    transition: transform var(--transition-fast, 150ms ease);
  }

  .btn-hero:hover .btn-arrow {
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .btn-hero,
    .btn-arrow {
      transition: none;
      transform: none !important;
    }
  }
</style>
