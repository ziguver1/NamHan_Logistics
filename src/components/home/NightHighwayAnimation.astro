---
// Bee Logistics-Inspired Hero Canvas Component
// Bright Sunny Sky-Blue canvas with photorealistic drifting clouds,
// Ground-level roadway & Nam Han Logistics Flagship Container Semi-Truck in video replay motion
// Replay loop: Drives from left -> stops at center for 2s -> accelerates slowly then quickly to the right -> repeats
---

<div class="bee-hero-scene" aria-hidden="true">
  <!-- Sunlit Sky Backdrop with Soft Sun Flare -->
  <div class="sky-canvas">
    <div class="sun-flare"></div>
    <div class="sun-glow"></div>

    <!-- Photorealistic Drifting Clouds Layer -->
    <div class="clouds-stream clouds-track-1"></div>
    <div class="clouds-stream clouds-track-2"></div>
  </div>

  <!-- Road Surface Ground Layer (Contains only the asphalt and lane markings) -->
  <div class="road-ground">
    <!-- Curb Border matching Bee Logistics signature border -->
    <div class="road-curb"></div>

    <!-- Daylight Road Asphalt Surface -->
    <div class="road-surface">
      <!-- Sunlight reflection sheen on smooth asphalt -->
      <div class="road-sheen"></div>

      <!-- Animated Moving Highway Lane Markings -->
      <div class="lane-markings"></div>
      <div class="edge-line edge-top"></div>
      <div class="edge-line edge-bottom"></div>
    </div>
  </div>

  <!-- Vehicles Stage Layer: Spans 100% height of scene so vehicles are NEVER clipped from above -->
  <div class="vehicles-stage">
    <!-- Nam Han Logistics Flagship Container Semi-Truck (Video-Replay Motion Loop) -->
    <div class="truck-convoy">
      <div class="truck-suspension-bounce">
        <img
          src="/images/home/bee-truck-namhan.webp"
          alt="Xe container Nam Hân Logistics"
          class="truck-img"
          width="1000"
          height="302"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
  </div>
</div>

<style>
  .bee-hero-scene {
    position: absolute;
    inset: 0;
    width: 100%;
    max-width: 100%;
    height: 100%;
    overflow: hidden;
    contain: paint;
    clip-path: inset(0);
    /* Vibrant, fresh Sky-Blue canvas inspired by Bee Logistics */
    background: linear-gradient(180deg, #5ea5e6 0%, #7ec4f8 35%, #9fd5f8 70%, #d4ecfd 100%);
    pointer-events: none;
    z-index: 1;
  }

  /* Sky Canvas & Sun Elements */
  .sky-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    max-width: 100%;
    height: 100%;
    overflow: hidden;
  }

  /* Realistic Soft Sun with Natural Atmospheric Glow */
  .sun-flare {
    position: absolute;
    top: 5%;
    right: 14%;
    width: 70px;
    height: 70px;
    background: radial-gradient(circle, #ffffff 20%, rgba(255, 243, 199, 0.9) 45%, rgba(254, 215, 170, 0.4) 70%, transparent 100%);
    border-radius: 50%;
    box-shadow: 0 0 35px rgba(255, 255, 255, 0.9), 0 0 70px rgba(254, 240, 138, 0.6);
  }

  .sun-glow {
    position: absolute;
    top: -15%;
    right: 5%;
    width: 320px;
    height: 320px;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.35) 0%, rgba(254, 240, 138, 0.12) 50%, transparent 75%);
    border-radius: 50%;
    filter: blur(14px);
  }

  /* Photorealistic Drifting Clouds Layer (Continuous Seamless Panoramic Scroll) */
  .clouds-stream {
    position: absolute;
    top: 0;
    left: 0;
    width: 200%;
    height: 100%;
    background-image: url('/images/home/bee-clouds.webp');
    background-repeat: repeat-x;
    background-size: auto 85%;
    background-position: left top;
    will-change: transform;
    pointer-events: none;
  }

  .clouds-track-1 {
    opacity: 0.85;
    animation: cloudsScroll 55s linear infinite;
  }

  .clouds-track-2 {
    top: 15px;
    opacity: 0.55;
    animation: cloudsScroll 75s linear infinite reverse;
    filter: blur(1px);
  }

  @keyframes cloudsScroll {
    0% { transform: translate3d(0, 0, 0); }
    100% { transform: translate3d(-50%, 0, 0); }
  }

  /* Road Ground Layer (Strictly 80px asphalt surface at the very bottom) */
  .road-ground {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    max-width: 100%;
    height: 80px;
    overflow: hidden;
    contain: paint;
    clip-path: inset(0);
    z-index: 2;
  }

  @media (max-width: 767px) {
    .road-ground {
      height: 70px;
    }
  }

  /* Road Curb Border matching Bee Logistics signature border */
  .road-curb {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 6px;
    background: linear-gradient(90deg, #c4b59d 0%, #ded3c1 50%, #c4b59d 100%);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.2);
    z-index: 3;
  }

  /* Daylight Highway Slate Asphalt */
  .road-surface {
    position: absolute;
    inset: 6px 0 0 0;
    width: 100%;
    max-width: 100%;
    background: linear-gradient(180deg, #374151 0%, #2b3340 40%, #1f2937 100%);
    box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.35);
    overflow: hidden;
  }

  .road-sheen {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 60% 15%, rgba(255, 255, 255, 0.12) 0%, transparent 65%);
    pointer-events: none;
  }

  .edge-line {
    position: absolute;
    left: 0;
    width: 100%;
    max-width: 100%;
    height: 2px;
  }

  .edge-top {
    top: 2px;
    background: #ffffff;
    opacity: 0.9;
  }

  .edge-bottom {
    bottom: 4px;
    background: #9ca3af;
    opacity: 0.7;
  }

  /* High-Speed Moving Dashed Markings */
  .lane-markings {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    width: 100%;
    max-width: 100%;
    height: 4px;
    background-image: repeating-linear-gradient(
      90deg,
      #facc15 0px,
      #facc15 45px,
      transparent 45px,
      transparent 95px
    );
    opacity: 0.95;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.4));
    animation: highwayMarkingsMove 0.45s linear infinite;
  }

  @keyframes highwayMarkingsMove {
    0% { background-position-x: 0px; }
    100% { background-position-x: -95px; }
  }

  /* Vehicles Stage Layer: Covers entire canvas so truck is 100% intact and never cut off from above */
  .vehicles-stage {
    position: absolute;
    inset: 0;
    width: 100%;
    max-width: 100%;
    height: 100%;
    overflow: hidden;
    contain: paint;
    clip-path: inset(0);
    pointer-events: none;
    z-index: 3;
  }

  /* Nam Han Container Truck: VIDEO REPLAY WITH 2-SECOND CENTER PAUSE & ACCELERATION */
  .truck-convoy {
    position: absolute;
    bottom: 6px;
    left: 0;
    width: clamp(280px, 42vw, 560px);
    max-width: none;
    pointer-events: none;
    will-change: transform;
    /* 10s loop: Drives in -> Stops at center 2s -> Rolls slowly -> Accelerates to right -> Loops */
    animation: truckReplayDrive 10s cubic-bezier(0.25, 0.1, 0.25, 1) infinite;
  }

  @keyframes truckReplayDrive {
    /* 0%: Starts off-screen on the left */
    0% {
      transform: translate3d(-125%, 0, 0);
      opacity: 0;
    }
    /* 2%: Enters smoothly into view */
    2% {
      opacity: 1;
    }
    /* 24%: Arrives smoothly at the center of the viewport */
    24% {
      transform: translate3d(calc(50vw - 50%), 0, 0);
      opacity: 1;
    }
    /* 24% - 46%: STOPS AT CENTER FOR ~2.2 SECONDS (clear view of Nam Han branding) */
    46% {
      transform: translate3d(calc(50vw - 50%), 0, 0);
      opacity: 1;
    }
    /* 53%: Starts moving forward slowly ("đi từ từ") */
    53% {
      transform: translate3d(calc(50vw - 50% + 45px), 0, 0);
      opacity: 1;
    }
    /* 62%: Accelerating smoothly */
    62% {
      transform: translate3d(calc(50vw - 50% + 160px), 0, 0);
      opacity: 1;
    }
    /* 73%: Fast exit to the right ("đi nhanh lên sang phải") */
    73% {
      transform: translate3d(calc(100vw + 60px), 0, 0);
      opacity: 1;
    }
    /* 76%: Completely disappears off-screen right ("mất tiêu") */
    76% {
      transform: translate3d(calc(100vw + 140px), 0, 0);
      opacity: 0;
    }
    /* 76% - 100%: Intermission pause while road & clouds move, then replay restarts */
    100% {
      transform: translate3d(calc(100vw + 140px), 0, 0);
      opacity: 0;
    }
  }

  @media (max-width: 767px) {
    .truck-convoy {
      bottom: 4px;
      width: clamp(220px, 68vw, 320px);
      animation-duration: 9s;
    }

    @keyframes truckReplayDrive {
      0% {
        transform: translate3d(-120%, 0, 0);
        opacity: 0;
      }
      2% {
        opacity: 1;
      }
      24% {
        transform: translate3d(calc(50vw - 50%), 0, 0);
        opacity: 1;
      }
      46% {
        transform: translate3d(calc(50vw - 50%), 0, 0);
        opacity: 1;
      }
      54% {
        transform: translate3d(calc(50vw - 50% + 35px), 0, 0);
        opacity: 1;
      }
      72% {
        transform: translate3d(calc(100vw + 40px), 0, 0);
        opacity: 1;
      }
      76% {
        transform: translate3d(calc(100vw + 100px), 0, 0);
        opacity: 0;
      }
      100% {
        transform: translate3d(calc(100vw + 100px), 0, 0);
        opacity: 0;
      }
    }
  }

  /* Truck Suspension Vibration */
  .truck-suspension-bounce {
    position: relative;
    width: 100%;
    animation: truckVibration 0.3s ease-in-out infinite alternate;
  }

  @keyframes truckVibration {
    0% { transform: translate3d(0, 0, 0); }
    100% { transform: translate3d(0, -1.8px, 0); }
  }

  .truck-img {
    width: 100%;
    height: auto;
    display: block;
    filter: drop-shadow(0 6px 14px rgba(15, 23, 42, 0.45));
  }

  /* Accessibility & Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .truck-convoy {
      animation: none !important;
      left: 50% !important;
      transform: translateX(-50%) !important;
      opacity: 1 !important;
    }
    .lane-markings,
    .clouds-stream,
    .truck-suspension-bounce {
      animation: none !important;
    }
  }
</style>
