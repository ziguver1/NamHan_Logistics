---
// Bee Logistics-Inspired Hero Canvas Component
// Bright Sunny Sky-Blue canvas with photorealistic drifting clouds,
// Forklift cargo handling & Nam Han Logistics Flagship Container Semi-Truck in video replay motion
---

<div class="bee-hero-scene" aria-hidden="true">
  <!-- Sunlit Sky Backdrop with Soft Sun Flare -->
  <div class="sky-canvas">
    <div class="sun-flare"></div>
    <div class="sun-glow"></div>

    <!-- Photorealistic Drifting Clouds Layer -->
    <div class="clouds-stream clouds-track-1"></div>
    <div class="clouds-stream clouds-track-2"></div>
  </div>

  <!-- Roadway Infrastructure & Highway Tarmac -->
  <div class="roadway-wrap">
    <!-- Curb Border matching Bee Logistics signature border -->
    <div class="road-curb"></div>

    <!-- Daylight Road Asphalt Surface -->
    <div class="road-surface">
      <!-- Sunlight reflection sheen on smooth asphalt -->
      <div class="road-sheen"></div>

      <!-- Animated Moving Highway Lane Markings -->
      <div class="lane-markings"></div>
      <div class="edge-line edge-top"></div>
      <div class="edge-line edge-bottom"></div>
    </div>

    <!-- Forklift Cargo Handling Unit (Symbolizing Bốc xếp & Kho bãi Logistics) -->
    <div class="forklift-unit">
      <img
        src="/images/home/bee-forklift.webp"
        alt=""
        class="forklift-img"
        width="341"
        height="260"
        loading="eager"
        decoding="async"
      />
    </div>

    <!-- Nam Han Logistics Flagship Container Semi-Truck (Video-Replay Motion Loop) -->
    <div class="truck-convoy">
      <div class="truck-suspension-bounce">
        <img
          src="/images/home/bee-truck-namhan.webp"
          alt=""
          class="truck-img"
          width="1000"
          height="302"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
  </div>
</div>

<style>
  .bee-hero-scene {
    position: absolute;
    inset: 0;
    width: 100%;
    max-width: 100%;
    height: 100%;
    overflow: hidden;
    contain: paint;
    clip-path: inset(0);
    /* Vibrant, fresh Sky-Blue canvas inspired by Bee Logistics */
    background: linear-gradient(180deg, #60a5fa 0%, #7ec4f8 35%, #9fd5f8 68%, #d4ecfd 100%);
    pointer-events: none;
    z-index: 1;
  }

  /* Sky Canvas & Sun Elements */
  .sky-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    max-width: 100%;
    height: 68%;
    overflow: hidden;
  }

  .sun-flare {
    position: absolute;
    top: 6%;
    right: 14%;
    width: 80px;
    height: 80px;
    background: radial-gradient(circle, #ffffff 30%, #fef08a 65%, rgba(254, 240, 138, 0) 100%);
    border-radius: 50%;
    box-shadow: 0 0 40px #ffffff, 0 0 80px rgba(254, 240, 138, 0.7);
  }

  .sun-glow {
    position: absolute;
    top: -15%;
    right: 5%;
    width: 320px;
    height: 320px;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.4) 0%, rgba(254, 240, 138, 0.15) 50%, transparent 75%);
    border-radius: 50%;
    filter: blur(14px);
  }

  /* Photorealistic Drifting Clouds Layer (Continuous Seamless Panoramic Scroll) */
  .clouds-stream {
    position: absolute;
    top: 0;
    left: 0;
    width: 200%;
    height: 100%;
    background-image: url('/images/home/bee-clouds.webp');
    background-repeat: repeat-x;
    background-size: auto 90%;
    background-position: left top;
    will-change: transform;
    pointer-events: none;
  }

  .clouds-track-1 {
    opacity: 0.85;
    animation: cloudsScroll 55s linear infinite;
  }

  .clouds-track-2 {
    top: 15px;
    opacity: 0.55;
    animation: cloudsScroll 75s linear infinite reverse;
    filter: blur(1px);
  }

  @keyframes cloudsScroll {
    0% { transform: translate3d(0, 0, 0); }
    100% { transform: translate3d(-50%, 0, 0); }
  }

  /* Roadway Infrastructure at Bottom */
  .roadway-wrap {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    max-width: 100%;
    height: 42%;
    min-height: 160px;
    overflow: hidden;
    contain: paint;
    clip-path: inset(0);
    z-index: 2;
  }

  /* Road Curb Border matching Bee Logistics signature border */
  .road-curb {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 8px;
    background: linear-gradient(90deg, #bfa888 0%, #cfbea2 50%, #bfa888 100%);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
    z-index: 3;
  }

  /* Daylight Highway Slate Asphalt */
  .road-surface {
    position: absolute;
    inset: 8px 0 0 0;
    width: 100%;
    max-width: 100%;
    background: linear-gradient(180deg, #374151 0%, #2b3340 40%, #1f2937 100%);
    box-shadow: inset 0 3px 8px rgba(0, 0, 0, 0.35);
    overflow: hidden;
  }

  .road-sheen {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 60% 15%, rgba(255, 255, 255, 0.12) 0%, transparent 65%);
    pointer-events: none;
  }

  .edge-line {
    position: absolute;
    left: 0;
    width: 100%;
    max-width: 100%;
    height: 3px;
  }

  .edge-top {
    top: 2px;
    background: #ffffff;
    opacity: 0.9;
  }

  .edge-bottom {
    bottom: 4px;
    background: #9ca3af;
    opacity: 0.7;
  }

  /* High-Speed Moving Dashed Markings */
  .lane-markings {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    width: 100%;
    max-width: 100%;
    height: 5px;
    background-image: repeating-linear-gradient(
      90deg,
      #facc15 0px,
      #facc15 50px,
      transparent 50px,
      transparent 105px
    );
    opacity: 0.95;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.4));
    animation: highwayMarkingsMove 0.45s linear infinite;
  }

  @keyframes highwayMarkingsMove {
    0% { background-position-x: 0px; }
    100% { background-position-x: -105px; }
  }

  /* Forklift Cargo Handling Unit (Bee Logistics-style Cargo Handling) */
  .forklift-unit {
    position: absolute;
    bottom: 22px;
    right: 4%;
    width: clamp(120px, 16vw, 210px);
    z-index: 4;
    pointer-events: none;
    filter: drop-shadow(0 8px 12px rgba(15, 23, 42, 0.4));
    animation: forkliftHover 3s ease-in-out infinite alternate;
  }

  @keyframes forkliftHover {
    0% { transform: translate3d(0, 0, 0); }
    100% { transform: translate3d(0, -3px, 0); }
  }

  .forklift-img {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (max-width: 767px) {
    .forklift-unit {
      right: 2%;
      bottom: 14px;
      width: clamp(95px, 26vw, 140px);
      opacity: 0.9;
    }
  }

  /* Nam Han Container Truck: DYNAMIC VIDEO REPLAY MOTION (Left to Right, Exit, Loop) */
  .truck-convoy {
    position: absolute;
    bottom: 12px;
    left: 0;
    width: clamp(320px, 46vw, 640px);
    max-width: none;
    z-index: 5;
    pointer-events: none;
    will-change: transform;
    animation: truckReplayDrive 8.5s cubic-bezier(0.22, 0.61, 0.36, 1) infinite;
  }

  @keyframes truckReplayDrive {
    /* 0%: Offscreen to the far left (hidden) */
    0% {
      transform: translate3d(-125%, 0, 0);
      opacity: 0;
    }
    /* 3%: Entering smoothly onto the highway */
    3% {
      opacity: 1;
    }
    /* 68%: Cruising powerfully across highway, reaching far right */
    68% {
      transform: translate3d(calc(100vw + 60px), 0, 0);
      opacity: 1;
    }
    /* 72%: Completely offscreen to the right ("mất tiêu") */
    72% {
      transform: translate3d(calc(100vw + 140px), 0, 0);
      opacity: 0;
    }
    /* 72% - 100%: Replay intermission pause while clouds & road move, then loops */
    100% {
      transform: translate3d(calc(100vw + 140px), 0, 0);
      opacity: 0;
    }
  }

  @media (max-width: 767px) {
    .truck-convoy {
      bottom: 8px;
      width: clamp(240px, 75vw, 360px);
      animation-duration: 7.2s;
    }

    @keyframes truckReplayDrive {
      0% {
        transform: translate3d(-120%, 0, 0);
        opacity: 0;
      }
      3% {
        opacity: 1;
      }
      70% {
        transform: translate3d(calc(100vw + 40px), 0, 0);
        opacity: 1;
      }
      74% {
        transform: translate3d(calc(100vw + 100px), 0, 0);
        opacity: 0;
      }
      100% {
        transform: translate3d(calc(100vw + 100px), 0, 0);
        opacity: 0;
      }
    }
  }

  /* Truck Suspension Vibration */
  .truck-suspension-bounce {
    position: relative;
    width: 100%;
    animation: truckVibration 0.3s ease-in-out infinite alternate;
  }

  @keyframes truckVibration {
    0% { transform: translate3d(0, 0, 0); }
    100% { transform: translate3d(0, -2px, 0); }
  }

  .truck-img {
    width: 100%;
    height: auto;
    display: block;
    filter: drop-shadow(0 10px 16px rgba(15, 23, 42, 0.45));
  }

  /* Accessibility & Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .truck-convoy {
      animation: none !important;
      left: auto !important;
      right: 15% !important;
      transform: none !important;
      opacity: 1 !important;
    }
    .lane-markings,
    .clouds-stream,
    .forklift-unit,
    .truck-suspension-bounce {
      animation: none !important;
    }
  }
</style>
