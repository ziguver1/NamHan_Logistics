---
// Night Highway Animation Component
// 2D Night Expressway with Nam Han Logistics Container Truck & Neon Light-Trails
---

<div class="night-highway-scene" aria-hidden="true">
  <!-- Sky Backdrop with Ambient Stars & Moonlight Horizon -->
  <div class="sky-backdrop">
    <div class="moon-glow"></div>
    <div class="stars-cluster">
      <span class="star s1"></span>
      <span class="star s2"></span>
      <span class="star s3"></span>
      <span class="star s4"></span>
      <span class="star s5"></span>
      <span class="star s6"></span>
      <span class="star s7"></span>
      <span class="star s8"></span>
    </div>
    <!-- Distant Mountains & Logistics Hub Silhouette -->
    <svg class="distant-landscape" viewBox="0 0 1440 180" preserveAspectRatio="none">
      <defs>
        <linearGradient id="mountainsGrad" x1="0%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" stop-color="#0a1d36" stop-opacity="0.8" />
          <stop offset="100%" stop-color="#061324" stop-opacity="0.95" />
        </linearGradient>
      </defs>
      <!-- Mountain Layer -->
      <path
        d="M0,130 Q180,60 360,110 T720,80 T1080,120 T1440,70 L1440,180 L0,180 Z"
        fill="url(#mountainsGrad)"
      />
      <!-- Logistics Warehouse & Crane Silhouettes in Distance -->
      <rect x="820" y="115" width="70" height="25" fill="#0c2340" rx="2" />
      <polygon points="815,115 855,102 895,115" fill="#0f2b4e" />
      <!-- Small depot light dots -->
      <circle cx="830" cy="122" r="1.5" fill="#38bdf8" class="beacon-pulse" />
      <circle cx="870" cy="122" r="1.5" fill="#fbbf24" class="beacon-pulse" />
      <rect x="940" y="105" width="110" height="35" fill="#08182b" rx="2" />
      <circle cx="955" cy="112" r="1.5" fill="#34d399" class="beacon-pulse" />
      <circle cx="1025" cy="112" r="1.5" fill="#38bdf8" class="beacon-pulse" />
    </svg>
  </div>

  <!-- Highway Roadway Infrastructure -->
  <div class="roadway-wrap">
    <!-- Road Surface Gradient -->
    <div class="road-surface">
      <!-- Animated Lane Markings (Moving dashed highway stripes) -->
      <div class="lane-markings"></div>
      <div class="edge-line edge-top"></div>
      <div class="edge-line edge-bottom"></div>
    </div>

    <!-- Highway Streetlights Layer -->
    <div class="streetlights-stream">
      <div class="light-pole p1"><div class="lamp-head"></div><div class="light-cone"></div></div>
      <div class="light-pole p2"><div class="lamp-head"></div><div class="light-cone"></div></div>
      <div class="light-pole p3"><div class="lamp-head"></div><div class="light-cone"></div></div>
      <div class="light-pole p4"><div class="lamp-head"></div><div class="light-cone"></div></div>
    </div>

    <!-- Fast Speed Light Trails (Neon Long Exposure Streaks) -->
    <div class="light-trails-container">
      <div class="trail trail-cyan t1"></div>
      <div class="trail trail-red t2"></div>
      <div class="trail trail-gold t3"></div>
      <div class="trail trail-cyan t4"></div>
      <div class="trail trail-red t5"></div>
    </div>

    <!-- The 2D Nam Han Container Truck -->
    <div class="truck-convoy">
      <div class="truck-vehicle">
        <!-- Headlight Projection Beam (Front Cone of Light) -->
        <div class="headlight-beam"></div>

        <!-- Taillight Red Streak Trail (Long-exposure light trail behind truck) -->
        <div class="taillight-trail"></div>

        <!-- Detailed 2D SVG Truck -->
        <svg
          class="truck-svg"
          viewBox="0 0 520 180"
          xmlns="http://www.w3.org/2000/svg"
        >
          <defs>
            <!-- Trailer Container Gradient -->
            <linearGradient id="containerGrad" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#ffffff" />
              <stop offset="18%" stop-color="#f1f5f9" />
              <stop offset="70%" stop-color="#e2e8f0" />
              <stop offset="100%" stop-color="#cbd5e1" />
            </linearGradient>

            <!-- Cabin Gradient -->
            <linearGradient id="cabinGrad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#0284c7" />
              <stop offset="50%" stop-color="#0369a1" />
              <stop offset="100%" stop-color="#0b2545" />
            </linearGradient>

            <!-- Chassis Gradient -->
            <linearGradient id="chassisGrad" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#334155" />
              <stop offset="100%" stop-color="#0f172a" />
            </linearGradient>

            <!-- Wheel Rim Gradient -->
            <radialGradient id="rimGrad" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#f8fafc" />
              <stop offset="45%" stop-color="#94a3b8" />
              <stop offset="75%" stop-color="#475569" />
              <stop offset="100%" stop-color="#1e293b" />
            </radialGradient>
          </defs>

          <!-- Drop Shadow underneath vehicle -->
          <ellipse cx="250" cy="168" rx="245" ry="8" fill="#000000" opacity="0.65" />

          <!-- CHASSIS & LOWER FRAME -->
          <rect x="25" y="142" width="460" height="12" rx="3" fill="url(#chassisGrad)" />
          <!-- Fuel Tank & Battery Box -->
          <rect x="260" y="132" width="55" height="18" rx="4" fill="#64748b" stroke="#334155" stroke-width="1.5" />
          <rect x="210" y="134" width="38" height="15" rx="2" fill="#475569" />

          <!-- TRAILER BODY (Container) -->
          <g class="container-body">
            <!-- Main Box -->
            <rect x="20" y="32" width="320" height="110" rx="4" fill="url(#containerGrad)" stroke="#94a3b8" stroke-width="1.5" />
            
            <!-- Blue Brand Accent Stripe along bottom of container -->
            <rect x="20" y="128" width="320" height="14" fill="#0070ba" />
            <rect x="20" y="125" width="320" height="3" fill="#38bdf8" />

            <!-- Vertical Corrugation Ribs of the Container -->
            <path d="M50,34 L50,125 M80,34 L80,125 M110,34 L110,125 M140,34 L140,125 M170,34 L170,125 M200,34 L200,125 M230,34 L230,125 M260,34 L260,125 M290,34 L290,125 M320,34 L320,125" stroke="#cbd5e1" stroke-width="1.2" opacity="0.75" />

            <!-- Nam Han Brand Logo & Identification Badge on Container -->
            <!-- Globe/Orbit Symbol -->
            <circle cx="95" cy="72" r="18" fill="#ffffff" stroke="#0070ba" stroke-width="2" />
            <ellipse cx="95" cy="72" rx="18" ry="7" fill="none" stroke="#0284c7" stroke-width="1.2" transform="rotate(-25 95 72)" />
            <path d="M84,72 Q95,60 106,72" fill="none" stroke="#e11d48" stroke-width="1.8" />
            
            <!-- Brand Text Typography -->
            <text x="122" y="68" font-family="system-ui, -apple-system, sans-serif" font-size="16" font-weight="900" fill="#0b2545" letter-spacing="1">NAM HÂN</text>
            <text x="122" y="85" font-family="system-ui, -apple-system, sans-serif" font-size="9" font-weight="700" fill="#0070ba" letter-spacing="2.5">LOGISTICS</text>
            <text x="122" y="98" font-family="system-ui, -apple-system, sans-serif" font-size="6.5" font-weight="600" fill="#64748b" letter-spacing="0.5">VẬN TẢI ĐƯỜNG BỘ TOÀN QUỐC</text>

            <!-- Container Corner Castings & Locking Bars -->
            <rect x="20" y="32" width="8" height="12" fill="#64748b" />
            <rect x="20" y="130" width="8" height="12" fill="#64748b" />
            <!-- Rear Red Reflectors on Container -->
            <rect x="20" y="55" width="3" height="16" fill="#ef4444" rx="1" />
            <rect x="20" y="110" width="3" height="16" fill="#ef4444" rx="1" />
          </g>

          <!-- TRACTOR CABIN (Modern Heavy-Duty Truck Head) -->
          <g class="truck-cabin">
            <!-- Aerodynamic Roof Fairing / Deflector -->
            <path d="M338,70 Q345,26 395,22 L425,24 Q440,32 445,68 Z" fill="url(#cabinGrad)" stroke="#0369a1" stroke-width="1" />
            <!-- Main Cabin Body -->
            <path d="M338,70 L448,70 L458,95 L468,112 L468,142 L338,142 Z" fill="url(#cabinGrad)" />
            
            <!-- Windshield Glass -->
            <path d="M398,34 L435,36 L448,68 L395,68 Z" fill="#0c4a6e" opacity="0.85" />
            <path d="M405,40 L430,42 L422,62 L402,62 Z" fill="#38bdf8" opacity="0.45" />

            <!-- Side Window -->
            <path d="M362,48 L392,48 L392,72 L358,72 Z" fill="#0c4a6e" opacity="0.9" />
            <!-- Driver Mirror -->
            <rect x="424" y="50" width="6" height="22" rx="2" fill="#1e293b" />
            <line x1="418" y1="56" x2="424" y2="56" stroke="#1e293b" stroke-width="2" />
            <line x1="418" y1="68" x2="424" y2="68" stroke="#1e293b" stroke-width="2" />

            <!-- Radiator Chrome Grill -->
            <rect x="460" y="105" width="9" height="32" rx="2" fill="#1e293b" stroke="#94a3b8" stroke-width="1" />
            <line x1="462" y1="112" x2="467" y2="112" stroke="#cbd5e1" stroke-width="1.2" />
            <line x1="462" y1="118" x2="467" y2="118" stroke="#cbd5e1" stroke-width="1.2" />
            <line x1="462" y1="124" x2="467" y2="124" stroke="#cbd5e1" stroke-width="1.2" />
            <line x1="462" y1="130" x2="467" y2="130" stroke="#cbd5e1" stroke-width="1.2" />

            <!-- Powerful Headlight Unit -->
            <rect x="458" y="128" width="11" height="12" rx="2" fill="#fef08a" stroke="#ffffff" stroke-width="1" />
            <circle cx="463" cy="134" r="3.5" fill="#ffffff" />
            <!-- Auxiliary Fog Lamp -->
            <circle cx="452" cy="138" r="3" fill="#facc15" />

            <!-- Cabin Door Handle & Steps -->
            <rect x="368" y="88" width="10" height="3" rx="1" fill="#cbd5e1" />
            <rect x="375" y="132" width="18" height="3" fill="#94a3b8" />
            <rect x="377" y="138" width="15" height="3" fill="#94a3b8" />
          </g>

          <!-- WHEEL UNITS (5 Sets with Rotating Alloy Rims) -->
          <!-- Trailer Axle 1 (Rearmost) -->
          <g class="wheel-unit" transform="translate(62, 150)">
            <circle cx="0" cy="0" r="19" fill="#0f172a" />
            <circle cx="0" cy="0" r="14" fill="url(#rimGrad)" />
            <circle cx="0" cy="0" r="6" fill="#1e293b" />
            <circle cx="0" cy="0" r="2.5" fill="#cbd5e1" />
            <!-- Rim spokes / lug nuts -->
            <line x1="-10" y1="0" x2="10" y2="0" stroke="#334155" stroke-width="1.5" class="wheel-spin" />
            <line x1="0" y1="-10" x2="0" y2="10" stroke="#334155" stroke-width="1.5" class="wheel-spin" />
          </g>

          <!-- Trailer Axle 2 -->
          <g class="wheel-unit" transform="translate(108, 150)">
            <circle cx="0" cy="0" r="19" fill="#0f172a" />
            <circle cx="0" cy="0" r="14" fill="url(#rimGrad)" />
            <circle cx="0" cy="0" r="6" fill="#1e293b" />
            <circle cx="0" cy="0" r="2.5" fill="#cbd5e1" />
            <line x1="-10" y1="0" x2="10" y2="0" stroke="#334155" stroke-width="1.5" class="wheel-spin" />
            <line x1="0" y1="-10" x2="0" y2="10" stroke="#334155" stroke-width="1.5" class="wheel-spin" />
          </g>

          <!-- Tractor Drive Axle 1 -->
          <g class="wheel-unit" transform="translate(345, 150)">
            <circle cx="0" cy="0" r="19" fill="#0f172a" />
            <circle cx="0" cy="0" r="14" fill="url(#rimGrad)" />
            <circle cx="0" cy="0" r="6" fill="#1e293b" />
            <circle cx="0" cy="0" r="2.5" fill="#cbd5e1" />
            <line x1="-10" y1="0" x2="10" y2="0" stroke="#334155" stroke-width="1.5" class="wheel-spin" />
            <line x1="0" y1="-10" x2="0" y2="10" stroke="#334155" stroke-width="1.5" class="wheel-spin" />
          </g>

          <!-- Tractor Drive Axle 2 -->
          <g class="wheel-unit" transform="translate(390, 150)">
            <circle cx="0" cy="0" r="19" fill="#0f172a" />
            <circle cx="0" cy="0" r="14" fill="url(#rimGrad)" />
            <circle cx="0" cy="0" r="6" fill="#1e293b" />
            <circle cx="0" cy="0" r="2.5" fill="#cbd5e1" />
            <line x1="-10" y1="0" x2="10" y2="0" stroke="#334155" stroke-width="1.5" class="wheel-spin" />
            <line x1="0" y1="-10" x2="0" y2="10" stroke="#334155" stroke-width="1.5" class="wheel-spin" />
          </g>

          <!-- Tractor Steer Axle (Front) -->
          <g class="wheel-unit" transform="translate(442, 150)">
            <circle cx="0" cy="0" r="19" fill="#0f172a" />
            <circle cx="0" cy="0" r="14" fill="url(#rimGrad)" />
            <circle cx="0" cy="0" r="6" fill="#1e293b" />
            <circle cx="0" cy="0" r="2.5" fill="#cbd5e1" />
            <line x1="-10" y1="0" x2="10" y2="0" stroke="#334155" stroke-width="1.5" class="wheel-spin" />
            <line x1="0" y1="-10" x2="0" y2="10" stroke="#334155" stroke-width="1.5" class="wheel-spin" />
          </g>
        </svg>
      </div>
    </div>
  </div>
</div>

<style>
  .night-highway-scene {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: radial-gradient(circle at 75% 20%, #0d284a 0%, #06152b 55%, #030c18 100%);
    pointer-events: none;
    z-index: 1;
  }

  /* Sky Backdrop & Stars */
  .sky-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 65%;
  }

  .moon-glow {
    position: absolute;
    top: 8%;
    right: 18%;
    width: 140px;
    height: 140px;
    background: radial-gradient(circle, rgba(56, 189, 248, 0.18) 0%, rgba(14, 165, 233, 0.05) 50%, transparent 70%);
    border-radius: 50%;
  }

  .stars-cluster {
    position: absolute;
    inset: 0;
  }

  .star {
    position: absolute;
    width: 2px;
    height: 2px;
    background-color: #ffffff;
    border-radius: 50%;
    box-shadow: 0 0 4px #ffffff;
    animation: starTwinkle 3s ease-in-out infinite alternate;
  }

  .s1 { top: 12%; left: 15%; animation-delay: 0.2s; }
  .s2 { top: 22%; left: 32%; animation-delay: 1.5s; width: 3px; height: 3px; }
  .s3 { top: 8%; left: 55%; animation-delay: 0.8s; }
  .s4 { top: 18%; left: 70%; animation-delay: 2.1s; width: 2.5px; height: 2.5px; }
  .s5 { top: 28%; left: 82%; animation-delay: 0.5s; }
  .s6 { top: 15%; left: 92%; animation-delay: 1.8s; }
  .s7 { top: 32%; left: 45%; animation-delay: 2.4s; }
  .s8 { top: 25%; left: 8%; animation-delay: 1.1s; width: 3px; height: 3px; }

  @keyframes starTwinkle {
    0% { opacity: 0.3; transform: scale(0.8); }
    100% { opacity: 1; transform: scale(1.3); }
  }

  .distant-landscape {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 90px;
    opacity: 0.6;
  }

  .beacon-pulse {
    animation: beaconBlink 1.8s infinite;
  }

  @keyframes beaconBlink {
    0%, 100% { opacity: 0.2; }
    50% { opacity: 1; filter: drop-shadow(0 0 3px currentColor); }
  }

  /* Roadway Infrastructure */
  .roadway-wrap {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 48%;
    min-height: 180px;
  }

  .road-surface {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, #091a2e 0%, #0d1e33 25%, #081321 100%);
    box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.8);
  }

  .edge-line {
    position: absolute;
    left: 0;
    width: 100%;
    height: 3px;
  }

  .edge-top {
    top: 0;
    background: linear-gradient(90deg, #1e3a5f, #38bdf8, #1e3a5f);
    opacity: 0.7;
    box-shadow: 0 0 6px rgba(56, 189, 248, 0.4);
  }

  .edge-bottom {
    bottom: 4px;
    background: #1e293b;
  }

  /* High-Speed Moving Dashed Markings */
  .lane-markings {
    position: absolute;
    top: 55%;
    left: 0;
    width: 200%;
    height: 4px;
    background: repeating-linear-gradient(
      90deg,
      #fbbf24 0px,
      #fbbf24 35px,
      transparent 35px,
      transparent 75px
    );
    opacity: 0.8;
    filter: drop-shadow(0 0 4px rgba(251, 191, 36, 0.6));
    animation: highwayMarkingsMove 0.45s linear infinite;
    will-change: transform;
  }

  @keyframes highwayMarkingsMove {
    0% { transform: translate3d(0, 0, 0); }
    100% { transform: translate3d(-75px, 0, 0); }
  }

  /* Streetlights stream passing overhead */
  .streetlights-stream {
    position: absolute;
    top: -30px;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .light-pole {
    position: absolute;
    top: 0;
    width: 4px;
    height: 60px;
    background: linear-gradient(180deg, #475569 0%, #1e293b 100%);
  }

  .p1 { left: 18%; }
  .p2 { left: 45%; }
  .p3 { left: 72%; }
  .p4 { left: 95%; }

  .lamp-head {
    position: absolute;
    top: 0;
    right: -10px;
    width: 14px;
    height: 5px;
    background: #f8fafc;
    border-radius: 2px;
    box-shadow: 0 0 8px #fef08a;
  }

  .light-cone {
    position: absolute;
    top: 5px;
    right: -30px;
    width: 60px;
    height: 120px;
    background: linear-gradient(180deg, rgba(254, 240, 138, 0.18) 0%, transparent 80%);
    clip-path: polygon(45% 0%, 55% 0%, 100% 100%, 0% 100%);
    pointer-events: none;
  }

  /* Fast Neon Light Trails */
  .light-trails-container {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .trail {
    position: absolute;
    height: 2px;
    border-radius: 999px;
    filter: blur(0.5px);
    will-change: transform;
  }

  .trail-cyan {
    background: linear-gradient(90deg, transparent, #38bdf8 30%, #ffffff 85%, transparent);
    box-shadow: 0 0 8px #0284c7;
  }

  .trail-red {
    background: linear-gradient(90deg, transparent, #f43f5e 30%, #ff2a55 85%, transparent);
    box-shadow: 0 0 10px #e11d48;
  }

  .trail-gold {
    background: linear-gradient(90deg, transparent, #fbbf24 30%, #fffbeb 85%, transparent);
    box-shadow: 0 0 8px #d97706;
  }

  .t1 {
    top: 25%;
    width: 280px;
    animation: trailRush 1.4s ease-out infinite;
    animation-delay: 0.1s;
  }

  .t2 {
    top: 68%;
    width: 380px;
    animation: trailRush 1.1s ease-out infinite;
    animation-delay: 0.6s;
  }

  .t3 {
    top: 42%;
    width: 220px;
    animation: trailRush 1.7s ease-out infinite;
    animation-delay: 0.9s;
  }

  .t4 {
    top: 78%;
    width: 320px;
    animation: trailRush 1.3s ease-out infinite;
    animation-delay: 0.3s;
  }

  .t5 {
    top: 15%;
    width: 180px;
    animation: trailRush 2.1s ease-out infinite;
    animation-delay: 1.2s;
  }

  @keyframes trailRush {
    0% {
      transform: translate3d(120vw, 0, 0);
      opacity: 0;
    }
    15% {
      opacity: 1;
    }
    85% {
      opacity: 1;
    }
    100% {
      transform: translate3d(-60vw, 0, 0);
      opacity: 0;
    }
  }

  /* Truck Convoy Positioning & Animation */
  .truck-convoy {
    position: absolute;
    bottom: 12px;
    right: 3%;
    width: clamp(260px, 42vw, 540px);
    z-index: 5;
  }

  @media (max-width: 767px) {
    .truck-convoy {
      right: -25px;
      bottom: 6px;
      width: 290px;
      opacity: 0.85;
    }
  }

  .truck-vehicle {
    position: relative;
    width: 100%;
    animation: truckVibration 0.35s ease-in-out infinite alternate;
  }

  @keyframes truckVibration {
    0% { transform: translate3d(0, 0, 0); }
    100% { transform: translate3d(0, -1.8px, 0); }
  }

  .truck-svg {
    width: 100%;
    height: auto;
    display: block;
    filter: drop-shadow(0 10px 18px rgba(0, 0, 0, 0.7));
  }

  /* Front Headlight Projection Beam */
  .headlight-beam {
    position: absolute;
    top: 68%;
    right: -220px;
    width: 280px;
    height: 80px;
    background: radial-gradient(ellipse at left, rgba(254, 240, 138, 0.6) 0%, rgba(254, 240, 138, 0.22) 40%, transparent 75%);
    clip-path: polygon(0% 35%, 100% 0%, 100% 100%, 0% 65%);
    filter: blur(1.5px);
    pointer-events: none;
    z-index: 6;
  }

  @media (max-width: 767px) {
    .headlight-beam {
      width: 140px;
      right: -100px;
    }
  }

  /* Taillight Long-Exposure Streak (Red trail behind truck) */
  .taillight-trail {
    position: absolute;
    top: 65%;
    left: -200px;
    width: 220px;
    height: 8px;
    background: linear-gradient(90deg, transparent, rgba(239, 68, 68, 0.2) 30%, rgba(239, 68, 68, 0.9) 85%, #ff2a55);
    filter: blur(2px) drop-shadow(0 0 6px #ef4444);
    border-radius: 999px;
  }

  @media (max-width: 767px) {
    .taillight-trail {
      width: 120px;
      left: -100px;
    }
  }

  /* Wheel Spin Keyframe */
  .wheel-spin {
    transform-origin: center;
    animation: wheelRotate 0.28s linear infinite;
  }

  @keyframes wheelRotate {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  /* Accessibility & Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .lane-markings,
    .trail,
    .truck-vehicle,
    .wheel-spin,
    .star,
    .beacon-pulse {
      animation: none !important;
      transform: none !important;
    }
  }
</style>

