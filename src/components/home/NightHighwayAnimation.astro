---
// Night Highway Animation Component
// 2D Vivid Twilight Expressway with Nam Han Logistics Container Truck in Video-Replay Motion
// Fully responsive, zero horizontal overflow (strictly contained within viewBox & clip-path)
---

<div class="night-highway-scene" aria-hidden="true">
  <!-- Sky Backdrop with Ambient Stars, Twilight Glow & Distant Infrastructure -->
  <div class="sky-backdrop">
    <div class="moon-glow"></div>
    <div class="horizon-glow"></div>

    <div class="stars-cluster">
      <span class="star s1"></span>
      <span class="star s2"></span>
      <span class="star s3"></span>
      <span class="star s4"></span>
      <span class="star s5"></span>
      <span class="star s6"></span>
      <span class="star s7"></span>
      <span class="star s8"></span>
      <span class="star s9"></span>
      <span class="star s10"></span>
      <span class="star s11"></span>
      <span class="star s12"></span>
    </div>

    <!-- Distant Mountain Ranges, Logistics Depots & City Skylines -->
    <svg class="distant-landscape" viewBox="0 0 1440 180" preserveAspectRatio="none">
      <defs>
        <linearGradient id="mountainsGradFar" x1="0%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" stop-color="#163e72" stop-opacity="0.85" />
          <stop offset="100%" stop-color="#0b2347" stop-opacity="0.95" />
        </linearGradient>
        <linearGradient id="mountainsGradNear" x1="0%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" stop-color="#10315c" stop-opacity="0.9" />
          <stop offset="100%" stop-color="#081b36" stop-opacity="1" />
        </linearGradient>
      </defs>

      <!-- Far Mountain Silhouette -->
      <path
        d="M0,110 Q240,40 480,95 T960,65 T1440,85 L1440,180 L0,180 Z"
        fill="url(#mountainsGradFar)"
      />

      <!-- Near Mountain Silhouette -->
      <path
        d="M0,135 Q180,85 360,120 T720,95 T1080,130 T1440,100 L1440,180 L0,180 Z"
        fill="url(#mountainsGradNear)"
      />

      <!-- Distant Logistics Warehouses, Port Cranes & Radio Mast Silhouettes -->
      <!-- Radio Mast with Red Warning Beacon -->
      <line x1="780" y1="140" x2="780" y2="70" stroke="#1d4ed8" stroke-width="2" />
      <line x1="772" y1="95" x2="788" y2="95" stroke="#1d4ed8" stroke-width="1.5" />
      <line x1="775" y1="115" x2="785" y2="115" stroke="#1d4ed8" stroke-width="1.5" />
      <circle cx="780" cy="68" r="3" fill="#ef4444" class="beacon-pulse beacon-fast" />

      <!-- Logistics Hub 1 -->
      <rect x="830" y="125" width="85" height="30" fill="#0f2b4e" rx="2" />
      <polygon points="825,125 872,110 920,125" fill="#143763" />
      <circle cx="845" cy="132" r="2" fill="#38bdf8" class="beacon-pulse" />
      <circle cx="890" cy="132" r="2" fill="#fbbf24" class="beacon-pulse" />

      <!-- Port Crane Silhouette -->
      <path d="M1010,140 L1010,80 L1060,50 M1010,80 L980,105 M1010,100 L1035,70" stroke="#1e3a5f" stroke-width="2" fill="none" />
      <circle cx="1060" cy="50" r="2.5" fill="#ef4444" class="beacon-pulse" />

      <!-- Logistics Hub 2 -->
      <rect x="1100" y="118" width="130" height="38" fill="#0c2340" rx="3" />
      <polygon points="1095,118 1165,102 1235,118" fill="#123056" />
      <circle cx="1120" cy="126" r="2" fill="#34d399" class="beacon-pulse" />
      <circle cx="1180" cy="126" r="2" fill="#38bdf8" class="beacon-pulse" />
      <circle cx="1215" cy="126" r="2" fill="#fbbf24" class="beacon-pulse" />
    </svg>
  </div>

  <!-- Overhead Highway Electronic Sign Gantry (Frame spanning expressway) -->
  <div class="expressway-gantry" aria-hidden="true">
    <div class="gantry-structure">
      <div class="gantry-truss"></div>
      <div class="gantry-signboard">
        <div class="sign-top-row">
          <span class="sign-badge">CT.01</span>
          <span class="sign-title">CAO TỐC BẮC — NAM | TOÀN TRÌNH 24/7</span>
        </div>
        <div class="sign-bottom-row">
          <span class="sign-dest">HÀ NỘI ⇄ ĐÀ NẴNG ⇄ TP.HCM</span>
          <div class="sign-lane-indicators">
            <span class="lane-led active">↓</span>
            <span class="lane-led active">↓</span>
            <span class="lane-led active">↓</span>
          </div>
        </div>
      </div>
      <div class="gantry-flasher flasher-left"></div>
      <div class="gantry-flasher flasher-right"></div>
    </div>
  </div>

  <!-- Highway Roadway Infrastructure -->
  <div class="roadway-wrap">
    <!-- Road Surface Gradient with Asphalt Sheen & Reflections -->
    <div class="road-surface">
      <div class="road-sheen"></div>
      <!-- Animated Lane Markings using pure background-position (ZERO layout displacement) -->
      <div class="lane-markings"></div>
      <div class="edge-line edge-top"></div>
      <div class="edge-line edge-bottom"></div>

      <!-- Highway Cat-Eye Reflective Road Studs (Illuminated markers) -->
      <div class="cat-eyes-stream">
        <span class="cat-eye c1"></span>
        <span class="cat-eye c2"></span>
        <span class="cat-eye c3"></span>
        <span class="cat-eye c4"></span>
        <span class="cat-eye c5"></span>
        <span class="cat-eye c6"></span>
      </div>
    </div>

    <!-- Highway Streetlights Layer with Radiant Light Cones -->
    <div class="streetlights-stream">
      <div class="light-pole p1"><div class="lamp-arm"></div><div class="lamp-head"></div><div class="light-cone"></div></div>
      <div class="light-pole p2"><div class="lamp-arm"></div><div class="lamp-head"></div><div class="light-cone"></div></div>
      <div class="light-pole p3"><div class="lamp-arm"></div><div class="lamp-head"></div><div class="light-cone"></div></div>
      <div class="light-pole p4"><div class="lamp-arm"></div><div class="lamp-head"></div><div class="light-cone"></div></div>
      <div class="light-pole p5"><div class="lamp-arm"></div><div class="lamp-head"></div><div class="light-cone"></div></div>
    </div>

    <!-- Fast Speed Light Trails (Zooming traffic in adjacent lanes) -->
    <div class="light-trails-container">
      <div class="trail trail-cyan t1"></div>
      <div class="trail trail-red t2"></div>
      <div class="trail trail-white t3"></div>
      <div class="trail trail-gold t4"></div>
      <div class="trail trail-red t5"></div>
      <div class="trail trail-cyan t6"></div>
    </div>

    <!-- The 2D Nam Han Container Truck (Dynamic Video Replay: drives across from left to right, disappears, loops) -->
    <div class="truck-convoy">
      <div class="truck-suspension-bounce">
        <svg
          class="truck-svg"
          viewBox="0 0 760 180"
          xmlns="http://www.w3.org/2000/svg"
        >
          <defs>
            <!-- Trailer Container Gradient -->
            <linearGradient id="containerGrad" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#ffffff" />
              <stop offset="15%" stop-color="#f8fafc" />
              <stop offset="70%" stop-color="#e2e8f0" />
              <stop offset="100%" stop-color="#cbd5e1" />
            </linearGradient>

            <!-- Cabin Gradient -->
            <linearGradient id="cabinGrad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#0284c7" />
              <stop offset="45%" stop-color="#0369a1" />
              <stop offset="100%" stop-color="#082f49" />
            </linearGradient>

            <!-- Chassis Gradient -->
            <linearGradient id="chassisGrad" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#475569" />
              <stop offset="100%" stop-color="#0f172a" />
            </linearGradient>

            <!-- Wheel Rim Gradient -->
            <radialGradient id="rimGrad" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#ffffff" />
              <stop offset="40%" stop-color="#cbd5e1" />
              <stop offset="75%" stop-color="#64748b" />
              <stop offset="100%" stop-color="#1e293b" />
            </radialGradient>

            <!-- Powerful Forward Headlight Fan Beam Gradient -->
            <linearGradient id="headlightBeamGrad" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#fef08a" stop-opacity="0.95" />
              <stop offset="25%" stop-color="#fde047" stop-opacity="0.55" />
              <stop offset="70%" stop-color="#38bdf8" stop-opacity="0.2" />
              <stop offset="100%" stop-color="#38bdf8" stop-opacity="0" />
            </linearGradient>

            <!-- Forward Road Illumination Spotlight Gradient -->
            <radialGradient id="roadSpotlightGrad" cx="30%" cy="50%" r="70%">
              <stop offset="0%" stop-color="#fef08a" stop-opacity="0.6" />
              <stop offset="45%" stop-color="#fef08a" stop-opacity="0.25" />
              <stop offset="100%" stop-color="#fef08a" stop-opacity="0" />
            </radialGradient>

            <!-- Taillight Red Streak Gradient -->
            <linearGradient id="taillightStreakGrad" x1="100%" y1="0%" x2="0%" y2="0%">
              <stop offset="0%" stop-color="#ff2a55" stop-opacity="1" />
              <stop offset="35%" stop-color="#ef4444" stop-opacity="0.6" />
              <stop offset="100%" stop-color="#ef4444" stop-opacity="0" />
            </linearGradient>
          </defs>

          <!-- TAILLIGHT RED TRAIL (Rushing behind truck trailer) -->
          <rect x="5" y="112" width="130" height="7" rx="3.5" fill="url(#taillightStreakGrad)" />
          <rect x="25" y="60" width="110" height="5" rx="2.5" fill="url(#taillightStreakGrad)" opacity="0.75" />
          <circle cx="136" cy="115" r="4" fill="#ff2a55" filter="drop-shadow(0 0 6px #ff2a55)" />

          <!-- FORWARD ROAD ILLUMINATION SPOTLIGHT (Casts light patch onto the road ahead) -->
          <ellipse cx="660" cy="164" rx="90" ry="14" fill="url(#roadSpotlightGrad)" />

          <!-- HEADLIGHT VOLUMETRIC HIGH BEAM (Projects forward from cabin) -->
          <polygon points="590,132 755,95 755,168 590,144" fill="url(#headlightBeamGrad)" />

          <!-- Real Vehicle Drop Shadow on Asphalt -->
          <ellipse cx="375" cy="168" rx="255" ry="9" fill="#000000" opacity="0.7" />

          <!-- CHASSIS & LOWER FRAMEWORK -->
          <rect x="140" y="142" width="455" height="13" rx="3" fill="url(#chassisGrad)" />
          <!-- Aluminum Fuel Tank with Straps -->
          <rect x="380" y="130" width="62" height="20" rx="4" fill="#94a3b8" stroke="#475569" stroke-width="1.5" />
          <line x1="395" y1="130" x2="395" y2="150" stroke="#334155" stroke-width="1.5" />
          <line x1="427" y1="130" x2="427" y2="150" stroke="#334155" stroke-width="1.5" />
          <!-- Toolbox & Battery Enclosure -->
          <rect x="325" y="133" width="45" height="16" rx="2" fill="#475569" stroke="#1e293b" stroke-width="1" />

          <!-- TRAILER CONTAINER BODY -->
          <g class="container-body">
            <!-- Main Insulated White Box -->
            <rect x="135" y="30" width="335" height="112" rx="4" fill="url(#containerGrad)" stroke="#94a3b8" stroke-width="1.8" />
            
            <!-- Dynamic Blue Brand Accent Stripe along bottom -->
            <rect x="135" y="127" width="335" height="15" fill="#0070ba" />
            <rect x="135" y="124" width="335" height="3" fill="#38bdf8" />

            <!-- Vertical Corrugation Ribs of High-Cube Container -->
            <path
              d="M165,32 L165,124 M195,32 L195,124 M225,32 L225,124 M255,32 L255,124 M285,32 L285,124 M315,32 L315,124 M345,32 L345,124 M375,32 L375,124 M405,32 L405,124 M435,32 L435,124 M460,32 L460,124"
              stroke="#cbd5e1"
              stroke-width="1.5"
              opacity="0.85"
            />

            <!-- Nam Han Brand Logo Emblem on Trailer -->
            <circle cx="215" cy="72" r="20" fill="#ffffff" stroke="#0070ba" stroke-width="2.2" />
            <ellipse cx="215" cy="72" rx="20" ry="8" fill="none" stroke="#0284c7" stroke-width="1.5" transform="rotate(-25 215 72)" />
            <path d="M203,72 Q215,58 227,72" fill="none" stroke="#e11d48" stroke-width="2" />
            
            <!-- Nam Han Brand Typography on Container -->
            <text x="245" y="68" font-family="system-ui, -apple-system, sans-serif" font-size="17" font-weight="900" fill="#0b2545" letter-spacing="1.2">NAM HÂN</text>
            <text x="245" y="86" font-family="system-ui, -apple-system, sans-serif" font-size="10" font-weight="800" fill="#0070ba" letter-spacing="2.8">LOGISTICS</text>
            <text x="245" y="100" font-family="system-ui, -apple-system, sans-serif" font-size="7" font-weight="700" fill="#475569" letter-spacing="0.8">VẬN TẢI ĐƯỜNG BỘ TOÀN QUỐC</text>

            <!-- Corner Castings & Locking Bars -->
            <rect x="135" y="30" width="8" height="14" fill="#475569" />
            <rect x="135" y="128" width="8" height="14" fill="#475569" />
            <rect x="462" y="30" width="8" height="14" fill="#475569" />
            <rect x="462" y="128" width="8" height="14" fill="#475569" />

            <!-- Safety Reflective Red/Yellow Chevrons on Rear Edge -->
            <rect x="135" y="55" width="4" height="18" fill="#ef4444" rx="1" />
            <rect x="135" y="80" width="4" height="18" fill="#fbbf24" rx="1" />
            <rect x="135" y="105" width="4" height="18" fill="#ef4444" rx="1" />
          </g>

          <!-- MODERN HEAVY-DUTY PRIME MOVER CABIN -->
          <g class="truck-cabin">
            <!-- Aerodynamic Roof Fairing & Air Deflector -->
            <path d="M465,68 Q472,24 525,20 L555,22 Q572,30 578,68 Z" fill="url(#cabinGrad)" stroke="#0284c7" stroke-width="1.2" />
            <!-- Main Cab Body -->
            <path d="M465,68 L580,68 L590,95 L600,114 L600,144 L465,144 Z" fill="url(#cabinGrad)" />
            
            <!-- Tinted Windshield Glass with Sunlight Sheen -->
            <path d="M528,32 L568,34 L580,66 L525,66 Z" fill="#082f49" />
            <path d="M535,38 L562,40 L554,60 L532,60 Z" fill="#38bdf8" opacity="0.55" />

            <!-- Side Door Window -->
            <path d="M488,46 L522,46 L522,72 L484,72 Z" fill="#082f49" />
            <line x1="484" y1="72" x2="522" y2="72" stroke="#0369a1" stroke-width="2" />

            <!-- Aerodynamic Side Mirrors -->
            <rect x="556" y="48" width="7" height="24" rx="2" fill="#0f172a" />
            <line x1="550" y1="54" x2="556" y2="54" stroke="#1e293b" stroke-width="2" />
            <line x1="550" y1="66" x2="556" y2="66" stroke="#1e293b" stroke-width="2" />

            <!-- Chrome Radiator Front Grille -->
            <rect x="592" y="105" width="9" height="34" rx="2" fill="#1e293b" stroke="#cbd5e1" stroke-width="1.2" />
            <line x1="594" y1="112" x2="599" y2="112" stroke="#ffffff" stroke-width="1.4" />
            <line x1="594" y1="118" x2="599" y2="118" stroke="#ffffff" stroke-width="1.4" />
            <line x1="594" y1="124" x2="599" y2="124" stroke="#ffffff" stroke-width="1.4" />
            <line x1="594" y1="130" x2="599" y2="130" stroke="#ffffff" stroke-width="1.4" />

            <!-- High-Intensity Xenon Headlight Cluster -->
            <rect x="589" y="128" width="12" height="14" rx="2.5" fill="#fef08a" stroke="#ffffff" stroke-width="1.5" />
            <circle cx="595" cy="134" r="4" fill="#ffffff" filter="drop-shadow(0 0 4px #ffffff)" />
            <circle cx="583" cy="138" r="3.5" fill="#f59e0b" />

            <!-- Cabin Steps, Door Handles & Roof Clearance Amber Lamps -->
            <rect x="495" y="86" width="11" height="3" rx="1.5" fill="#e2e8f0" />
            <rect x="502" y="132" width="20" height="3" fill="#94a3b8" />
            <rect x="504" y="138" width="17" height="3" fill="#94a3b8" />
            
            <!-- 3 Amber Roof Marker Lights -->
            <circle cx="538" cy="22" r="2" fill="#fbbf24" filter="drop-shadow(0 0 3px #fbbf24)" />
            <circle cx="550" cy="22" r="2" fill="#fbbf24" filter="drop-shadow(0 0 3px #fbbf24)" />
            <circle cx="562" cy="22" r="2" fill="#fbbf24" filter="drop-shadow(0 0 3px #fbbf24)" />
          </g>

          <!-- 5 HEAVY TRUCK WHEEL UNITS WITH SPINNING ALLOY RIMS -->
          <!-- Trailer Tandem Axle 1 -->
          <g class="wheel-unit" transform="translate(180, 150)">
            <circle cx="0" cy="0" r="19" fill="#0f172a" />
            <circle cx="0" cy="0" r="14" fill="url(#rimGrad)" />
            <circle cx="0" cy="0" r="6" fill="#1e293b" />
            <circle cx="0" cy="0" r="2.5" fill="#ffffff" />
            <line x1="-10" y1="0" x2="10" y2="0" stroke="#334155" stroke-width="1.8" class="wheel-spin" />
            <line x1="0" y1="-10" x2="0" y2="10" stroke="#334155" stroke-width="1.8" class="wheel-spin" />
            <line x1="-7" y1="-7" x2="7" y2="7" stroke="#334155" stroke-width="1.2" class="wheel-spin" />
            <line x1="-7" y1="7" x2="7" y2="-7" stroke="#334155" stroke-width="1.2" class="wheel-spin" />
          </g>

          <!-- Trailer Tandem Axle 2 -->
          <g class="wheel-unit" transform="translate(230, 150)">
            <circle cx="0" cy="0" r="19" fill="#0f172a" />
            <circle cx="0" cy="0" r="14" fill="url(#rimGrad)" />
            <circle cx="0" cy="0" r="6" fill="#1e293b" />
            <circle cx="0" cy="0" r="2.5" fill="#ffffff" />
            <line x1="-10" y1="0" x2="10" y2="0" stroke="#334155" stroke-width="1.8" class="wheel-spin" />
            <line x1="0" y1="-10" x2="0" y2="10" stroke="#334155" stroke-width="1.8" class="wheel-spin" />
            <line x1="-7" y1="-7" x2="7" y2="7" stroke="#334155" stroke-width="1.2" class="wheel-spin" />
            <line x1="-7" y1="7" x2="7" y2="-7" stroke="#334155" stroke-width="1.2" class="wheel-spin" />
          </g>

          <!-- Tractor Drive Axle 1 -->
          <g class="wheel-unit" transform="translate(475, 150)">
            <circle cx="0" cy="0" r="19" fill="#0f172a" />
            <circle cx="0" cy="0" r="14" fill="url(#rimGrad)" />
            <circle cx="0" cy="0" r="6" fill="#1e293b" />
            <circle cx="0" cy="0" r="2.5" fill="#ffffff" />
            <line x1="-10" y1="0" x2="10" y2="0" stroke="#334155" stroke-width="1.8" class="wheel-spin" />
            <line x1="0" y1="-10" x2="0" y2="10" stroke="#334155" stroke-width="1.8" class="wheel-spin" />
            <line x1="-7" y1="-7" x2="7" y2="7" stroke="#334155" stroke-width="1.2" class="wheel-spin" />
            <line x1="-7" y1="7" x2="7" y2="-7" stroke="#334155" stroke-width="1.2" class="wheel-spin" />
          </g>

          <!-- Tractor Drive Axle 2 -->
          <g class="wheel-unit" transform="translate(525, 150)">
            <circle cx="0" cy="0" r="19" fill="#0f172a" />
            <circle cx="0" cy="0" r="14" fill="url(#rimGrad)" />
            <circle cx="0" cy="0" r="6" fill="#1e293b" />
            <circle cx="0" cy="0" r="2.5" fill="#ffffff" />
            <line x1="-10" y1="0" x2="10" y2="0" stroke="#334155" stroke-width="1.8" class="wheel-spin" />
            <line x1="0" y1="-10" x2="0" y2="10" stroke="#334155" stroke-width="1.8" class="wheel-spin" />
            <line x1="-7" y1="-7" x2="7" y2="7" stroke="#334155" stroke-width="1.2" class="wheel-spin" />
            <line x1="-7" y1="7" x2="7" y2="-7" stroke="#334155" stroke-width="1.2" class="wheel-spin" />
          </g>

          <!-- Tractor Steer Axle Front -->
          <g class="wheel-unit" transform="translate(578, 150)">
            <circle cx="0" cy="0" r="19" fill="#0f172a" />
            <circle cx="0" cy="0" r="14" fill="url(#rimGrad)" />
            <circle cx="0" cy="0" r="6" fill="#1e293b" />
            <circle cx="0" cy="0" r="2.5" fill="#ffffff" />
            <line x1="-10" y1="0" x2="10" y2="0" stroke="#334155" stroke-width="1.8" class="wheel-spin" />
            <line x1="0" y1="-10" x2="0" y2="10" stroke="#334155" stroke-width="1.8" class="wheel-spin" />
            <line x1="-7" y1="-7" x2="7" y2="7" stroke="#334155" stroke-width="1.2" class="wheel-spin" />
            <line x1="-7" y1="7" x2="7" y2="-7" stroke="#334155" stroke-width="1.2" class="wheel-spin" />
          </g>
        </svg>
      </div>
    </div>
  </div>
</div>

<style>
  .night-highway-scene {
    position: absolute;
    inset: 0;
    width: 100%;
    max-width: 100%;
    height: 100%;
    overflow: hidden;
    contain: paint;
    clip-path: inset(0);
    /* Brighter, vibrant blue-hour twilight gradient */
    background: radial-gradient(ellipse at 70% 30%, #16437d 0%, #0d2a54 42%, #071933 78%, #030e20 100%);
    pointer-events: none;
    z-index: 1;
  }

  /* Sky Backdrop, Horizon Glow & Stars */
  .sky-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    max-width: 100%;
    height: 65%;
    overflow: hidden;
  }

  .moon-glow {
    position: absolute;
    top: 6%;
    right: 22%;
    width: 180px;
    height: 180px;
    background: radial-gradient(circle, rgba(56, 189, 248, 0.25) 0%, rgba(14, 165, 233, 0.08) 50%, transparent 75%);
    border-radius: 50%;
    filter: blur(10px);
  }

  /* Vibrant Horizon Ambient Light */
  .horizon-glow {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 70px;
    background: linear-gradient(180deg, transparent 0%, rgba(56, 189, 248, 0.16) 55%, rgba(2, 132, 199, 0.28) 100%);
    pointer-events: none;
  }

  .stars-cluster {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .star {
    position: absolute;
    width: 2px;
    height: 2px;
    background-color: #ffffff;
    border-radius: 50%;
    box-shadow: 0 0 5px #ffffff, 0 0 8px rgba(56, 189, 248, 0.8);
    animation: starTwinkle 3s ease-in-out infinite alternate;
  }

  .s1 { top: 10%; left: 12%; animation-delay: 0.2s; }
  .s2 { top: 20%; left: 28%; animation-delay: 1.5s; width: 3px; height: 3px; }
  .s3 { top: 7%; left: 48%; animation-delay: 0.8s; }
  .s4 { top: 16%; left: 62%; animation-delay: 2.1s; width: 2.5px; height: 2.5px; }
  .s5 { top: 25%; left: 76%; animation-delay: 0.5s; }
