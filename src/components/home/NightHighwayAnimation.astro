---
// Daylight Highway Animation Component
// 2D Vivid Daytime Expressway with Nam Han Logistics Container Truck in Video-Replay Motion
// Sunlit azure sky, drifting clouds, lush green hills, realistic daylight asphalt & overhead highway gantry
// Fully responsive, zero horizontal overflow (strictly contained within viewBox & clip-path)
---

<div class="day-highway-scene" aria-hidden="true">
  <!-- Sunlit Sky Backdrop with Clouds, Sun Flare & Distant Landscape -->
  <div class="sky-backdrop">
    <!-- Radiant Sun & Ambient Sunbeams -->
    <div class="sun-flare"></div>
    <div class="sun-corona"></div>

    <!-- Soft Drifting Daytime Clouds -->
    <div class="clouds-layer">
      <!-- Cloud 1 -->
      <div class="cloud c1">
        <svg viewBox="0 0 160 50" class="cloud-svg">
          <path d="M20,40 Q10,40 10,30 Q10,18 25,18 Q30,8 48,10 Q65,2 85,12 Q100,5 118,15 Q135,12 145,24 Q155,26 155,36 Q155,42 145,42 Z" fill="#ffffff" />
        </svg>
      </div>
      <!-- Cloud 2 -->
      <div class="cloud c2">
        <svg viewBox="0 0 200 60" class="cloud-svg">
          <path d="M25,50 Q12,50 12,38 Q12,22 32,22 Q38,10 60,12 Q82,2 108,15 Q128,6 150,18 Q172,15 185,30 Q198,32 198,45 Q198,52 185,52 Z" fill="#ffffff" />
        </svg>
      </div>
      <!-- Cloud 3 -->
      <div class="cloud c3">
        <svg viewBox="0 0 140 45" class="cloud-svg">
          <path d="M15,38 Q8,38 8,28 Q8,16 22,16 Q28,8 45,10 Q60,3 78,12 Q92,6 108,15 Q122,12 130,22 Q138,24 138,34 Q138,38 130,38 Z" fill="#ffffff" />
        </svg>
      </div>
    </div>

    <!-- Distant Mountain Ranges, Green Hills & Logistics Center in Daylight -->
    <svg class="distant-landscape" viewBox="0 0 1440 180" preserveAspectRatio="none">
      <defs>
        <!-- Far Blue Mountain Gradient -->
        <linearGradient id="mountainsFarGrad" x1="0%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" stop-color="#3b82f6" stop-opacity="0.6" />
          <stop offset="100%" stop-color="#1d4ed8" stop-opacity="0.85" />
        </linearGradient>

        <!-- Near Green Mountain & Hills Gradient -->
        <linearGradient id="hillsNearGrad" x1="0%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" stop-color="#22c55e" stop-opacity="0.85" />
          <stop offset="50%" stop-color="#16a34a" stop-opacity="0.95" />
          <stop offset="100%" stop-color="#15803d" stop-opacity="1" />
        </linearGradient>

        <!-- Warehouse Wall Gradient -->
        <linearGradient id="warehouseGrad" x1="0%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" stop-color="#f8fafc" />
          <stop offset="100%" stop-color="#cbd5e1" />
        </linearGradient>
      </defs>

      <!-- Far Blue Mountains (Atmospheric Perspective) -->
      <path
        d="M0,100 Q200,45 420,85 T840,60 T1260,75 T1440,90 L1440,180 L0,180 Z"
        fill="url(#mountainsFarGrad)"
      />

      <!-- Near Lush Green Vietnamese Hills -->
      <path
        d="M0,128 Q180,88 360,118 T720,95 T1080,120 T1440,105 L1440,180 L0,180 Z"
        fill="url(#hillsNearGrad)"
      />

      <!-- Modern Logistics Hub / Distribution Depot (Daylight Architecture) -->
      <!-- Warehouse Building 1 -->
      <rect x="850" y="112" width="95" height="38" fill="url(#warehouseGrad)" stroke="#94a3b8" stroke-width="1" rx="2" />
      <polygon points="846,112 897,98 948,112" fill="#0284c7" />
      <!-- Warehouse Dock Doors & Windows -->
      <rect x="860" y="128" width="12" height="22" fill="#334155" rx="1" />
      <rect x="878" y="128" width="12" height="22" fill="#334155" rx="1" />
      <rect x="896" y="128" width="12" height="22" fill="#334155" rx="1" />
      <rect x="914" y="128" width="12" height="22" fill="#334155" rx="1" />
      <line x1="860" y1="120" x2="935" y2="120" stroke="#0284c7" stroke-width="2" />

      <!-- Wind Turbine 1 (Clean Energy / Modern Infrastructure) -->
      <line x1="770" y1="130" x2="770" y2="65" stroke="#ffffff" stroke-width="2.5" />
      <circle cx="770" cy="65" r="2.5" fill="#e2e8f0" />
      <line x1="770" y1="65" x2="752" y2="52" stroke="#ffffff" stroke-width="1.8" />
      <line x1="770" y1="65" x2="788" y2="52" stroke="#ffffff" stroke-width="1.8" />
      <line x1="770" y1="65" x2="770" y2="85" stroke="#ffffff" stroke-width="1.8" />

      <!-- Warehouse Building 2 -->
      <rect x="1040" y="120" width="120" height="35" fill="url(#warehouseGrad)" stroke="#94a3b8" stroke-width="1" rx="2" />
      <polygon points="1036,120 1100,108 1164,120" fill="#0070ba" />
      <rect x="1055" y="132" width="14" height="23" fill="#334155" rx="1" />
      <rect x="1075" y="132" width="14" height="23" fill="#334155" rx="1" />
      <rect x="1095" y="132" width="14" height="23" fill="#334155" rx="1" />
      <rect x="1115" y="132" width="14" height="23" fill="#334155" rx="1" />
      <rect x="1135" y="132" width="14" height="23" fill="#334155" rx="1" />
    </svg>
  </div>

  <!-- Overhead Highway Electronic Sign Gantry (Ground-supported steel structure) -->
  <div class="expressway-gantry" aria-hidden="true">
    <div class="gantry-structure">
      <!-- Right Support Pillar anchored firmly to roadside ground -->
      <div class="gantry-pillar-right"></div>
      
      <!-- Overhead Steel Lattice Truss -->
      <div class="gantry-truss"></div>

      <!-- Professional Vietnamese Expressway Guide Signboard -->
      <div class="gantry-signboard">
        <div class="sign-top-row">
          <span class="sign-badge">CT.01</span>
          <span class="sign-title">CAO TỐC BẮC — NAM | TOÀN TRÌNH 24/7</span>
        </div>
        <div class="sign-bottom-row">
          <span class="sign-dest">HÀ NỘI ⇄ ĐÀ NẴNG ⇄ TP.HCM</span>
          <div class="sign-lane-indicators">
            <span class="lane-led active">↓</span>
            <span class="lane-led active">↓</span>
            <span class="lane-led active">↓</span>
          </div>
        </div>
      </div>

      <!-- Daytime Warning Flasher Beacons -->
      <div class="gantry-flasher flasher-left"></div>
      <div class="gantry-flasher flasher-right"></div>
    </div>
  </div>

  <!-- Highway Roadway Infrastructure (Bright Sunlit Asphalt & Roadside Verges) -->
  <div class="roadway-wrap">
    <!-- Green Grass Embankment & Galvanized Steel Guardrail at Top Shoulder -->
    <div class="road-shoulder">
      <div class="grass-verge"></div>
      <div class="steel-guardrail"></div>
    </div>

    <!-- Road Surface Gradient (Realistic Daylight Slate Asphalt) -->
    <div class="road-surface">
      <!-- Sunlight Glare Sheen across Asphalt -->
      <div class="road-sun-glare"></div>

      <!-- Animated Lane Markings using pure background-position (ZERO layout displacement) -->
      <div class="lane-markings"></div>
      <div class="edge-line edge-top"></div>
      <div class="edge-line edge-bottom"></div>
    </div>

    <!-- Highway Streetlights Layer (Daylight Galvanized Steel Columns) -->
    <div class="streetlights-stream">
      <div class="light-pole p1"><div class="lamp-arm"></div><div class="lamp-head"></div></div>
      <div class="light-pole p2"><div class="lamp-arm"></div><div class="lamp-head"></div></div>
      <div class="light-pole p3"><div class="lamp-arm"></div><div class="lamp-head"></div></div>
      <div class="light-pole p4"><div class="lamp-arm"></div><div class="lamp-head"></div></div>
      <div class="light-pole p5"><div class="lamp-arm"></div><div class="lamp-head"></div></div>
    </div>

    <!-- Daylight Aerodynamic Wind & Speed Streaks (Fast passing highway traffic) -->
    <div class="speed-streaks-container">
      <div class="streak s-white s1"></div>
      <div class="streak s-blue s2"></div>
      <div class="streak s-white s3"></div>
      <div class="streak s-cyan s4"></div>
      <div class="streak s-white s5"></div>
      <div class="streak s-blue s6"></div>
    </div>

    <!-- The 2D Nam Han Container Truck (Dynamic Video Replay: drives across from left to right, exits, loops) -->
    <div class="truck-convoy">
      <div class="truck-suspension-bounce">
        <svg
          class="truck-svg"
          viewBox="0 0 760 180"
          xmlns="http://www.w3.org/2000/svg"
        >
          <defs>
            <!-- Trailer Container Daylight White Gradient -->
            <linearGradient id="dayContainerGrad" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#ffffff" />
              <stop offset="20%" stop-color="#f8fafc" />
              <stop offset="70%" stop-color="#f1f5f9" />
              <stop offset="100%" stop-color="#e2e8f0" />
            </linearGradient>

            <!-- Cabin Glossy Blue Gradient -->
            <linearGradient id="dayCabinGrad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#0284c7" />
              <stop offset="35%" stop-color="#0070ba" />
              <stop offset="75%" stop-color="#0369a1" />
              <stop offset="100%" stop-color="#075985" />
            </linearGradient>

            <!-- Windshield Daylight Sky Glass Reflection -->
            <linearGradient id="dayWindshieldGrad" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.85" />
              <stop offset="50%" stop-color="#0284c7" stop-opacity="0.9" />
              <stop offset="100%" stop-color="#0c4a6e" stop-opacity="0.95" />
            </linearGradient>

            <!-- Chassis Gradient -->
            <linearGradient id="dayChassisGrad" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#64748b" />
              <stop offset="100%" stop-color="#334155" />
            </linearGradient>

            <!-- Wheel Rim Gradient -->
            <radialGradient id="dayRimGrad" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#ffffff" />
              <stop offset="45%" stop-color="#cbd5e1" />
              <stop offset="75%" stop-color="#64748b" />
              <stop offset="100%" stop-color="#1e293b" />
            </radialGradient>
          </defs>

          <!-- Crisp Vehicle Drop Shadow directly on Sunlit Road -->
          <ellipse cx="375" cy="168" rx="260" ry="9" fill="#0f172a" opacity="0.65" />

          <!-- CHASSIS & LOWER FRAMEWORK -->
          <rect x="140" y="142" width="455" height="13" rx="3" fill="url(#dayChassisGrad)" />
          <!-- Aluminum Fuel Tank with Stainless Straps -->
          <rect x="380" y="130" width="62" height="20" rx="4" fill="#cbd5e1" stroke="#64748b" stroke-width="1.5" />
          <line x1="395" y1="130" x2="395" y2="150" stroke="#475569" stroke-width="1.5" />
          <line x1="427" y1="130" x2="427" y2="150" stroke="#475569" stroke-width="1.5" />
          <!-- Battery Box & Air Tanks -->
          <rect x="325" y="133" width="45" height="16" rx="2" fill="#475569" stroke="#334155" stroke-width="1" />

          <!-- TRAILER CONTAINER BODY (High-Cube White 40ft Insulated Container) -->
          <g class="container-body">
            <!-- Main Clean White Container Box -->
            <rect x="135" y="30" width="335" height="112" rx="4" fill="url(#dayContainerGrad)" stroke="#94a3b8" stroke-width="2" />
            
            <!-- Corporate Blue Brand Accent Stripe along bottom -->
            <rect x="135" y="127" width="335" height="15" fill="#0070ba" />
            <rect x="135" y="124" width="335" height="3" fill="#38bdf8" />

            <!-- Vertical Corrugation Ribs of High-Cube Container -->
            <path
              d="M165,32 L165,124 M195,32 L195,124 M225,32 L225,124 M255,32 L255,124 M285,32 L285,124 M315,32 L315,124 M345,32 L345,124 M375,32 L375,124 M405,32 L405,124 M435,32 L435,124 M460,32 L460,124"
              stroke="#cbd5e1"
              stroke-width="1.5"
              opacity="0.9"
            />

            <!-- Nam Han Brand Logo Emblem on Trailer -->
            <circle cx="215" cy="72" r="20" fill="#ffffff" stroke="#0070ba" stroke-width="2.5" />
            <ellipse cx="215" cy="72" rx="20" ry="8" fill="none" stroke="#0284c7" stroke-width="1.6" transform="rotate(-25 215 72)" />
            <path d="M203,72 Q215,58 227,72" fill="none" stroke="#e11d48" stroke-width="2.2" />
            
            <!-- Nam Han Brand Typography on Container -->
            <text x="245" y="68" font-family="system-ui, -apple-system, sans-serif" font-size="17" font-weight="900" fill="#0b2545" letter-spacing="1.2">NAM HÂN</text>
            <text x="245" y="86" font-family="system-ui, -apple-system, sans-serif" font-size="10" font-weight="800" fill="#0070ba" letter-spacing="2.8">LOGISTICS</text>
            <text x="245" y="100" font-family="system-ui, -apple-system, sans-serif" font-size="7" font-weight="700" fill="#475569" letter-spacing="0.8">VẬN TẢI ĐƯỜNG BỘ TOÀN QUỐC</text>

            <!-- Heavy Steel Corner Castings & Vertical Door Locking Bars -->
            <rect x="135" y="30" width="8" height="14" fill="#475569" />
            <rect x="135" y="128" width="8" height="14" fill="#475569" />
            <rect x="462" y="30" width="8" height="14" fill="#475569" />
            <rect x="462" y="128" width="8" height="14" fill="#475569" />

            <!-- Safety Reflective Red/Yellow Chevrons on Rear Edge -->
            <rect x="135" y="55" width="4" height="18" fill="#ef4444" rx="1" />
            <rect x="135" y="80" width="4" height="18" fill="#fbbf24" rx="1" />
            <rect x="135" y="105" width="4" height="18" fill="#ef4444" rx="1" />
          </g>

          <!-- MODERN HEAVY-DUTY PRIME MOVER CABIN (Daylight Gloss) -->
          <g class="truck-cabin">
            <!-- Aerodynamic Roof Fairing & Air Deflector with Sun Glint -->
            <path d="M465,68 Q472,24 525,20 L555,22 Q572,30 578,68 Z" fill="url(#dayCabinGrad)" stroke="#0284c7" stroke-width="1.2" />
            <!-- Sunlight Highlight Strip along roof curve -->
            <path d="M478,28 Q525,22 552,24" stroke="#ffffff" stroke-width="2" fill="none" opacity="0.65" />

            <!-- Main Cab Body -->
            <path d="M465,68 L580,68 L590,95 L600,114 L600,144 L465,144 Z" fill="url(#dayCabinGrad)" />
            
            <!-- Tinted Windshield Glass with Clear Sky Reflection -->
            <path d="M528,32 L568,34 L580,66 L525,66 Z" fill="url(#dayWindshieldGrad)" />
            <polygon points="536,36 558,38 548,64 532,64" fill="#ffffff" opacity="0.4" />

            <!-- Side Door Window -->
            <path d="M488,46 L522,46 L522,72 L484,72 Z" fill="#0c4a6e" />
            <line x1="484" y1="72" x2="522" y2="72" stroke="#0070ba" stroke-width="2" />

            <!-- Aerodynamic Side Mirrors with Chrome Trim -->
            <rect x="556" y="48" width="7" height="24" rx="2" fill="#0f172a" stroke="#cbd5e1" stroke-width="0.8" />
            <line x1="550" y1="54" x2="556" y2="54" stroke="#334155" stroke-width="2" />
            <line x1="550" y1="66" x2="556" y2="66" stroke="#334155" stroke-width="2" />

            <!-- Chrome Radiator Front Grille (Sunlit Chrome) -->
            <rect x="592" y="105" width="9" height="34" rx="2" fill="#0f172a" stroke="#cbd5e1" stroke-width="1.2" />
            <line x1="594" y1="112" x2="599" y2="112" stroke="#ffffff" stroke-width="1.6" />
            <line x1="594" y1="118" x2="599" y2="118" stroke="#ffffff" stroke-width="1.6" />
            <line x1="594" y1="124" x2="599" y2="124" stroke="#ffffff" stroke-width="1.6" />
            <line x1="594" y1="130" x2="599" y2="130" stroke="#ffffff" stroke-width="1.6" />

            <!-- Daytime Running LED Headlight Cluster -->
            <rect x="589" y="128" width="12" height="14" rx="2.5" fill="#f8fafc" stroke="#cbd5e1" stroke-width="1.5" />
            <circle cx="595" cy="134" r="4" fill="#ffffff" filter="drop-shadow(0 0 3px #ffffff)" />
            <circle cx="583" cy="138" r="3.5" fill="#f59e0b" />

            <!-- Cabin Steps, Door Handles & Roof Clearance Lamps -->
            <rect x="495" y="86" width="11" height="3" rx="1.5" fill="#ffffff" />
            <rect x="502" y="132" width="20" height="3" fill="#cbd5e1" />
            <rect x="504" y="138" width="17" height="3" fill="#cbd5e1" />
            
            <!-- 3 Amber Roof Marker Lamps -->
            <circle cx="538" cy="22" r="2" fill="#f59e0b" />
            <circle cx="550" cy="22" r="2" fill="#f59e0b" />
            <circle cx="562" cy="22" r="2" fill="#f59e0b" />
          </g>

          <!-- 5 HEAVY TRUCK WHEEL UNITS WITH SPINNING ALLOY RIMS -->
          <!-- Trailer Tandem Axle 1 -->
          <g class="wheel-unit" transform="translate(180, 150)">
            <circle cx="0" cy="0" r="19" fill="#1e293b" />
            <circle cx="0" cy="0" r="14" fill="url(#dayRimGrad)" />
            <circle cx="0" cy="0" r="6" fill="#0f172a" />
            <circle cx="0" cy="0" r="2.5" fill="#ffffff" />
            <line x1="-10" y1="0" x2="10" y2="0" stroke="#475569" stroke-width="1.8" class="wheel-spin" />
            <line x1="0" y1="-10" x2="0" y2="10" stroke="#475569" stroke-width="1.8" class="wheel-spin" />
            <line x1="-7" y1="-7" x2="7" y2="7" stroke="#475569" stroke-width="1.2" class="wheel-spin" />
            <line x1="-7" y1="7" x2="7" y2="-7" stroke="#475569" stroke-width="1.2" class="wheel-spin" />
          </g>

          <!-- Trailer Tandem Axle 2 -->
          <g class="wheel-unit" transform="translate(230, 150)">
            <circle cx="0" cy="0" r="19" fill="#1e293b" />
            <circle cx="0" cy="0" r="14" fill="url(#dayRimGrad)" />
            <circle cx="0" cy="0" r="6" fill="#0f172a" />
            <circle cx="0" cy="0" r="2.5" fill="#ffffff" />
            <line x1="-10" y1="0" x2="10" y2="0" stroke="#475569" stroke-width="1.8" class="wheel-spin" />
            <line x1="0" y1="-10" x2="0" y2="10" stroke="#475569" stroke-width="1.8" class="wheel-spin" />
            <line x1="-7" y1="-7" x2="7" y2="7" stroke="#475569" stroke-width="1.2" class="wheel-spin" />
            <line x1="-7" y1="7" x2="7" y2="-7" stroke="#475569" stroke-width="1.2" class="wheel-spin" />
          </g>

          <!-- Tractor Drive Axle 1 -->
          <g class="wheel-unit" transform="translate(475, 150)">
            <circle cx="0" cy="0" r="19" fill="#1e293b" />
            <circle cx="0" cy="0" r="14" fill="url(#dayRimGrad)" />
            <circle cx="0" cy="0" r="6" fill="#0f172a" />
            <circle cx="0" cy="0" r="2.5" fill="#ffffff" />
            <line x1="-10" y1="0" x2="10" y2="0" stroke="#475569" stroke-width="1.8" class="wheel-spin" />
            <line x1="0" y1="-10" x2="0" y2="10" stroke="#475569" stroke-width="1.8" class="wheel-spin" />
            <line x1="-7" y1="-7" x2="7" y2="7" stroke="#475569" stroke-width="1.2" class="wheel-spin" />
            <line x1="-7" y1="7" x2="7" y2="-7" stroke="#475569" stroke-width="1.2" class="wheel-spin" />
          </g>

          <!-- Tractor Drive Axle 2 -->
          <g class="wheel-unit" transform="translate(525, 150)">
            <circle cx="0" cy="0" r="19" fill="#1e293b" />
            <circle cx="0" cy="0" r="14" fill="url(#dayRimGrad)" />
            <circle cx="0" cy="0" r="6" fill="#0f172a" />
            <circle cx="0" cy="0" r="2.5" fill="#ffffff" />
            <line x1="-10" y1="0" x2="10" y2="0" stroke="#475569" stroke-width="1.8" class="wheel-spin" />
            <line x1="0" y1="-10" x2="0" y2="10" stroke="#475569" stroke-width="1.8" class="wheel-spin" />
            <line x1="-7" y1="-7" x2="7" y2="7" stroke="#475569" stroke-width="1.2" class="wheel-spin" />
            <line x1="-7" y1="7" x2="7" y2="-7" stroke="#475569" stroke-width="1.2" class="wheel-spin" />
          </g>

          <!-- Tractor Steer Axle Front -->
          <g class="wheel-unit" transform="translate(578, 150)">
            <circle cx="0" cy="0" r="19" fill="#1e293b" />
            <circle cx="0" cy="0" r="14" fill="url(#dayRimGrad)" />
            <circle cx="0" cy="0" r="6" fill="#0f172a" />
            <circle cx="0" cy="0" r="2.5" fill="#ffffff" />
            <line x1="-10" y1="0" x2="10" y2="0" stroke="#475569" stroke-width="1.8" class="wheel-spin" />
            <line x1="0" y1="-10" x2="0" y2="10" stroke="#475569" stroke-width="1.8" class="wheel-spin" />
            <line x1="-7" y1="-7" x2="7" y2="7" stroke="#475569" stroke-width="1.2" class="wheel-spin" />
            <line x1="-7" y1="7" x2="7" y2="-7" stroke="#475569" stroke-width="1.2" class="wheel-spin" />
          </g>
        </svg>
      </div>
    </div>
  </div>
</div>

<style>
  .day-highway-scene {
    position: absolute;
    inset: 0;
    width: 100%;
    max-width: 100%;
    height: 100%;
    overflow: hidden;
    contain: paint;
    clip-path: inset(0);
    /* Vibrant Sunny Daylight Sky */
    background: linear-gradient(180deg, #1d64ad 0%, #2575c0 22%, #3b8fe0 50%, #7bb9fa 78%, #c5e1fe 100%);
    pointer-events: none;
    z-index: 1;
  }

  /* Sky Backdrop, Sun & Drifting White Clouds */
  .sky-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    max-width: 100%;
    height: 65%;
    overflow: hidden;
  }

  /* Radiant Daylight Sun */
  .sun-flare {
    position: absolute;
    top: 5%;
    right: 18%;
    width: 90px;
    height: 90px;
    background: radial-gradient(circle, #ffffff 25%, #fef08a 60%, rgba(254, 240, 138, 0) 100%);
    border-radius: 50%;
    box-shadow: 0 0 35px #ffffff, 0 0 70px rgba(254, 240, 138, 0.7);
  }

  .sun-corona {
    position: absolute;
    top: -15%;
    right: 8%;
    width: 320px;
    height: 320px;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.35) 0%, rgba(254, 240, 138, 0.15) 45%, transparent 75%);
    border-radius: 50%;
    filter: blur(12px);
    pointer-events: none;
  }

  /* Soft Floating White Clouds Layer */
  .clouds-layer {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .cloud {
    position: absolute;
    opacity: 0.88;
    filter: drop-shadow(0 2px 8px rgba(30, 58, 138, 0.15));
    will-change: transform;
  }

  .cloud-svg {
    width: 100%;
    height: auto;
  }

  .c1 {
    top: 10%;
