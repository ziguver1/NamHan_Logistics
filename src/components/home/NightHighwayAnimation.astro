---
// Night Highway Animation Component
// 2D Night Expressway with Nam Han Logistics Container Truck & Neon Light-Trails
// Fully responsive, zero horizontal overflow (strictly contained within viewBox & clip-path)
---

<div class="night-highway-scene" aria-hidden="true">
  <!-- Sky Backdrop with Ambient Stars & Moonlight Horizon -->
  <div class="sky-backdrop">
    <div class="moon-glow"></div>
    <div class="stars-cluster">
      <span class="star s1"></span>
      <span class="star s2"></span>
      <span class="star s3"></span>
      <span class="star s4"></span>
      <span class="star s5"></span>
      <span class="star s6"></span>
      <span class="star s7"></span>
      <span class="star s8"></span>
    </div>
    <!-- Distant Mountains & Logistics Hub Silhouette -->
    <svg class="distant-landscape" viewBox="0 0 1440 180" preserveAspectRatio="none">
      <defs>
        <linearGradient id="mountainsGrad" x1="0%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" stop-color="#0a1d36" stop-opacity="0.8" />
          <stop offset="100%" stop-color="#061324" stop-opacity="0.95" />
        </linearGradient>
      </defs>
      <!-- Mountain Layer -->
      <path
        d="M0,130 Q180,60 360,110 T720,80 T1080,120 T1440,70 L1440,180 L0,180 Z"
        fill="url(#mountainsGrad)"
      />
      <!-- Logistics Warehouse & Beacon Silhouettes in Distance -->
      <rect x="820" y="115" width="70" height="25" fill="#0c2340" rx="2" />
      <polygon points="815,115 855,102 895,115" fill="#0f2b4e" />
      <circle cx="830" cy="122" r="1.5" fill="#38bdf8" class="beacon-pulse" />
      <circle cx="870" cy="122" r="1.5" fill="#fbbf24" class="beacon-pulse" />
      <rect x="940" y="105" width="110" height="35" fill="#08182b" rx="2" />
      <circle cx="955" cy="112" r="1.5" fill="#34d399" class="beacon-pulse" />
      <circle cx="1025" cy="112" r="1.5" fill="#38bdf8" class="beacon-pulse" />
    </svg>
  </div>

  <!-- Highway Roadway Infrastructure -->
  <div class="roadway-wrap">
    <!-- Road Surface Gradient -->
    <div class="road-surface">
      <!-- Animated Lane Markings using pure background-position (ZERO layout displacement) -->
      <div class="lane-markings"></div>
      <div class="edge-line edge-top"></div>
      <div class="edge-line edge-bottom"></div>
    </div>

    <!-- Highway Streetlights Layer -->
    <div class="streetlights-stream">
      <div class="light-pole p1"><div class="lamp-head"></div><div class="light-cone"></div></div>
      <div class="light-pole p2"><div class="lamp-head"></div><div class="light-cone"></div></div>
      <div class="light-pole p3"><div class="lamp-head"></div><div class="light-cone"></div></div>
      <div class="light-pole p4"><div class="lamp-head"></div><div class="light-cone"></div></div>
    </div>

    <!-- Fast Speed Light Trails (Strictly clipped within 100% container) -->
    <div class="light-trails-container">
      <div class="trail trail-cyan t1"></div>
      <div class="trail trail-red t2"></div>
      <div class="trail trail-gold t3"></div>
      <div class="trail trail-cyan t4"></div>
      <div class="trail trail-red t5"></div>
    </div>

    <!-- The 2D Nam Han Container Truck (Self-contained SVG with Headlights & Taillights inside viewBox) -->
    <div class="truck-convoy">
      <div class="truck-vehicle">
        <svg
          class="truck-svg"
          viewBox="0 0 700 180"
          xmlns="http://www.w3.org/2000/svg"
        >
          <defs>
            <!-- Trailer Container Gradient -->
            <linearGradient id="containerGrad" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#ffffff" />
              <stop offset="18%" stop-color="#f1f5f9" />
              <stop offset="70%" stop-color="#e2e8f0" />
              <stop offset="100%" stop-color="#cbd5e1" />
            </linearGradient>

            <!-- Cabin Gradient -->
            <linearGradient id="cabinGrad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#0284c7" />
              <stop offset="50%" stop-color="#0369a1" />
              <stop offset="100%" stop-color="#0b2545" />
            </linearGradient>

            <!-- Chassis Gradient -->
            <linearGradient id="chassisGrad" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#334155" />
              <stop offset="100%" stop-color="#0f172a" />
            </linearGradient>

            <!-- Wheel Rim Gradient -->
            <radialGradient id="rimGrad" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#f8fafc" />
              <stop offset="45%" stop-color="#94a3b8" />
              <stop offset="75%" stop-color="#475569" />
              <stop offset="100%" stop-color="#1e293b" />
            </radialGradient>

            <!-- Headlight Beam Gradient (Inside SVG) -->
            <linearGradient id="headlightGrad" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#fef08a" stop-opacity="0.85" />
              <stop offset="35%" stop-color="#fef08a" stop-opacity="0.35" />
              <stop offset="100%" stop-color="#fef08a" stop-opacity="0" />
            </linearGradient>

            <!-- Taillight Trail Gradient (Inside SVG) -->
            <linearGradient id="taillightGrad" x1="100%" y1="0%" x2="0%" y2="0%">
              <stop offset="0%" stop-color="#ff2a55" stop-opacity="0.95" />
              <stop offset="40%" stop-color="#ef4444" stop-opacity="0.45" />
              <stop offset="100%" stop-color="#ef4444" stop-opacity="0" />
            </linearGradient>
          </defs>

          <!-- TAILLIGHT RED TRAIL (Fully inside SVG viewBox 0 to 120) -->
          <rect x="5" y="112" width="118" height="6" rx="3" fill="url(#taillightGrad)" />
          <rect x="25" y="60" width="98" height="4" rx="2" fill="url(#taillightGrad)" opacity="0.6" />

          <!-- HEADLIGHT YELLOW BEAM (Fully inside SVG viewBox 568 to 695) -->
          <polygon points="568,134 695,108 695,160 568,142" fill="url(#headlightGrad)" />

          <!-- Drop Shadow underneath vehicle -->
          <ellipse cx="350" cy="168" rx="230" ry="8" fill="#000000" opacity="0.65" />

          <!-- CHASSIS & LOWER FRAME (Shifted +100 to fit inside 700 viewBox) -->
          <rect x="125" y="142" width="445" height="12" rx="3" fill="url(#chassisGrad)" />
          <!-- Fuel Tank & Battery Box -->
          <rect x="360" y="132" width="55" height="18" rx="4" fill="#64748b" stroke="#334155" stroke-width="1.5" />
          <rect x="310" y="134" width="38" height="15" rx="2" fill="#475569" />

          <!-- TRAILER BODY (Container) -->
          <g class="container-body">
            <!-- Main Box -->
            <rect x="120" y="32" width="320" height="110" rx="4" fill="url(#containerGrad)" stroke="#94a3b8" stroke-width="1.5" />
            
            <!-- Blue Brand Accent Stripe along bottom of container -->
            <rect x="120" y="128" width="320" height="14" fill="#0070ba" />
            <rect x="120" y="125" width="320" height="3" fill="#38bdf8" />

            <!-- Vertical Corrugation Ribs of the Container -->
            <path d="M150,34 L150,125 M180,34 L180,125 M210,34 L210,125 M240,34 L240,125 M270,34 L270,125 M300,34 L300,125 M330,34 L330,125 M360,34 L360,125 M390,34 L390,125 M420,34 L420,125" stroke="#cbd5e1" stroke-width="1.2" opacity="0.75" />

            <!-- Nam Han Brand Logo & Identification Badge on Container -->
            <circle cx="195" cy="72" r="18" fill="#ffffff" stroke="#0070ba" stroke-width="2" />
            <ellipse cx="195" cy="72" rx="18" ry="7" fill="none" stroke="#0284c7" stroke-width="1.2" transform="rotate(-25 195 72)" />
            <path d="M184,72 Q195,60 206,72" fill="none" stroke="#e11d48" stroke-width="1.8" />
            
            <!-- Brand Text Typography -->
            <text x="222" y="68" font-family="system-ui, -apple-system, sans-serif" font-size="16" font-weight="900" fill="#0b2545" letter-spacing="1">NAM HÂN</text>
            <text x="222" y="85" font-family="system-ui, -apple-system, sans-serif" font-size="9" font-weight="700" fill="#0070ba" letter-spacing="2.5">LOGISTICS</text>
            <text x="222" y="98" font-family="system-ui, -apple-system, sans-serif" font-size="6.5" font-weight="600" fill="#64748b" letter-spacing="0.5">VẬN TẢI ĐƯỜNG BỘ TOÀN QUỐC</text>

            <!-- Container Corner Castings -->
            <rect x="120" y="32" width="8" height="12" fill="#64748b" />
            <rect x="120" y="130" width="8" height="12" fill="#64748b" />
            <!-- Rear Red Reflectors on Container -->
            <rect x="120" y="55" width="3" height="16" fill="#ef4444" rx="1" />
            <rect x="120" y="110" width="3" height="16" fill="#ef4444" rx="1" />
          </g>

          <!-- TRACTOR CABIN (Modern Heavy-Duty Truck Head) -->
          <g class="truck-cabin">
            <!-- Aerodynamic Roof Fairing / Deflector -->
            <path d="M438,70 Q445,26 495,22 L525,24 Q540,32 545,68 Z" fill="url(#cabinGrad)" stroke="#0369a1" stroke-width="1" />
            <!-- Main Cabin Body -->
            <path d="M438,70 L548,70 L558,95 L568,112 L568,142 L438,142 Z" fill="url(#cabinGrad)" />
            
            <!-- Windshield Glass -->
            <path d="M498,34 L535,36 L548,68 L495,68 Z" fill="#0c4a6e" opacity="0.85" />
            <path d="M505,40 L530,42 L522,62 L502,62 Z" fill="#38bdf8" opacity="0.45" />

            <!-- Side Window -->
            <path d="M462,48 L492,48 L492,72 L458,72 Z" fill="#0c4a6e" opacity="0.9" />
            <!-- Driver Mirror -->
            <rect x="524" y="50" width="6" height="22" rx="2" fill="#1e293b" />
            <line x1="518" y1="56" x2="524" y2="56" stroke="#1e293b" stroke-width="2" />
            <line x1="518" y1="68" x2="524" y2="68" stroke="#1e293b" stroke-width="2" />

            <!-- Radiator Chrome Grill -->
            <rect x="560" y="105" width="9" height="32" rx="2" fill="#1e293b" stroke="#94a3b8" stroke-width="1" />
            <line x1="562" y1="112" x2="567" y2="112" stroke="#cbd5e1" stroke-width="1.2" />
            <line x1="562" y1="118" x2="567" y2="118" stroke="#cbd5e1" stroke-width="1.2" />
            <line x1="562" y1="124" x2="567" y2="124" stroke="#cbd5e1" stroke-width="1.2" />
            <line x1="562" y1="130" x2="567" y2="130" stroke="#cbd5e1" stroke-width="1.2" />

            <!-- Powerful Headlight Unit -->
            <rect x="558" y="128" width="11" height="12" rx="2" fill="#fef08a" stroke="#ffffff" stroke-width="1" />
            <circle cx="563" cy="134" r="3.5" fill="#ffffff" />
            <circle cx="552" cy="138" r="3" fill="#facc15" />

            <!-- Steps & Handles -->
            <rect x="468" y="88" width="10" height="3" rx="1" fill="#cbd5e1" />
            <rect x="475" y="132" width="18" height="3" fill="#94a3b8" />
            <rect x="477" y="138" width="15" height="3" fill="#94a3b8" />
          </g>

          <!-- WHEEL UNITS (5 Sets with Rotating Alloy Rims) -->
          <g class="wheel-unit" transform="translate(162, 150)">
            <circle cx="0" cy="0" r="19" fill="#0f172a" />
            <circle cx="0" cy="0" r="14" fill="url(#rimGrad)" />
            <circle cx="0" cy="0" r="6" fill="#1e293b" />
            <circle cx="0" cy="0" r="2.5" fill="#cbd5e1" />
            <line x1="-10" y1="0" x2="10" y2="0" stroke="#334155" stroke-width="1.5" class="wheel-spin" />
            <line x1="0" y1="-10" x2="0" y2="10" stroke="#334155" stroke-width="1.5" class="wheel-spin" />
          </g>

          <g class="wheel-unit" transform="translate(208, 150)">
            <circle cx="0" cy="0" r="19" fill="#0f172a" />
            <circle cx="0" cy="0" r="14" fill="url(#rimGrad)" />
            <circle cx="0" cy="0" r="6" fill="#1e293b" />
            <circle cx="0" cy="0" r="2.5" fill="#cbd5e1" />
            <line x1="-10" y1="0" x2="10" y2="0" stroke="#334155" stroke-width="1.5" class="wheel-spin" />
            <line x1="0" y1="-10" x2="0" y2="10" stroke="#334155" stroke-width="1.5" class="wheel-spin" />
          </g>

          <g class="wheel-unit" transform="translate(445, 150)">
            <circle cx="0" cy="0" r="19" fill="#0f172a" />
            <circle cx="0" cy="0" r="14" fill="url(#rimGrad)" />
            <circle cx="0" cy="0" r="6" fill="#1e293b" />
            <circle cx="0" cy="0" r="2.5" fill="#cbd5e1" />
            <line x1="-10" y1="0" x2="10" y2="0" stroke="#334155" stroke-width="1.5" class="wheel-spin" />
            <line x1="0" y1="-10" x2="0" y2="10" stroke="#334155" stroke-width="1.5" class="wheel-spin" />
          </g>

          <g class="wheel-unit" transform="translate(490, 150)">
            <circle cx="0" cy="0" r="19" fill="#0f172a" />
            <circle cx="0" cy="0" r="14" fill="url(#rimGrad)" />
            <circle cx="0" cy="0" r="6" fill="#1e293b" />
            <circle cx="0" cy="0" r="2.5" fill="#cbd5e1" />
            <line x1="-10" y1="0" x2="10" y2="0" stroke="#334155" stroke-width="1.5" class="wheel-spin" />
            <line x1="0" y1="-10" x2="0" y2="10" stroke="#334155" stroke-width="1.5" class="wheel-spin" />
          </g>

          <g class="wheel-unit" transform="translate(542, 150)">
            <circle cx="0" cy="0" r="19" fill="#0f172a" />
            <circle cx="0" cy="0" r="14" fill="url(#rimGrad)" />
            <circle cx="0" cy="0" r="6" fill="#1e293b" />
            <circle cx="0" cy="0" r="2.5" fill="#cbd5e1" />
            <line x1="-10" y1="0" x2="10" y2="0" stroke="#334155" stroke-width="1.5" class="wheel-spin" />
            <line x1="0" y1="-10" x2="0" y2="10" stroke="#334155" stroke-width="1.5" class="wheel-spin" />
          </g>
        </svg>
      </div>
    </div>
  </div>
</div>

<style>
  .night-highway-scene {
    position: absolute;
    inset: 0;
    width: 100%;
    max-width: 100%;
    height: 100%;
    overflow: hidden;
    contain: paint;
    clip-path: inset(0);
    background: radial-gradient(circle at 75% 20%, #0d284a 0%, #06152b 55%, #030c18 100%);
    pointer-events: none;
    z-index: 1;
  }

  /* Sky Backdrop & Stars */
  .sky-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    max-width: 100%;
    height: 65%;
    overflow: hidden;
  }

  .moon-glow {
    position: absolute;
    top: 8%;
    right: 18%;
    width: 140px;
    height: 140px;
    background: radial-gradient(circle, rgba(56, 189, 248, 0.18) 0%, rgba(14, 165, 233, 0.05) 50%, transparent 70%);
    border-radius: 50%;
  }

  .stars-cluster {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .star {
    position: absolute;
    width: 2px;
    height: 2px;
    background-color: #ffffff;
    border-radius: 50%;
    box-shadow: 0 0 4px #ffffff;
    animation: starTwinkle 3s ease-in-out infinite alternate;
  }

  .s1 { top: 12%; left: 15%; animation-delay: 0.2s; }
  .s2 { top: 22%; left: 32%; animation-delay: 1.5s; width: 3px; height: 3px; }
  .s3 { top: 8%; left: 55%; animation-delay: 0.8s; }
  .s4 { top: 18%; left: 70%; animation-delay: 2.1s; width: 2.5px; height: 2.5px; }
  .s5 { top: 28%; left: 82%; animation-delay: 0.5s; }
  .s6 { top: 15%; left: 92%; animation-delay: 1.8s; }
  .s7 { top: 32%; left: 45%; animation-delay: 2.4s; }
  .s8 { top: 25%; left: 8%; animation-delay: 1.1s; width: 3px; height: 3px; }

  @keyframes starTwinkle {
    0% { opacity: 0.3; transform: scale(0.8); }
    100% { opacity: 1; transform: scale(1.3); }
  }

  .distant-landscape {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    max-width: 100%;
    height: 90px;
    opacity: 0.6;
  }

  .beacon-pulse {
    animation: beaconBlink 1.8s infinite;
  }

  @keyframes beaconBlink {
    0%, 100% { opacity: 0.2; }
    50% { opacity: 1; filter: drop-shadow(0 0 3px currentColor); }
  }

  /* Highway Roadway Infrastructure */
  .roadway-wrap {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    max-width: 100%;
    height: 48%;
    min-height: 180px;
    overflow: hidden;
    contain: paint;
    clip-path: inset(0);
  }

  .road-surface {
    position: absolute;
    inset: 0;
    width: 100%;
    max-width: 100%;
    background: linear-gradient(180deg, #091a2e 0%, #0d1e33 25%, #081321 100%);
    box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.8);
    overflow: hidden;
  }

  .edge-line {
    position: absolute;
    left: 0;
    width: 100%;
    max-width: 100%;
    height: 3px;
  }

  .edge-top {
    top: 0;
    background: linear-gradient(90deg, #1e3a5f, #38bdf8, #1e3a5f);
    opacity: 0.7;
    box-shadow: 0 0 6px rgba(56, 189, 248, 0.4);
  }

  .edge-bottom {
    bottom: 4px;
    background: #1e293b;
  }

  /* High-Speed Moving Dashed Markings - ZERO layout displacement via background-position-x */
  .lane-markings {
    position: absolute;
    top: 55%;
    left: 0;
    right: 0;
    width: 100%;
    max-width: 100%;
    height: 4px;
    background-image: repeating-linear-gradient(
      90deg,
      #fbbf24 0px,
      #fbbf24 35px,
      transparent 35px,
      transparent 75px
    );
    opacity: 0.8;
    filter: drop-shadow(0 0 4px rgba(251, 191, 36, 0.6));
    animation: highwayMarkingsMove 0.5s linear infinite;
  }

  @keyframes highwayMarkingsMove {
    0% { background-position-x: 0px; }
    100% { background-position-x: -75px; }
  }

  /* Streetlights stream passing overhead */
  .streetlights-stream {
    position: absolute;
    top: -30px;
    left: 0;
    width: 100%;
    max-width: 100%;
    height: 100%;
    overflow: hidden;
    pointer-events: none;
  }

  .light-pole {
    position: absolute;
    top: 0;
    width: 4px;
    height: 60px;
    background: linear-gradient(180deg, #475569 0%, #1e293b 100%);
  }

  .p1 { left: 15%; }
  .p2 { left: 42%; }
  .p3 { left: 68%; }
  .p4 { left: 90%; }

  .lamp-head {
    position: absolute;
    top: 0;
    right: 0;
    width: 12px;
    height: 5px;
    background: #f8fafc;
    border-radius: 2px;
    box-shadow: 0 0 8px #fef08a;
  }

  .light-cone {
    position: absolute;
    top: 5px;
    right: -20px;
    width: 50px;
    height: 110px;
    background: linear-gradient(180deg, rgba(254, 240, 138, 0.16) 0%, transparent 80%);
    clip-path: polygon(45% 0%, 55% 0%, 100% 100%, 0% 100%);
    pointer-events: none;
  }

  /* Fast Neon Light Trails - strictly contained */
  .light-trails-container {
    position: absolute;
    inset: 0;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    contain: paint;
    clip-path: inset(0);
  }

  .trail {
    position: absolute;
    height: 2px;
    border-radius: 999px;
    filter: blur(0.5px);
    will-change: transform;
  }

  .trail-cyan {
    background: linear-gradient(90deg, transparent, #38bdf8 30%, #ffffff 85%, transparent);
    box-shadow: 0 0 8px #0284c7;
  }

  .trail-red {
    background: linear-gradient(90deg, transparent, #f43f5e 30%, #ff2a55 85%, transparent);
    box-shadow: 0 0 10px #e11d48;
  }

  .trail-gold {
    background: linear-gradient(90deg, transparent, #fbbf24 30%, #fffbeb 85%, transparent);
    box-shadow: 0 0 8px #d97706;
  }

  .t1 {
    top: 25%;
    width: 240px;
    animation: trailRush 1.4s ease-out infinite;
    animation-delay: 0.1s;
  }

  .t2 {
    top: 68%;
    width: 320px;
    animation: trailRush 1.1s ease-out infinite;
    animation-delay: 0.6s;
  }

  .t3 {
    top: 42%;
    width: 190px;
    animation: trailRush 1.7s ease-out infinite;
    animation-delay: 0.9s;
  }

  .t4 {
    top: 78%;
    width: 260px;
    animation: trailRush 1.3s ease-out infinite;
    animation-delay: 0.3s;
  }

  .t5 {
    top: 15%;
    width: 150px;
    animation: trailRush 2.1s ease-out infinite;
    animation-delay: 1.2s;
  }

  @keyframes trailRush {
    0% {
      transform: translate3d(100%, 0, 0);
      opacity: 0;
    }
    15% {
      opacity: 1;
    }
    85% {
      opacity: 1;
    }
    100% {
      transform: translate3d(-100%, 0, 0);
      opacity: 0;
    }
  }

  /* Truck Convoy Positioning & Animation - strictly bound inside 100% width */
  .truck-convoy {
    position: absolute;
    bottom: 8px;
    right: 2%;
    width: clamp(250px, 40vw, 520px);
    max-width: 96%;
    z-index: 5;
    pointer-events: none;
  }

  @media (max-width: 767px) {
    .truck-convoy {
      right: 0;
      bottom: 4px;
      width: min(320px, 88vw);
      max-width: 95%;
      opacity: 0.9;
    }
  }

  .truck-vehicle {
    position: relative;
    width: 100%;
    max-width: 100%;
    animation: truckVibration 0.35s ease-in-out infinite alternate;
  }

  @keyframes truckVibration {
    0% { transform: translate3d(0, 0, 0); }
    100% { transform: translate3d(0, -1.8px, 0); }
  }

  .truck-svg {
    width: 100%;
    max-width: 100%;
    height: auto;
    display: block;
    filter: drop-shadow(0 8px 16px rgba(0, 0, 0, 0.7));
  }

  /* Wheel Spin Keyframe */
  .wheel-spin {
    transform-origin: center;
    animation: wheelRotate 0.28s linear infinite;
  }

  @keyframes wheelRotate {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  /* Accessibility & Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .lane-markings,
    .trail,
    .truck-vehicle,
    .wheel-spin,
    .star,
    .beacon-pulse {
      animation: none !important;
