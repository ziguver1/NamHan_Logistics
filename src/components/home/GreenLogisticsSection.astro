---
import { homeAssets } from '@/content/home-assets';
import ImageSlot from '@/components/ui/ImageSlot.astro';

const greenImg = homeAssets.greenLogistics;
---

<section class="green-section section section-navy" aria-labelledby="green-heading">
  <div class="container green-grid">
    <!-- Text & Commitments -->
    <div class="green-content">
      <div class="green-tag">
        <span class="leaf-icon" aria-hidden="true">🌱</span>
        <span>VẬN TẢI XANH & PHÁT TRIỂN BỀN VỮNG</span>
      </div>

      <h2 id="green-heading" class="green-title">
        CAM KẾT BẢO VỆ MÔI TRƯỜNG QUA TỪNG HÀNH TRÌNH VẬN CHUYỂN
      </h2>

      <p class="green-desc">
        Nam Hân Logistics tiên phong ứng dụng các giải pháp logistics xanh: từ nâng cấp đội phương tiện đạt chuẩn khí thải cao đến tối ưu hóa lộ trình bằng thuật toán điều phối thông minh, giúp giảm thiểu đáng kể phát thải CO2 ra môi trường.
      </p>

      <!-- Eco Metrics -->
      <div class="eco-metrics">
        <div class="metric-card">
          <span class="metric-value">-18%</span>
          <span class="metric-title">Giảm phát thải khí nhà kính</span>
          <p class="metric-text">Nhờ tối ưu hóa tải trọng 2 chiều và hạn chế chạy rỗng.</p>
        </div>

        <div class="metric-card">
          <span class="metric-value">100%</span>
          <span class="metric-title">Phương tiện đạt chuẩn khí thải</span>
          <p class="metric-text">Được bảo dưỡng định kỳ nghiêm ngặt tại các trạm kiểm định uy tín.</p>
        </div>
      </div>
    </div>

    <!-- Green Media Slot -->
    <div class="green-media">
      <div class="media-frame">
        <ImageSlot
          src={greenImg?.src}
          alt={greenImg?.alt}
          label={greenImg?.label}
          aspectRatio="16/10"
          rounded="xl"
          loading="eager"
        />
        <div class="eco-badge">
          <span class="badge-title">Tiêu chuẩn Euro 4 & Euro 5</span>
          <span class="badge-desc">Hành trình xanh — Tương lai bền vững</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .green-section {
    background-color: var(--color-brand-navy);
    color: var(--color-text-inverse);
    position: relative;
    overflow: hidden;
  }

  .green-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .green-grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 4rem;
    }
  }

  .green-content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .green-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    align-self: flex-start;
    padding: 0.375rem 0.875rem;
    background-color: rgba(34, 197, 94, 0.15);
    border: 1px solid rgba(34, 197, 94, 0.3);
    border-radius: var(--radius-full);
    font-size: 0.8125rem;
    font-weight: 700;
    color: #4ade80;
    letter-spacing: 0.05em;
  }

  .green-title {
    font-size: var(--font-h2);
    font-weight: 900;
    color: var(--color-text-inverse);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .green-desc {
    font-size: var(--font-body);
    color: #cbd5e1;
    line-height: 1.65;
  }

  /* Eco Metrics */
  .eco-metrics {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin-top: 1rem;
  }

  @media (min-width: 640px) {
    .eco-metrics {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .metric-card {
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .metric-value {
    font-size: 2.25rem;
    font-weight: 900;
    color: #4ade80;
    line-height: 1;
  }

  .metric-title {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-text-inverse);
  }

  .metric-text {
    font-size: 0.8125rem;
    color: #94a3b8;
    line-height: 1.45;
  }

  /* Media Frame */
  .green-media {
    position: relative;
    width: 100%;
  }

  .media-frame {
    position: relative;
    border-radius: var(--radius-xl);
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3);
  }

  .eco-badge {
    position: absolute;
    bottom: -1rem;
    right: 1.5rem;
    background-color: var(--color-brand-orange);
    color: var(--color-text-inverse);
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    display: flex;
    flex-direction: column;
    z-index: 2;
  }

  .badge-title {
    font-weight: 700;
    font-size: 0.875rem;
  }

  .badge-desc {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.85);
  }

  @media (max-width: 639px) {
    .eco-badge {
      position: static;
      margin-top: 0.75rem;
    }
  }
</style>
