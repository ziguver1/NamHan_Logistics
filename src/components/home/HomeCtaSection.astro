---
import { ROUTES } from '@/lib/routes';
import { companyInfo } from '@/content/company';
---

<section class="home-cta-section section" aria-labelledby="cta-heading">
  <div class="container">
    <div class="cta-banner">
      <div class="cta-content">
        <span class="cta-tag">KẾT NỐI VẬN TẢI TOÀN QUỐC</span>
        <h2 id="cta-heading" class="cta-title">
          BẠN ĐANG TÌM KIẾM ĐỐI TÁC VẬN TẢI ĐƯỜNG BỘ UY TÍN & ĐÚNG HẸN?
        </h2>
        <p class="cta-desc">
          Hãy để Nam Hân Logistics đồng hành cùng dòng chảy hàng hóa của bạn. Đội ngũ chuyên gia sẵn sàng khảo sát thực tế và đề xuất phương án tối ưu chi phí trong thời gian sớm nhất.
        </p>

        <div class="cta-buttons">
          <a href={ROUTES.CONTACT} class="btn-cta-primary">
            Yêu cầu báo giá vận tải
            <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M4.167 10h11.666m-4.166-4.167L15.833 10l-4.166 4.167" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <a href={`tel:${companyInfo.hotline.replace(/\s+/g, '')}`} class="btn-cta-phone">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            <span>Hotline: {companyInfo.hotline}</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .home-cta-section {
    background-color: var(--color-bg-page);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .cta-banner {
    background: linear-gradient(135deg, var(--color-brand-navy) 0%, var(--color-brand-navy-light) 100%);
    color: var(--color-text-inverse);
    border-radius: var(--radius-xl);
    padding: clamp(2.5rem, 5vw, 4rem) clamp(1.5rem, 4vw, 3.5rem);
    box-shadow: var(--shadow-lg);
    position: relative;
    overflow: hidden;
  }

  .cta-banner::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 60%;
    height: 200%;
    background: radial-gradient(circle, rgba(249, 80, 22, 0.15) 0%, transparent 70%);
    pointer-events: none;
  }

  .cta-content {
    max-width: 46rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    position: relative;
    z-index: 2;
  }

  .cta-tag {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-brand-orange);
    text-transform: uppercase;
  }

  .cta-title {
    font-size: var(--font-h2);
    font-weight: 900;
    color: var(--color-text-inverse);
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .cta-desc {
    font-size: var(--font-body);
    color: #cbd5e1;
    line-height: 1.65;
  }

  .cta-buttons {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 0.75rem;
  }

  @media (min-width: 640px) {
    .cta-buttons {
      flex-direction: row;
      align-items: center;
    }
  }

  .btn-cta-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: var(--touch-target-min);
    background-color: var(--color-brand-orange);
    color: var(--color-text-inverse);
    font-weight: 700;
    font-size: 0.9375rem;
    padding: 0.875rem 1.75rem;
    border-radius: var(--radius-md);
    box-shadow: 0 4px 14px rgba(249, 80, 22, 0.4);
    transition: all var(--transition-fast);
  }

  .btn-cta-primary:hover {
    background-color: var(--color-brand-orange-hover);
    transform: translateY(-2px);
  }

  .btn-cta-phone {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: var(--touch-target-min);
    background-color: rgba(255, 255, 255, 0.1);
    color: var(--color-text-inverse);
    border: 1px solid rgba(255, 255, 255, 0.25);
    font-weight: 600;
    font-size: 0.9375rem;
    padding: 0.875rem 1.5rem;
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
  }

  .btn-cta-phone:hover {
    background-color: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.5);
  }
</style>
