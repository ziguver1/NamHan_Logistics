---
import { ROUTES } from '@/lib/routes';
import { mainNavigation, headerCTA } from '@/content/navigation';
import { companyInfo } from '@/content/company';
import { brandAssets } from '@/content/brand';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---

<header class="site-header">
  <div class="container header-inner">
    <!-- Brand Logo -->
    <a href={ROUTES.HOME} class="brand-logo" aria-label={`${companyInfo.shortName} - Trang chủ`}>
      <img
        src={brandAssets.logo.src}
        alt={brandAssets.logo.alt}
        width={brandAssets.logo.width}
        height={brandAssets.logo.height}
        class="header-logo-img"
      />
    </a>

    <!-- Mobile Menu Toggle Button (Touch Target >= 44x44px) -->
    <button
      type="button"
      id="mobile-menu-toggle"
      class="mobile-toggle"
      aria-expanded="false"
      aria-controls="primary-navigation"
      aria-label="Mở menu điều hướng"
    >
      <svg class="icon-hamburger" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
      <svg class="icon-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
      <span class="sr-only">Menu</span>
    </button>

    <!-- Navigation Menu (Desktop & Mobile Drawer) -->
    <nav id="primary-navigation" class="site-nav" aria-label="Điều hướng chính">
      <ul class="nav-list">
        {mainNavigation.map((item) => (
          <li class={`nav-item ${item.children ? 'has-dropdown' : ''}`}>
            <a
              href={item.href}
              class={`nav-link ${currentPath === item.href ? 'active' : ''}`}
              aria-current={currentPath === item.href ? 'page' : undefined}
            >
              {item.label}
              {item.children && (
                <svg class="dropdown-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              )}
            </a>
            {item.children && (
              <ul class="dropdown-menu">
                {item.children.map((sub) => (
                  <li>
                    <a
                      href={sub.href}
                      class={`dropdown-link ${currentPath === sub.href ? 'active' : ''}`}
                      aria-current={currentPath === sub.href ? 'page' : undefined}
                    >
                      {sub.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>

      <!-- Header CTA in Nav -->
      <div class="nav-cta-wrap">
        <a href={headerCTA.href} class="btn-header-cta">
          <span>{headerCTA.label}</span>
          <span class="cta-arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <!-- Quick Contact Actions in Mobile Drawer -->
      <div class="mobile-drawer-contact">
        <p class="drawer-contact-title">HỖ TRỢ TRỰC TIẾP 24/7</p>
        <div class="drawer-contact-buttons">
          <a href={`tel:${companyInfo.hotline.replace(/\s+/g, '')}`} class="drawer-btn-hotline" aria-label={`Gọi ngay Hotline ${companyInfo.hotline}`}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            <span>{companyInfo.hotline}</span>
          </a>
          <a href={`https://zalo.me/${companyInfo.hotline.replace(/\s+/g, '')}`} target="_blank" rel="noopener noreferrer" class="drawer-btn-zalo" aria-label="Tư vấn nhanh qua Zalo">
            <span class="zalo-badge" aria-hidden="true">Zalo</span>
            <span>Nhắn Zalo</span>
          </a>
        </div>
        <p class="drawer-address-info">{companyInfo.address}</p>
      </div>
    </nav>
  </div>

  <!-- Mobile Drawer Backdrop Overlay -->
  <div class="drawer-backdrop" id="mobile-drawer-backdrop" aria-hidden="true"></div>
</header>

<script>
  // Progressive enhancement for mobile menu drawer
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const navMenu = document.getElementById('primary-navigation');
  const backdrop = document.getElementById('mobile-drawer-backdrop');

  if (toggleBtn && navMenu) {
    const toggleMenu = () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      toggleBtn.setAttribute('aria-label', isExpanded ? 'Mở menu điều hướng' : 'Đóng menu điều hướng');
      navMenu.classList.toggle('is-open', !isExpanded);
      if (backdrop) backdrop.classList.toggle('is-open', !isExpanded);
      document.body.classList.toggle('menu-open', !isExpanded);
    };

    toggleBtn.addEventListener('click', toggleMenu);
    if (backdrop) {
      backdrop.addEventListener('click', toggleMenu);
    }

    // Close on Escape key
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && navMenu.classList.contains('is-open')) {
        toggleMenu();
        toggleBtn.focus();
      }
    });

    // Close when clicking nav links on mobile
    const links = navMenu.querySelectorAll('a');
    links.forEach((link) => {
      link.addEventListener('click', () => {
        if (navMenu.classList.contains('is-open')) {
          toggleMenu();
        }
      });
    });
  }
</script>

<style>
  .site-header {
    width: 100%;
    max-width: 100%;
    background-color: var(--color-bg-page);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 100;
    padding-top: var(--safe-top);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4.5rem;
  }

  /* Brand Logo */
  .brand-logo {
    display: flex;
    align-items: center;
    min-height: var(--touch-target-min);
  }

  .header-logo-img {
    height: 44px;
    width: auto;
    object-fit: contain;
    display: block;
  }

  .logo-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    background-color: var(--color-brand-navy);
    color: var(--color-text-inverse);
    font-weight: 800;
    font-size: 1.125rem;
    border-radius: var(--radius-sm);
    letter-spacing: -0.02em;
  }

  .logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .logo-title {
    font-size: 1.125rem;
    font-weight: 800;
    color: var(--color-brand-navy);
    letter-spacing: -0.01em;
  }

  .logo-sub {
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--color-brand-orange);
    letter-spacing: 0.12em;
  }

  /* Mobile Toggle Button */
  .mobile-toggle {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--touch-target-min, 44px);
    height: var(--touch-target-min, 44px);
    padding: 0;
    margin: 0;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-brand-navy);
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
    flex-shrink: 0;
    box-sizing: border-box;
    transition: background-color var(--transition-fast), border-color var(--transition-fast);
  }

  .mobile-toggle:hover {
    background-color: var(--color-bg-muted);
  }

  .mobile-toggle[aria-expanded="true"] {
    background-color: #f1f5f9;
    border-color: #cbd5e1;
    color: var(--color-brand-orange);
  }

  .mobile-toggle .icon-hamburger {
    display: block;
    width: 22px;
    height: 22px;
    margin: auto;
  }

  .mobile-toggle .icon-close {
    display: none;
    width: 22px;
    height: 22px;
    margin: auto;
  }

  /* When drawer is open: switch to centered 'X' icon */
  .mobile-toggle[aria-expanded="true"] .icon-hamburger {
    display: none;
  }

  .mobile-toggle[aria-expanded="true"] .icon-close {
    display: block;
  }

  /* Backdrop Overlay */
  .drawer-backdrop {
    display: none;
  }

  /* Mobile Navigation Drawer Default (max-width: 1023px) */
  @media (max-width: 1023px) {
    .drawer-backdrop.is-open {
      display: block;
      position: fixed;
      inset: 0;
      top: calc(4.5rem + var(--safe-top));
      background-color: rgba(11, 37, 69, 0.45);
      backdrop-filter: blur(2px);
      z-index: 98;
      animation: fadeInBackdrop 0.2s ease-out;
    }

    @keyframes fadeInBackdrop {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    .site-nav {
      position: fixed;
      top: calc(4.5rem + var(--safe-top));
      left: 0;
      right: 0;
      bottom: 0;
      height: calc(100dvh - 4.5rem - var(--safe-top));
      background-color: var(--color-bg-page);
      display: none;
      flex-direction: column;
      padding: 1.25rem var(--page-gutter);
      padding-bottom: calc(2rem + var(--safe-bottom));
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
      border-top: 1px solid var(--color-border);
      z-index: 99;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
      animation: slideDownMenu 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @keyframes slideDownMenu {
      from {
        opacity: 0;
        transform: translateY(-8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .site-nav.is-open {
      display: flex;
    }

    .nav-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.375rem;
    }

    .nav-link {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: var(--touch-target-min);
      padding: 0.625rem 0.25rem;
      font-size: 1.0625rem;
      font-weight: 700;
      color: var(--color-brand-navy);
      border-bottom: 1px solid var(--color-border);
    }

    .nav-link.active {
      color: var(--color-brand-orange);
    }

    .dropdown-menu {
      list-style: none;
      padding: 0.375rem 0.5rem 0.375rem 1rem;
      margin-top: 0.25rem;
      margin-bottom: 0.5rem;
      background-color: var(--color-bg-muted, #f8fafc);
      border-left: 3px solid var(--color-brand-orange, #f95016);
      border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    .dropdown-link {
      display: flex;
      align-items: center;
      min-height: var(--touch-target-min);
      padding: 0.5rem 0.25rem;
      font-size: 0.9375rem;
      color: var(--color-text-secondary);
    }

    .dropdown-link.active {
      color: var(--color-brand-orange);
      font-weight: 600;
    }

    .nav-cta-wrap {
      margin-top: 1.25rem;
    }

    .btn-header-cta {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.375rem;
      width: 100%;
      min-height: 48px;
      background-color: var(--color-brand-orange);
      color: var(--color-text-inverse);
      font-weight: 700;
      font-size: 0.9375rem;
      border-radius: var(--radius-full);
      padding: 0.75rem 1.5rem;
      box-shadow: 0 4px 12px rgba(249, 80, 22, 0.3);
    }

    .mobile-drawer-contact {
      margin-top: 1.25rem;
      padding-top: 1.25rem;
      border-top: 1px dashed var(--color-border);
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .drawer-contact-title {
      font-size: 0.6875rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      color: var(--color-text-muted);
      text-transform: uppercase;
      margin: 0;
    }

    .drawer-contact-buttons {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.625rem;
    }

    .drawer-btn-hotline {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.375rem;
      min-height: 46px;
      padding: 0.625rem 0.75rem;
      background-color: #f0fdf4;
      border: 1px solid #bbf7d0;
      color: #166534;
      border-radius: var(--radius-md);
      font-size: 0.8125rem;
      font-weight: 700;
      text-decoration: none;
    }

    .drawer-btn-zalo {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.375rem;
      min-height: 46px;
      padding: 0.625rem 0.75rem;
      background-color: #eff6ff;
      border: 1px solid #bfdbfe;
      color: #1d4ed8;
      border-radius: var(--radius-md);
      font-size: 0.8125rem;
      font-weight: 700;
      text-decoration: none;
    }

    .drawer-btn-zalo .zalo-badge {
      background-color: #0068ff;
      color: #ffffff;
      font-size: 0.5625rem;
      font-weight: 800;
      padding: 0.125rem 0.3125rem;
      border-radius: 4px;
      line-height: 1;
    }

    .drawer-address-info {
      font-size: 0.75rem;
      color: var(--color-text-muted);
      line-height: 1.45;
      margin: 0;
    }
  }

  /* Desktop Navigation (min-width: 1024px) */
  @media (min-width: 1024px) {
    .mobile-toggle {
      display: none;
    }

    .site-nav {
      display: flex;
      align-items: center;
      gap: 2rem;
    }

    .nav-list {
      list-style: none;
      display: flex;
      align-items: center;
      gap: 1.75rem;
    }

    .nav-item {
      position: relative;
    }

    .nav-link {
      display: inline-flex;
      align-items: center;
      position: relative;
      font-size: 0.9375rem;
      font-weight: 500;
      color: var(--color-brand-navy);
      padding: 0.5rem 0;
      transition: color var(--transition-fast);
    }

    .nav-link:hover {
      color: #0070ba;
    }

    .nav-link.active {
      color: #0070ba;
      font-weight: 600;
    }

    .nav-link.active::after {
      content: '';
      position: absolute;
      bottom: -6px;
      left: 0;
      right: 0;
      height: 3px;
      background-color: #0070ba;
      border-radius: 2px;
    }

    .dropdown-chevron {
      display: none;
    }

    /* Desktop dropdown */
    .dropdown-menu {
      position: absolute;
      top: 100%;
      left: 0;
      min-width: 15rem;
      background-color: var(--color-bg-page);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-md);
      list-style: none;
      padding: 0.5rem;
      display: none;
      flex-direction: column;
      gap: 0.25rem;
      z-index: 10;
    }

    .nav-item:hover .dropdown-menu,
    .nav-item:focus-within .dropdown-menu {
      display: flex;
    }

    .dropdown-link {
      display: block;
      padding: 0.5rem 0.75rem;
      font-size: 0.875rem;
      color: var(--color-text-secondary);
      border-radius: var(--radius-sm);
      transition: all var(--transition-fast);
    }

    .dropdown-link:hover,
    .dropdown-link.active {
      background-color: var(--color-bg-muted);
      color: #0070ba;
      font-weight: 500;
    }

    .btn-header-cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.375rem;
      min-height: 2.625rem;
      background-color: var(--color-brand-orange);
      color: var(--color-text-inverse);
      font-size: 0.875rem;
      font-weight: 600;
      padding: 0.5625rem 1.375rem;
      border-radius: var(--radius-full);
      transition: background-color var(--transition-fast), transform var(--transition-fast);
      box-shadow: 0 2px 8px rgba(249, 80, 22, 0.25);
      white-space: nowrap;
    }

    .btn-header-cta:hover {
      background-color: var(--color-brand-orange-hover);
      color: var(--color-text-inverse);
      transform: translateY(-1px);
    }

    .mobile-drawer-contact {
      display: none;
    }
  }
</style>
