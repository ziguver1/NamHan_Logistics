---
/**
 * Shared Admin Navigation Header Component
 * Unifies Admin Sections: Bảng tin & Kết nối Google Sheets.
 */
interface Props {
  activeTab: 'news' | 'google-sheets';
}

const { activeTab } = Astro.props;
---

<div class="admin-nav-bar">
  <div class="admin-nav-inner">
    <div class="admin-nav-brand">
      <span class="brand-badge">NAM HÂN LOGISTICS</span>
      <span class="portal-name">Quản trị Hệ thống</span>
    </div>

    <nav class="admin-tabs" aria-label="Điều hướng quản trị">
      <a
        href="/admin/"
        class={`admin-tab-link ${activeTab === 'news' ? 'is-active' : ''}`}
        aria-current={activeTab === 'news' ? 'page' : undefined}
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/>
          <path d="M18 14h-8"/>
          <path d="M15 18h-5"/>
          <path d="M10 6h8v4h-8V6Z"/>
        </svg>
        <span>Bảng tin</span>
      </a>

      <a
        href="/admin/google-sheets/"
        class={`admin-tab-link ${activeTab === 'google-sheets' ? 'is-active' : ''}`}
        aria-current={activeTab === 'google-sheets' ? 'page' : undefined}
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="18" height="18" x="3" y="3" rx="2"/>
          <line x1="3" x2="21" y1="9" y2="9"/>
          <line x1="3" x2="21" y1="15" y2="15"/>
          <line x1="9" x2="9" y1="3" y2="21"/>
          <line x1="15" x2="15" y1="3" y2="21"/>
        </svg>
        <span>Kết nối Google Sheets</span>
      </a>
    </nav>

    <div class="admin-nav-actions">
      <a href="/" target="_blank" rel="noopener noreferrer" class="btn-portal-action" title="Mở trang chủ website trong tab mới">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/>
          <line x1="2" x2="22" y1="12" y2="12"/>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
        </svg>
        <span class="desktop-only">Xem website</span>
      </a>

      <a href="/api/admin/logout" class="btn-portal-logout" title="Đăng xuất khỏi phiên quản trị">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
          <polyline points="16 17 21 12 16 7"/>
          <line x1="21" x2="9" y1="12" y2="12"/>
        </svg>
        <span>Đăng xuất</span>
      </a>
    </div>
  </div>
</div>

<style>
  .admin-nav-bar {
    background: #0f172a;
    color: #f8fafc;
    border-bottom: 1px solid #1e293b;
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .admin-nav-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
    gap: 1rem;
  }

  .admin-nav-brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .brand-badge {
    background: #f95016;
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 800;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }

  .portal-name {
    font-size: 0.95rem;
    font-weight: 700;
    color: #ffffff;
    display: none;
  }

  @media (min-width: 640px) {
    .portal-name {
      display: inline-block;
    }
  }

  .admin-tabs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .admin-tab-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.85rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: #94a3b8;
    text-decoration: none;
    border-radius: 6px;
    transition: all 0.15s ease;
  }

  .admin-tab-link:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.08);
  }

  .admin-tab-link.is-active {
    color: #ffffff;
    background: #1e293b;
    box-shadow: inset 0 -2px 0 #0284c7;
  }

  .admin-nav-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .btn-portal-action {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.75rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #cbd5e1;
    text-decoration: none;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 6px;
    border: 1px solid #334155;
    transition: all 0.15s ease;
  }

  .btn-portal-action:hover {
    color: #ffffff;
    border-color: #64748b;
    background: rgba(255, 255, 255, 0.1);
  }

  .btn-portal-logout {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.75rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #f87171;
    text-decoration: none;
    border-radius: 6px;
    transition: all 0.15s ease;
  }

  .btn-portal-logout:hover {
    background: rgba(239, 68, 68, 0.15);
    color: #fca5a5;
  }

  @media (max-width: 640px) {
    .desktop-only {
      display: none;
    }
  }
</style>

