---
/**
 * Unified Admin Login Form Component
 */
---

<div class="login-card">
  <div class="login-icon">
    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
      <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
    </svg>
  </div>
  <h2 class="login-title">Đăng nhập Quản trị viên</h2>
  <p class="login-subtitle">Vui lòng nhập mật khẩu quản trị để truy cập hệ thống quản trị Nam Hân Logistics.</p>

  <form id="adminLoginForm" class="login-form">
    <div class="form-group">
      <label for="adminPassword" class="form-label">Mật khẩu quản trị</label>
      <input
        type="password"
        id="adminPassword"
        name="password"
        class="form-input"
        placeholder="Nhập mật khẩu quản trị"
        required
        autocomplete="current-password"
      />
    </div>
    <div id="loginError" class="login-error-msg" style="display: none;"></div>
    <button type="submit" id="loginBtn" class="btn btn-primary btn-block">
      <span>Đăng nhập hệ thống</span>
    </button>
  </form>
  <div class="login-footer-note">
    <small>Phiên làm việc được bảo mật và xác thực bằng chữ ký mã hóa phía máy chủ.</small>
    <div style="margin-top: 1rem;">
      <a href="/" style="font-size: 0.8125rem; color: #64748b; text-decoration: none; transition: color 0.15s ease;" onmouseover="this.style.color='#0f172a'" onmouseout="this.style.color='#64748b'">&larr; Quay lại trang chủ website</a>
    </div>
  </div>
</div>

<style>
  .login-card {
    background: #ffffff;
    border-radius: 1rem;
    padding: 2.5rem;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.02);
    border: 1px solid #e2e8f0;
    max-width: 440px;
    margin: 3rem auto;
    text-align: center;
  }

  .login-icon {
    width: 64px;
    height: 64px;
    background: #eff6ff;
    color: #0284c7;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
  }

  .login-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: #1e293b;
    margin-bottom: 0.5rem;
  }

  .login-subtitle {
    font-size: 0.9rem;
    color: #64748b;
    margin-bottom: 1.5rem;
  }

  .login-form {
    text-align: left;
  }

  .form-group {
    margin-bottom: 1.25rem;
  }

  .form-label {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    color: #334155;
    margin-bottom: 0.5rem;
  }

  .form-input {
    width: 100%;
    padding: 0.75rem 1rem;
    font-size: 0.95rem;
    border: 1.5px solid #cbd5e1;
    border-radius: 0.5rem;
    outline: none;
    transition: border-color 0.2s;
  }

  .form-input:focus {
    border-color: #0284c7;
    box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.15);
  }

  .login-error-msg {
    color: #dc2626;
    font-size: 0.85rem;
    margin-bottom: 1rem;
    background: #fef2f2;
    padding: 0.5rem 0.75rem;
    border-radius: 0.375rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.25rem;
    font-size: 0.95rem;
    font-weight: 600;
    border-radius: 0.5rem;
    cursor: pointer;
    border: none;
    transition: all 0.2s;
  }

  .btn-primary {
    background-color: #0284c7;
    color: #ffffff;
  }
  .btn-primary:hover {
    background-color: #0369a1;
  }

  .btn-block {
    width: 100%;
  }

  .login-footer-note {
    margin-top: 1.5rem;
    color: #94a3b8;
    line-height: 1.4;
  }
</style>

<script>
  const loginForm = document.getElementById('adminLoginForm') as HTMLFormElement | null;
  const loginError = document.getElementById('loginError');
  const loginBtn = document.getElementById('loginBtn');

  if (loginForm) {
    loginForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (loginError) loginError.style.display = 'none';
      if (loginBtn) {
        loginBtn.setAttribute('disabled', 'true');
        loginBtn.textContent = 'Đang xác thực...';
      }

      const passwordInput = document.getElementById('adminPassword') as HTMLInputElement | null;
      const password = passwordInput?.value || '';

      try {
        const res = await fetch('/api/admin/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ password })
        });

        const data = await res.json();
        if (data.success) {
          window.location.reload();
        } else {
          if (loginError) {
            loginError.textContent = data.error || 'Mật khẩu không chính xác.';
            loginError.style.display = 'block';
          }
          if (loginBtn) {
            loginBtn.removeAttribute('disabled');
            loginBtn.textContent = 'Đăng nhập hệ thống';
          }
        }
      } catch {
        if (loginError) {
          loginError.textContent = 'Không thể kết nối với máy chủ.';
          loginError.style.display = 'block';
        }
        if (loginBtn) {
          loginBtn.removeAttribute('disabled');
          loginBtn.textContent = 'Đăng nhập hệ thống';
        }
      }
    });
  }
</script>

