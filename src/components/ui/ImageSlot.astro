---
interface Props {
  src?: string | null;
  alt?: string;
  label?: string;
  aspectRatio?: string;
  width?: string | number;
  height?: string | number;
  fit?: 'cover' | 'contain' | 'fill' | 'none';
  position?: string;
  class?: string;
  rounded?: 'none' | 'sm' | 'md' | 'lg' | 'xl' | 'full';
  loading?: 'lazy' | 'eager';
  priority?: boolean;
}

const {
  src = null,
  alt = '',
  label = 'IMAGE — PENDING',
  aspectRatio = '16/9',
  width = '100%',
  height = 'auto',
  fit = 'cover',
  position = 'center',
  class: className = '',
  rounded = 'md',
  loading = 'lazy',
  priority = false,
} = Astro.props;

const hasImage = Boolean(src && src.trim() !== '');

const radiusMap: Record<string, string> = {
  none: '0',
  sm: 'var(--radius-sm, 8px)',
  md: 'var(--radius-md, 12px)',
  lg: 'var(--radius-lg, 16px)',
  xl: 'var(--radius-xl, 24px)',
  full: 'var(--radius-full, 9999px)',
};

const borderRadius = radiusMap[rounded] ?? 'var(--radius-md, 12px)';
---

<div
  class={`image-slot-container ${className} ${hasImage ? 'has-image' : 'is-placeholder'}`}
  style={{
    '--slot-aspect-ratio': aspectRatio,
    '--slot-width': typeof width === 'number' ? `${width}px` : width,
    '--slot-height': typeof height === 'number' ? `${height}px` : height,
    '--slot-border-radius': borderRadius,
    '--slot-fit': fit,
    '--slot-position': position,
  }}
>
  {hasImage ? (
    <img
      src={src!}
      alt={alt}
      loading={priority ? 'eager' : loading}
      decoding="async"
      class="slot-image"
    />
  ) : (
    <div class="slot-placeholder" aria-hidden="true" role="presentation">
      <div class="placeholder-graphic">
        <svg
          class="placeholder-icon"
          width="32"
          height="32"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect width="18" height="18" x="3" y="3" rx="2" ry="2" />
          <circle cx="9" cy="9" r="2" />
          <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" />
        </svg>
        <span class="placeholder-label">{label}</span>
      </div>
    </div>
  )}
</div>

<style>
  .image-slot-container {
    width: var(--slot-width);
    height: var(--slot-height);
    aspect-ratio: var(--slot-aspect-ratio);
    border-radius: var(--slot-border-radius);
    overflow: hidden;
    position: relative;
    display: block;
    background-color: var(--color-bg-muted, #f8fafc);
  }

  /* When actual image is present */
  .slot-image {
    width: 100%;
    height: 100%;
    object-fit: var(--slot-fit);
    object-position: var(--slot-position);
    display: block;
    border-radius: inherit;
  }

  /* Placeholder state when src is null / empty */
  .slot-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
    border: 1px dashed var(--color-border-strong, #cbd5e1);
    border-radius: inherit;
    color: var(--color-text-muted, #64748b);
    user-select: none;
    box-sizing: border-box;
    padding: 1rem;
  }

  .placeholder-graphic {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    text-align: center;
  }

  .placeholder-icon {
    color: #94a3b8;
    opacity: 0.7;
  }

  .placeholder-label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #64748b;
    background-color: rgba(255, 255, 255, 0.75);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    border: 1px solid rgba(203, 213, 225, 0.6);
  }
</style>
