---
import { ROUTES } from '@/lib/routes';
import { servicesAssets } from '@/content/services-assets';
import ImageSlot from '@/components/ui/ImageSlot.astro';

const services = [
  {
    badge: '01 — Cốt lõi',
    isCore: true,
    title: 'Vận tải đường bộ',
    desc: 'Vận chuyển hàng hóa bằng xe ô tô, đáp ứng nhu cầu giao nhận và vận chuyển đường bộ.',
    image: servicesAssets.serviceRoad,
    href: ROUTES.SERVICE_ROAD,
    icon: 'truck',
  },
  {
    badge: '02',
    isCore: false,
    title: 'Logistics & Giao nhận',
    desc: 'Hỗ trợ điều phối, giao nhận và kết nối các hoạt động vận chuyển hàng hóa.',
    image: servicesAssets.serviceLogistics,
    href: ROUTES.SERVICE_LOGISTICS,
    icon: 'cube',
  },
  {
    badge: '03',
    isCore: false,
    title: 'Bốc xếp & Hỗ trợ vận tải',
    desc: 'Hỗ trợ các hoạt động bốc xếp, tập kết và xử lý hàng hóa.',
    image: servicesAssets.serviceHandling,
    href: ROUTES.SERVICE_HANDLING,
    icon: 'handling',
  },
  {
    badge: '04',
    isCore: false,
    title: 'Giải pháp vận tải',
    desc: 'Tư vấn phương án vận chuyển phù hợp với đặc điểm hàng hóa và nhu cầu khách hàng.',
    image: servicesAssets.serviceSolutions,
    href: ROUTES.SERVICE_SOLUTIONS,
    icon: 'solutions',
  },
];
---

<section class="services-grid-section" aria-label="Danh mục 4 dịch vụ chính">
  <div class="container">
    <!-- Section Header -->
    <div class="section-header">
      <h2 class="section-title">Giải pháp vận tải của Nam Hân</h2>
      <p class="section-desc">
        Nam Hân tập trung toàn diện vào năng lực vận tải hàng hóa đường bộ, cung cấp các phương án vận chuyển linh hoạt với các loại phương tiện chuyên dụng, phục vụ giao nhận hàng hóa chuẩn xác và an toàn.
      </p>
    </div>

    <!-- 2x2 Services Grid -->
    <div class="services-cards-grid">
      {services.map((item) => (
        <article class="service-card">
          <div class="card-media">
            <ImageSlot
              src={item.image?.src}
              alt={item.image?.alt}
              label={item.image?.label}
              aspectRatio="16/10"
              rounded="none"
              class="service-slot"
            />
            <span class={`card-badge ${item.isCore ? 'badge-core' : ''}`}>
              {item.badge}
            </span>
          </div>

          <div class="card-body">
            <div class="card-title-row">
              <div class="service-icon" aria-hidden="true">
                {item.icon === 'truck' && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="1" y="3" width="15" height="13" rx="1"/>
                    <polygon points="16 8 20 8 23 11 23 16 16 16 8"/>
                    <circle cx="5.5" cy="18.5" r="2.5"/>
                    <circle cx="18.5" cy="18.5" r="2.5"/>
                  </svg>
                )}
                {item.icon === 'cube' && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/>
                    <path d="m3.3 7 8.7 5 8.7-5"/>
                    <path d="M12 22V12"/>
                  </svg>
                )}
                {item.icon === 'handling' && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/>
                    <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
                  </svg>
                )}
                {item.icon === 'solutions' && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="6" cy="19" r="3"/>
                    <path d="M9 19h8.5a3.5 3.5 0 0 0 0-7h-11a3.5 3.5 0 0 1 0-7H15"/>
                    <circle cx="18" cy="5" r="3"/>
                  </svg>
                )}
              </div>
              <h3 class="service-name">{item.title}</h3>
            </div>

            <p class="service-desc">{item.desc}</p>

            <a href={item.href} class="service-link">
              <span>Xem chi tiết</span>
              <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4.167 10h11.666m-4.166-4.167L15.833 10l-4.166 4.167"/>
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services-grid-section {
    padding-top: var(--section-space);
    padding-bottom: var(--section-space);
    background-color: var(--color-bg-page);
  }

  .section-header {
    max-width: 50rem;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .section-title {
    font-size: clamp(1.875rem, 2.5vw + 1rem, 2.75rem);
    font-weight: 800;
    color: var(--color-brand-navy);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .section-desc {
    font-size: clamp(0.9375rem, 1.1vw, 1.0625rem);
    color: var(--color-text-secondary);
    line-height: 1.65;
  }

  .services-cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .services-cards-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.25rem;
    }
  }

  .service-card {
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.03);
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast), border-color var(--transition-fast);
  }

  .service-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 25px -4px rgba(0, 0, 0, 0.08);
    border-color: #fed7aa;
  }

  .card-media {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .card-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background-color: rgba(11, 25, 44, 0.9);
    backdrop-filter: blur(4px);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.3125rem 0.75rem;
    border-radius: var(--radius-sm);
    letter-spacing: 0.03em;
    z-index: 2;
  }

  .card-badge.badge-core {
    background-color: var(--color-brand-navy);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .card-body {
    padding: clamp(1.5rem, 3vw, 2rem);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: 1rem;
  }

  .card-title-row {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }

  .service-icon {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-md);
    background-color: #e0f2fe;
    color: #0284c7;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .service-name {
    font-size: clamp(1.125rem, 1.5vw + 0.5rem, 1.375rem);
    font-weight: 800;
    color: var(--color-brand-navy);
    line-height: 1.3;
  }

  .service-desc {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 0.5rem;
  }

  .service-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-brand-navy);
    font-weight: 700;
    font-size: 0.9375rem;
    text-decoration: none;
    margin-top: auto;
    transition: color var(--transition-fast), transform var(--transition-fast);
    align-self: flex-start;
  }

  .service-link svg {
    transition: transform var(--transition-fast);
  }

  .service-card:hover .service-link {
    color: var(--color-brand-orange);
  }

  .service-card:hover .service-link svg {
    transform: translateX(4px);
  }
</style>
