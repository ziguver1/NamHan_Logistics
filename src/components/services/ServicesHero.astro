---
import { ROUTES } from '@/lib/routes';
import { servicesAssets } from '@/content/services-assets';

const heroImage = servicesAssets.hero;
---

<section class="services-hero-section" aria-label="Giới thiệu dịch vụ Nam Hân">
  <!-- Background Image & Overlay -->
  {heroImage?.src && (
    <div class="hero-bg-image" style={{ backgroundImage: `url(${heroImage.src})` }} aria-hidden="true"></div>
  )}
  <div class="hero-overlay" aria-hidden="true"></div>

  <div class="container hero-container">
    <!-- Breadcrumbs -->
    <nav class="hero-breadcrumbs" aria-label="Breadcrumb">
      <ol class="breadcrumb-list">
        <li><a href={ROUTES.HOME} class="breadcrumb-link">Trang chủ</a></li>
        <li class="breadcrumb-sep" aria-hidden="true">→</li>
        <li class="breadcrumb-current" aria-current="page">Dịch vụ</li>
      </ol>
    </nav>

    <!-- Badge -->
    <div class="hero-badge">
      <span class="badge-dot" aria-hidden="true"></span>
      <span>HỆ THỐNG DỊCH VỤ ĐƯỜNG BỘ</span>
    </div>

    <!-- H1 Title -->
    <h1 class="hero-title">Dịch vụ vận tải & Logistics</h1>

    <!-- Subtitle -->
    <p class="hero-desc">
      Giải pháp vận chuyển hàng hóa đường bộ linh hoạt, phù hợp với nhu cầu giao nhận của khách hàng.
    </p>

    <!-- 3 Core Highlights -->
    <div class="hero-highlights">
      <div class="highlight-item">
        <svg class="check-icon" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="4 11 8 15 16 6"/>
        </svg>
        <span>Vận tải hàng hóa bằng xe ô tô</span>
      </div>

      <div class="highlight-item">
        <svg class="check-icon" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="4 11 8 15 16 6"/>
        </svg>
        <span>Đầu kéo container, xe tải, xe ben</span>
      </div>

      <div class="highlight-item">
        <svg class="check-icon" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="4 11 8 15 16 6"/>
        </svg>
        <span>Bốc xếp & điều phối linh hoạt</span>
      </div>
    </div>
  </div>
</section>

<style>
  .services-hero-section {
    position: relative;
    background: linear-gradient(135deg, #07172b 0%, #0d2847 50%, #1e3a5f 100%);
    padding-top: clamp(2.5rem, 5vw, 4rem);
    padding-bottom: clamp(3rem, 6vw, 4.5rem);
    overflow: hidden;
    color: #ffffff;
  }

  .hero-bg-image {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center right;
    opacity: 0.35;
    z-index: 0;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(7, 23, 43, 0.95) 0%, rgba(13, 40, 71, 0.8) 60%, rgba(30, 58, 95, 0.6) 100%);
    z-index: 1;
  }

  .hero-container {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  /* Breadcrumbs */
  .hero-breadcrumbs {
    margin-bottom: 0.25rem;
  }

  .breadcrumb-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
  }

  .breadcrumb-link {
    color: #94a3b8;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .breadcrumb-link:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  .breadcrumb-sep {
    color: #64748b;
    font-size: 0.75rem;
  }

  .breadcrumb-current {
    color: #ffffff;
    font-weight: 600;
  }

  /* Badge */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    align-self: flex-start;
    padding: 0.375rem 0.875rem;
    background-color: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #ffffff;
    backdrop-filter: blur(4px);
  }

  .badge-dot {
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: var(--radius-full);
    background-color: var(--color-brand-orange);
  }

  /* H1 Title */
  .hero-title {
    font-size: clamp(2rem, 3.5vw + 1rem, 3.5rem);
    font-weight: 900;
    line-height: 1.15;
    color: #ffffff;
    letter-spacing: -0.025em;
    margin-top: 0.25rem;
  }

  /* Subtitle */
  .hero-desc {
    font-size: clamp(1rem, 1.2vw, 1.125rem);
    color: #cbd5e1;
    line-height: 1.6;
    max-width: 44rem;
  }

  /* 3 Highlights */
  .hero-highlights {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    margin-top: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  @media (min-width: 768px) {
    .hero-highlights {
      flex-direction: row;
      align-items: center;
      gap: 2rem;
    }
  }

  .highlight-item {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: #f1f5f9;
  }

  .check-icon {
    color: #34d399;
    flex-shrink: 0;
  }
</style>
