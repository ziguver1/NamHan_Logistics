---
import { ROUTES } from '@/lib/routes';
import { logisticsAssets } from '@/content/logistics-assets';

const heroBg = logisticsAssets.heroBg;

const stats = [
  {
    label: 'ĐỘ CHÍNH XÁC LỊCH TRÌNH',
    value: '99.4%',
    sub: 'Biên độ giao hàng chuẩn',
    iconType: 'check',
  },
  {
    label: 'ĐỘI XE TRUNG CHUYỂN',
    value: '120+ Xe',
    sub: 'Tải trọng 1.5T - 15T & Đầu kéo',
    iconType: 'truck',
  },
  {
    label: 'DEPOT LIÊN KẾT',
    value: '04 Trục',
    sub: 'Bắc - Trung - Đông Nam Bộ',
    iconType: 'network',
  },
  {
    label: 'THỜI GIAN PHẢN HỒI',
    value: '< 15 Phút',
    sub: 'Điều phối viên thường trực',
    iconType: 'headset',
  },
];
---

<section class="logistics-hero-section" aria-labelledby="logistics-hero-heading">
  <!-- Top Breadcrumbs -->
  <div class="breadcrumb-bar">
    <div class="container">
      <nav class="breadcrumb-nav" aria-label="Đường dẫn điều hướng">
        <ol class="breadcrumb-list">
          <li class="breadcrumb-item">
            <a href={ROUTES.HOME} class="breadcrumb-link">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                <polyline points="9 22 9 12 15 12 15 22"/>
              </svg>
              <span>Trang chủ</span>
            </a>
          </li>
          <li class="breadcrumb-separator" aria-hidden="true">›</li>
          <li class="breadcrumb-item">
            <a href={ROUTES.SERVICES} class="breadcrumb-link">Dịch vụ</a>
          </li>
          <li class="breadcrumb-separator" aria-hidden="true">›</li>
          <li class="breadcrumb-item is-current" aria-current="page">LOGISTICS & GIAO NHẬN</li>
        </ol>
      </nav>
    </div>
  </div>

  <!-- Hero Main Banner -->
  <div class="hero-banner-wrap" style={heroBg.src ? { backgroundImage: `url('${heroBg.src}')` } : undefined}>
    <div class="hero-bg-overlay" aria-hidden="true"></div>

    <div class="container hero-content-container">
      <div class="hero-content">
        <div class="service-tag">
          <span class="badge-dot" aria-hidden="true">●</span>
          <span>DỊCH VỤ TRỌNG TÂM #02</span>
        </div>

        <h1 id="logistics-hero-heading" class="hero-title">
          Logistics & Giao nhận
        </h1>

        <p class="hero-desc">
          Giải pháp điều phối, giao nhận và hỗ trợ vận chuyển hàng hóa phù hợp với nhu cầu của khách hàng. Đồng hành cùng hệ thống kho bãi hiện đại và đội xe tải phủ khắp các trung tâm kinh tế.
        </p>

        <div class="hero-actions">
          <a href={ROUTES.CONTACT} class="btn-primary">
            <span>Liên hệ Nam Hân</span>
            <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4.167 10h11.666m-4.166-4.167L15.833 10l-4.166 4.167"/>
            </svg>
          </a>

          <a href="#route-inquiry" class="btn-secondary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
              <line x1="16" y1="13" x2="8" y2="13"/>
              <line x1="16" y1="17" x2="8" y2="17"/>
              <polyline points="10 9 9 9 8 9"/>
            </svg>
            <span>Yêu cầu báo giá</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Stats Strip -->
    <div class="hero-stats-strip">
      <div class="container">
        <div class="stats-grid">
          {
            stats.map((stat) => (
              <div class="stat-col">
                <span class="stat-label">{stat.label}</span>
                <div class="stat-value">{stat.value}</div>
                <div class="stat-sub">
                  {stat.iconType === 'check' && (
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polyline points="20 6 9 17 4 12"/>
                    </svg>
                  )}
                  {stat.iconType === 'truck' && (
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect x="1" y="3" width="15" height="13"/>
                      <polygon points="16 8 20 8 23 11 23 16 16 16 8"/>
                      <circle cx="5.5" cy="18.5" r="2.5"/>
                      <circle cx="18.5" cy="18.5" r="2.5"/>
                    </svg>
                  )}
                  {stat.iconType === 'network' && (
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="12" cy="12" r="10"/>
                      <line x1="2" y1="12" x2="22" y2="12"/>
                      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                    </svg>
                  )}
                  {stat.iconType === 'headset' && (
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M3 18v-6a9 9 0 0 1 18 0v6"/>
                      <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/>
                    </svg>
                  )}
                  <span>{stat.sub}</span>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .logistics-hero-section {
    background-color: #f8fafc;
  }

  .breadcrumb-bar {
    padding-top: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
    background-color: #f8fafc;
  }

  .breadcrumb-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.875rem;
  }

  .breadcrumb-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .breadcrumb-link:hover {
    color: var(--color-brand-orange);
  }

  .breadcrumb-separator {
    color: var(--color-border-strong);
    user-select: none;
  }

  .breadcrumb-item.is-current {
    color: var(--color-brand-orange);
    font-weight: 700;
  }

  /* Main Banner Wrap */
  .hero-banner-wrap {
    position: relative;
    background-color: #0b192c;
    background-image: radial-gradient(circle at 80% 30%, rgba(30, 58, 138, 0.4) 0%, rgba(11, 25, 44, 0.95) 70%);
    color: #ffffff;
    overflow: hidden;
  }

  .hero-bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(11, 25, 44, 0.96) 30%, rgba(11, 25, 44, 0.75) 100%);
    pointer-events: none;
  }

  .hero-content-container {
    position: relative;
    z-index: 2;
    padding-top: clamp(3rem, 6vw, 4.5rem);
    padding-bottom: clamp(3rem, 5vw, 4rem);
  }

  .hero-content {
    max-width: 44rem;
  }

  .service-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 0.375rem 0.875rem;
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #e2e8f0;
    margin-bottom: 1.5rem;
  }

  .badge-dot {
    color: var(--color-brand-orange);
  }

  .hero-title {
    font-size: clamp(2.25rem, 4vw + 0.5rem, 3.5rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 1.25rem;
  }

  .hero-desc {
    font-size: 1.0625rem;
    color: #cbd5e1;
    line-height: 1.65;
    margin-bottom: 2.25rem;
    max-width: 38rem;
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media (min-width: 500px) {
    .hero-actions {
      flex-direction: row;
      align-items: center;
    }
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: var(--touch-target-min, 44px);
    background-color: var(--color-brand-orange);
    color: #ffffff;
    font-weight: 700;
    font-size: 0.9375rem;
    padding: 0.875rem 1.75rem;
    border-radius: var(--radius-md);
    box-shadow: 0 4px 14px rgba(249, 80, 22, 0.35);
    transition: all var(--transition-fast);
    text-decoration: none;
  }

  .btn-primary:hover {
    background-color: var(--color-brand-orange-hover);
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(249, 80, 22, 0.45);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: var(--touch-target-min, 44px);
    background-color: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.2);
    font-weight: 700;
    font-size: 0.9375rem;
    padding: 0.875rem 1.75rem;
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
    text-decoration: none;
  }

  .btn-secondary:hover {
    background-color: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.35);
  }

  /* Bottom Stats Strip */
  .hero-stats-strip {
    position: relative;
    z-index: 2;
    background-color: rgba(7, 18, 33, 0.85);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(8px);
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .stats-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 2rem;
    }
  }

  .stat-col {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .stat-label {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #94a3b8;
    text-transform: uppercase;
  }

  .stat-value {
    font-size: clamp(1.875rem, 2.5vw, 2.25rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .stat-sub {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.75rem;
    color: #cbd5e1;
    margin-top: 0.25rem;
  }

  .stat-sub svg {
    color: #38bdf8;
    flex-shrink: 0;
  }
</style>
