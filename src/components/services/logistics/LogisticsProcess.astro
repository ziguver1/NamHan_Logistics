---
interface ProcessStep {
  step: string;
  title: string;
  desc: string;
  statusText: string;
  isHighlight?: boolean;
  iconType: 'cloud' | 'calc' | 'truck' | 'shield';
}

const steps: ProcessStep[] = [
  {
    step: '01',
    title: 'Tiếp nhận yêu cầu',
    desc: 'Ghi nhận thông tin chi tiết về loại hàng, khối lượng, quy cách đóng gói và khung thời gian giao nhận mong muốn của khách hàng.',
    statusText: 'Tiếp nhận trong 5-10 phút',
    iconType: 'cloud',
  },
  {
    step: '02',
    title: 'Tư vấn phương án',
    desc: 'Lựa chọn hình thức gom ghép pallet, phân loại tải trọng xe tải thích hợp và tối ưu lộ trình vận chuyển tiết kiệm ngân sách nhất.',
    statusText: 'Báo giá trọn gói minh bạch',
    iconType: 'calc',
  },
  {
    step: '03',
    title: 'Điều phối vận chuyển',
    desc: 'Đưa xe tải vào bến bãi kho, bốc dỡ đúng kỹ thuật, kiểm tra niêm phong kẹp chì và vận hành chuyển phát theo định tuyến đã định.',
    statusText: 'Giám sát GPS hành trình',
    iconType: 'truck',
  },
  {
    step: '04',
    title: 'Giao nhận & bàn giao',
    desc: 'Bàn giao hàng tận nơi nguyên vẹn, đồng kiểm số lượng pallet tại bãi nhận và ký xác nhận chứng từ giao hàng (POD) ngay tại chỗ.',
    statusText: 'Bàn giao chứng từ đầy đủ',
    isHighlight: true,
    iconType: 'shield',
  },
];
---

<section class="logistics-process-section" aria-labelledby="logistics-process-heading">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">QUY CHUẨN 4 BƯỚC KHÉP KÍN</span>
      <h2 id="logistics-process-heading" class="section-title">Quy trình giao nhận</h2>
      <p class="section-desc">
        Kiểm soát chặt chẽ từng điểm chạm từ tiếp nhận yêu cầu tới khi hoàn thành bàn giao chứng từ thực địa.
      </p>
    </div>

    <div class="process-grid">
      {
        steps.map((item) => (
          <div class="process-card">
            <div class="card-head">
              <span class={`step-badge ${item.isHighlight ? 'badge-highlight' : 'badge-navy'}`}>
                {item.step}
              </span>

              <div class="step-icon" aria-hidden="true">
                {item.iconType === 'cloud' && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/>
                  </svg>
                )}
                {item.iconType === 'calc' && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                    <line x1="3" y1="9" x2="21" y2="9"/>
                    <line x1="9" y1="21" x2="9" y2="9"/>
                  </svg>
                )}
                {item.iconType === 'truck' && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="1" y="3" width="15" height="13"/>
                    <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
                    <circle cx="5.5" cy="18.5" r="2.5"/>
                    <circle cx="18.5" cy="18.5" r="2.5"/>
                  </svg>
                )}
                {item.iconType === 'shield' && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    <polyline points="9 12 11 14 15 10"/>
                  </svg>
                )}
              </div>
            </div>

            <h3 class="card-title">{item.title}</h3>
            <p class="card-desc">{item.desc}</p>

            <div class="card-status-row">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
              </svg>
              <span>{item.statusText}</span>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .logistics-process-section {
    padding-top: clamp(3rem, 6vw, 4.5rem);
    padding-bottom: clamp(3rem, 6vw, 4.5rem);
    background-color: #ffffff;
    border-top: 1px solid var(--color-border);
  }

  .section-header {
    text-align: center;
    max-width: 44rem;
    margin-inline: auto;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .section-tag {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-brand-orange);
    margin-bottom: 0.625rem;
  }

  .section-title {
    font-size: clamp(1.75rem, 2.5vw + 0.5rem, 2.375rem);
    font-weight: 800;
    color: var(--color-brand-navy);
    line-height: 1.25;
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
  }

  .section-desc {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .process-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .process-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .process-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }
  }

  .process-card {
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg, 16px);
    padding: 1.75rem 1.5rem;
    display: flex;
    flex-direction: column;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.03);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .process-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
    border-color: rgba(249, 80, 22, 0.3);
  }

  .card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .step-badge {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.875rem;
    font-weight: 800;
  }

  .badge-navy {
    background-color: var(--color-brand-navy);
    color: #ffffff;
  }

  .badge-highlight {
    background-color: var(--color-brand-orange);
    color: #ffffff;
    box-shadow: 0 4px 10px rgba(249, 80, 22, 0.3);
  }

  .step-icon {
    color: var(--color-brand-orange);
  }

  .card-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-brand-navy);
    line-height: 1.35;
    margin-bottom: 0.625rem;
  }

  .card-desc {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
    flex-grow: 1;
    margin-bottom: 1.25rem;
  }

  .card-status-row {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-brand-orange);
    padding-top: 0.875rem;
    border-top: 1px dashed var(--color-border);
  }

  .card-status-row svg {
    flex-shrink: 0;
  }
</style>
