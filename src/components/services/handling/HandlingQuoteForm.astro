---
/**
 * Handling Quick Quote Form (Figma Node 84:1470)
 * Lead Point 2: Handling & Transport Support Quote
 * Compliance: Phase 1 Demo indicator + Progressive client validation
 */
---

<section id="quote-form" class="handling-quote-section" aria-labelledby="handling-quote-heading">
  <div class="container">
    <div class="quote-card">
      <div class="card-header">
        <span class="section-tag">ƯỚC TÍNH CHI PHÍ</span>
        <h2 id="handling-quote-heading" class="section-title">
          Yêu cầu báo giá bốc xếp & tập kết hàng
        </h2>
        <p class="section-desc">
          Điền thông tin kiện hàng để đội ngũ điều vận Nam Hân lên phương án phương tiện và nhân công tối ưu.
        </p>
      </div>

      <form id="handlingQuoteForm" class="quote-form" novalidate>
        <div class="form-grid">
          <!-- Field 1: Tên doanh nghiệp / Người gửi -->
          <div class="form-group">
            <label for="companyName" class="form-label">Tên doanh nghiệp / Người gửi <span class="required">*</span></label>
            <input
              type="text"
              id="companyName"
              name="companyName"
              class="form-input"
              placeholder="VD: Công ty TNHH Hóa Chất Nam Việt"
              required
            />
            <span class="field-error" id="companyNameError" aria-live="polite"></span>
          </div>

          <!-- Field 2: Số điện thoại liên hệ -->
          <div class="form-group">
            <label for="contactPhone" class="form-label">Số điện thoại liên hệ <span class="required">*</span></label>
            <input
              type="tel"
              id="contactPhone"
              name="contactPhone"
              class="form-input"
              placeholder="VD: 0988 123 456"
              pattern="[0-9]{10,11}"
              required
            />
            <span class="field-error" id="contactPhoneError" aria-live="polite"></span>
          </div>

          <!-- Field 3: Địa điểm bốc xếp / Tập kết -->
          <div class="form-group">
            <label for="handlingLocation" class="form-label">Địa điểm bốc xếp / Tập kết <span class="required">*</span></label>
            <input
              type="text"
              id="handlingLocation"
              name="handlingLocation"
              class="form-input"
              placeholder="VD: KCN Sóng Thần 1, Dĩ An"
              required
            />
            <span class="field-error" id="handlingLocationError" aria-live="polite"></span>
          </div>

          <!-- Field 4: Loại hàng & Quy cách -->
          <div class="form-group">
            <label for="cargoSpec" class="form-label">Loại hàng & Quy cách <span class="required">*</span></label>
            <input
              type="text"
              id="cargoSpec"
              name="cargoSpec"
              class="form-input"
              placeholder="VD: 40 Pallet hàng tiêu dùng đóng thùng"
              required
            />
            <span class="field-error" id="cargoSpecError" aria-live="polite"></span>
          </div>

          <!-- Field 5: Nhu cầu cơ giới -->
          <div class="form-group">
            <label for="equipmentNeed" class="form-label">Nhu cầu cơ giới</label>
            <div class="select-wrapper">
              <select id="equipmentNeed" name="equipmentNeed" class="form-select">
                <option value="forklift" selected>Xe nâng máy (Forklift)</option>
                <option value="crane">Xe cẩu tự hành</option>
                <option value="hydraulic">Bàn nâng thủy lực</option>
                <option value="manual">Bốc xếp thủ công & phụ xe</option>
                <option value="all-in-one">Kết hợp trọn gói (Cơ giới + Thủ công)</option>
              </select>
              <svg class="select-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="6 9 12 15 18 9"/>
              </svg>
            </div>
          </div>

          <!-- Submit Action -->
          <div class="form-group submit-group">
            <button type="submit" class="btn-submit" id="submitQuoteBtn">
              <span>Gửi yêu cầu điều phối</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true">
                <polygon points="5 3 19 12 5 21 5 3"/>
              </svg>
            </button>
          </div>
        </div>

        <!-- Phase 1 Demo Notice Banner -->
        <div id="formDemoStatus" class="form-status-banner" role="status" aria-live="polite">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="8" x2="12" y2="12"/>
            <line x1="12" y1="16" x2="12.01" y2="16"/>
          </svg>
          <div class="status-content">
            <strong>Ghi nhận thông tin (Giao diện xem trước Phase 1):</strong>
            <span>Hệ thống tiếp nhận tự động đang kết nối hạ tầng. Vui lòng liên hệ trực tiếp Hotline <strong>1900 6868</strong> để được hỗ trợ báo giá và điều xe ngay.</span>
          </div>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  // Progressive Client Validation & Demo Feedback
  const form = document.getElementById('handlingQuoteForm') as HTMLFormElement | null;
  const statusBanner = document.getElementById('formDemoStatus');

  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      let isValid = true;

      // Validate companyName
      const companyInput = form.querySelector('#companyName') as HTMLInputElement | null;
      const companyError = form.querySelector('#companyNameError');
      if (companyInput && companyError) {
        if (!companyInput.value.trim()) {
          companyError.textContent = 'Vui lòng nhập tên doanh nghiệp hoặc người gửi';
          companyInput.setAttribute('aria-invalid', 'true');
          isValid = false;
        } else {
          companyError.textContent = '';
          companyInput.removeAttribute('aria-invalid');
        }
      }

      // Validate phone
      const phoneInput = form.querySelector('#contactPhone') as HTMLInputElement | null;
      const phoneError = form.querySelector('#contactPhoneError');
      if (phoneInput && phoneError) {
        const phoneRegex = /^[0-9]{9,11}$/;
        if (!phoneRegex.test(phoneInput.value.replace(/[\s.-]/g, ''))) {
          phoneError.textContent = 'Vui lòng nhập số điện thoại hợp lệ (9 - 11 chữ số)';
          phoneInput.setAttribute('aria-invalid', 'true');
          isValid = false;
        } else {
          phoneError.textContent = '';
          phoneInput.removeAttribute('aria-invalid');
        }
      }

      // Validate location
      const locInput = form.querySelector('#handlingLocation') as HTMLInputElement | null;
      const locError = form.querySelector('#handlingLocationError');
      if (locInput && locError) {
        if (!locInput.value.trim()) {
          locError.textContent = 'Vui lòng nhập địa điểm bốc xếp hoặc tập kết';
          locInput.setAttribute('aria-invalid', 'true');
          isValid = false;
        } else {
          locError.textContent = '';
          locInput.removeAttribute('aria-invalid');
        }
      }

      // Validate cargo spec
      const cargoInput = form.querySelector('#cargoSpec') as HTMLInputElement | null;
      const cargoError = form.querySelector('#cargoSpecError');
      if (cargoInput && cargoError) {
        if (!cargoInput.value.trim()) {
          cargoError.textContent = 'Vui lòng nhập quy cách hoặc loại hàng hóa';
          cargoInput.setAttribute('aria-invalid', 'true');
          isValid = false;
        } else {
          cargoError.textContent = '';
          cargoInput.removeAttribute('aria-invalid');
        }
      }

      if (isValid && statusBanner) {
        statusBanner.classList.add('is-visible');
        statusBanner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    });
  }
</script>

<style>
  .handling-quote-section {
    padding-top: clamp(2rem, 4vw, 3.5rem);
    padding-bottom: clamp(3rem, 6vw, 4.5rem);
    background-color: #f8fafc;
    border-top: 1px solid var(--color-border);
  }

  .quote-card {
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg, 16px);
    padding: clamp(2rem, 4vw, 3rem) clamp(1.5rem, 4vw, 3rem);
    box-shadow: 0 4px 20px rgba(11, 25, 44, 0.05);
  }

  .card-header {
    margin-bottom: 2rem;
  }

  .section-tag {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-brand-orange);
    margin-bottom: 0.5rem;
  }

  .section-title {
    font-size: clamp(1.625rem, 2.5vw + 0.25rem, 2.125rem);
    font-weight: 800;
    color: var(--color-brand-navy);
    line-height: 1.25;
    letter-spacing: -0.02em;
    margin-bottom: 0.625rem;
  }

  .section-desc {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    max-width: 44rem;
  }

  /* Form Layout */
  .form-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 768px) {
    .form-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem 1.5rem;
    }

    .submit-group {
      display: flex;
      align-items: flex-end;
    }
  }

  .form-group {
    display: flex;
    flex-direction: column;
  }

  .form-label {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-brand-navy);
    margin-bottom: 0.5rem;
  }

  .required {
    color: var(--color-brand-orange);
  }

  .form-input,
  .form-select {
    width: 100%;
    min-height: var(--touch-target-min, 44px);
    padding: 0.625rem 1rem;
    font-size: 0.875rem;
    color: var(--color-brand-navy);
    background-color: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
    outline: none;
    font-family: inherit;
  }

  .form-input::placeholder {
    color: #94a3b8;
  }

  .form-input:focus,
  .form-select:focus {
    border-color: var(--color-brand-orange);
    background-color: #ffffff;
    box-shadow: 0 0 0 3px rgba(249, 80, 22, 0.12);
  }

  .form-input[aria-invalid="true"] {
    border-color: #ef4444;
    background-color: #fef2f2;
  }

  .field-error {
    font-size: 0.75rem;
    color: #dc2626;
    margin-top: 0.375rem;
    min-height: 1rem;
  }

  .select-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .form-select {
    appearance: none;
    padding-right: 2.25rem;
    cursor: pointer;
  }

  .select-chevron {
    position: absolute;
    right: 0.875rem;
    pointer-events: none;
    color: #64748b;
  }

  .btn-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    min-height: var(--touch-target-min, 44px);
    background-color: var(--color-brand-orange);
    color: #ffffff;
    font-weight: 700;
    font-size: 0.9375rem;
    padding: 0.75rem 1.5rem;
    border: none;
    border-radius: var(--radius-md);
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(249, 80, 22, 0.3);
    transition: all var(--transition-fast);
  }

  .btn-submit:hover {
    background-color: var(--color-brand-orange-hover);
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(249, 80, 22, 0.4);
  }

  /* Demo status banner */
  .form-status-banner {
    display: none;
    margin-top: 1.5rem;
    padding: 1rem 1.25rem;
    background-color: #eff6ff;
    border: 1px solid #bfdbfe;
    border-radius: var(--radius-md);
    color: #1e40af;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .form-status-banner.is-visible {
    display: flex;
  }

  .form-status-banner svg {
    color: #2563eb;
    flex-shrink: 0;
    margin-top: 0.125rem;
  }

  .status-content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
</style>
