---
import { ROUTES } from '@/lib/routes';
---

<section class="handling-cta-section" aria-label="Tổng đài điều phối kho vận 24/7">
  <div class="container">
    <div class="cta-banner">
      <!-- Main Content & Actions -->
      <div class="banner-main-row">
        <div class="banner-left">
          <span class="cta-tag">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 18v-6a9 9 0 0 1 18 0v6"/>
              <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/>
            </svg>
            <span>TỔNG ĐÀI ĐIỀU PHỐI KHO VẬN 24/7</span>
          </span>

          <h2 class="cta-title">
            Bạn cần hỗ trợ vận chuyển<br />
            hàng hóa?
          </h2>

          <p class="cta-desc">
            Liên hệ Nam Hân Logistics để được hỗ trợ bốc xếp và vận tải an toàn nhất. Đội ngũ cơ giới và nhân sự hiện trường luôn trong tư thế sẵn sàng triển khai tại mọi kho hàng.
          </p>
        </div>

        <div class="banner-actions">
          <a href={ROUTES.CONTACT} class="btn-primary">
            <span>Liên hệ Nam Hân</span>
            <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4.167 10h11.666m-4.166-4.167L15.833 10l-4.166 4.167"/>
            </svg>
          </a>

          <a href={ROUTES.ABOUT} class="btn-facilities">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 21h18"/>
              <path d="M5 21V7l8-4v18"/>
              <path d="M19 21V11l-6-4"/>
              <path d="M9 9h1"/>
              <path d="M9 13h1"/>
              <path d="M9 17h1"/>
            </svg>
            <span>Hệ thống kho bãi</span>
          </a>
        </div>
      </div>

      <!-- Divider -->
      <div class="banner-divider" aria-hidden="true"></div>

      <!-- Bottom 4 Trust Stats -->
      <div class="banner-stats-row">
        <div class="stat-item">
          <div class="stat-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
          </div>
          <div class="stat-text">
            <span class="stat-label">HOTLINE TRUNG TÂM</span>
            <a href="tel:19006868" class="stat-value hotline-link">1900 6868</a>
          </div>
        </div>

        <div class="stat-item">
          <div class="stat-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
              <polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
          </div>
          <div class="stat-text">
            <span class="stat-label">KHO BÃI LIÊN KẾT</span>
            <span class="stat-value">Bắc - Trung - Nam</span>
          </div>
        </div>

        <div class="stat-item">
          <div class="stat-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
          </div>
          <div class="stat-text">
            <span class="stat-label">THỜI GIAN ĐÁP ỨNG</span>
            <span class="stat-value">Dưới 30 phút</span>
          </div>
        </div>

        <div class="stat-item">
          <div class="stat-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <polyline points="9 12 11 14 15 10"/>
            </svg>
          </div>
          <div class="stat-text">
            <span class="stat-label">BẢO HIỂM HÀNG HÓA</span>
            <span class="stat-value">100% Giá trị kiện</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .handling-cta-section {
    padding-top: clamp(2rem, 4vw, 3.5rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
    background-color: #f8fafc;
  }

  .cta-banner {
    background-color: #0b1e36;
    border-radius: var(--radius-xl, 20px);
    padding: clamp(2.5rem, 5vw, 3.5rem) clamp(1.75rem, 4vw, 3.5rem);
    box-shadow: 0 16px 40px rgba(11, 30, 54, 0.2);
  }

  .banner-main-row {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  @media (min-width: 900px) {
    .banner-main-row {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .banner-left {
    max-width: 40rem;
  }

  .cta-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fb923c;
    margin-bottom: 0.875rem;
  }

  .cta-title {
    font-size: clamp(1.875rem, 3vw, 2.5rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.25;
    letter-spacing: -0.02em;
    margin-bottom: 0.875rem;
  }

  .cta-desc {
    font-size: 1rem;
    color: #94a3b8;
    line-height: 1.6;
    margin: 0;
  }

  .banner-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    flex-shrink: 0;
  }

  @media (min-width: 600px) {
    .banner-actions {
      flex-direction: row;
      align-items: center;
    }
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    min-height: var(--touch-target-min, 44px);
    background-color: var(--color-brand-orange, #ea580c);
    color: #ffffff;
    font-weight: 700;
    font-size: 0.9375rem;
    padding: 0.875rem 1.75rem;
    border-radius: var(--radius-md, 8px);
    box-shadow: 0 4px 14px rgba(234, 88, 12, 0.35);
    transition: all var(--transition-fast);
    text-decoration: none;
    white-space: nowrap;
  }

  .btn-primary:hover {
    background-color: var(--color-brand-orange-hover, #c2410c);
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(234, 88, 12, 0.45);
  }

  .btn-facilities {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    min-height: var(--touch-target-min, 44px);
    background-color: #0e2a4a;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.15);
    font-weight: 700;
    font-size: 0.9375rem;
    padding: 0.875rem 1.75rem;
    border-radius: var(--radius-md, 8px);
    transition: all var(--transition-fast);
    text-decoration: none;
    white-space: nowrap;
  }

  .btn-facilities:hover {
    background-color: #133965;
    border-color: rgba(255, 255, 255, 0.3);
  }

  /* Divider */
  .banner-divider {
    height: 1px;
    background-color: rgba(255, 255, 255, 0.12);
    margin-top: 2.5rem;
    margin-bottom: 2rem;
  }

  /* Bottom 4 Trust Stats */
  .banner-stats-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 600px) {
    .banner-stats-row {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .banner-stats-row {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }
  }

  .stat-item {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }

  .stat-icon {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-sm);
    background-color: rgba(255, 255, 255, 0.08);
    color: #38bdf8;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .stat-text {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .stat-label {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #94a3b8;
    text-transform: uppercase;
  }

  .stat-value {
    font-size: 0.9375rem;
    font-weight: 700;
    color: #ffffff;
  }

  .hotline-link {
    text-decoration: none;
    color: #ffffff;
    transition: color var(--transition-fast);
  }

  .hotline-link:hover {
    color: var(--color-brand-orange);
  }
</style>
