---
const values = [
  {
    icon: 'shield',
    title: 'An toàn',
    desc: 'Đặt an toàn của hàng hóa và con người lên hàng đầu trong từng thao tác bốc dỡ. Đội ngũ bốc xếp tuân thủ trang bị bảo hộ và nguyên tắc nâng chuyển cơ học.',
  },
  {
    icon: 'bulb',
    title: 'Chủ động',
    desc: 'Dự liệu trước các phương án xử lý hàng cồng kềnh hoặc kiện hàng quá khổ. Bố trí trước phương tiện chuyên dụng tránh gián đoạn hành trình xe tải.',
  },
  {
    icon: 'handshake',
    title: 'Phối hợp',
    desc: 'Làm việc chặt chẽ cùng thủ kho và tài xế để quá trình bốc xếp diễn ra nhanh gọn. Thông tin rõ ràng, giảm tải thời gian chờ đợi tại kho bãi tiếp nhận.',
  },
  {
    icon: 'process',
    title: 'Đúng quy trình',
    desc: 'Tuân thủ nghiêm ngặt kỹ thuật chằng buộc, chèn lót hàng hóa khi lên xe. Đảm bảo kiện hàng giữ nguyên vị trí, không xê dịch khi xe ôm cua hay phanh gấp.',
  },
];
---

<section class="handling-values-section" aria-labelledby="handling-values-heading">
  <div class="container">
    <!-- Section Header -->
    <div class="section-header">
      <span class="section-tag">GIÁ TRỊ PHỤNG SỰ</span>
      <h2 id="handling-values-heading" class="section-title">
        Nam Hân đồng hành cùng quá trình vận chuyển
      </h2>
      <p class="section-desc">
        Chúng tôi xác lập uy tín bằng trách nhiệm thực tế trên từng kiện hàng, không tạo số liệu xa vời mà tập trung vào an toàn và tính kỷ luật.
      </p>
    </div>

    <!-- 4 Values Grid -->
    <div class="values-grid">
      {
        values.map((item) => (
          <div class="value-card">
            <div class="value-icon-box" aria-hidden="true">
              {item.icon === 'shield' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                  <polyline points="9 12 11 14 15 10"/>
                </svg>
              )}
              {item.icon === 'bulb' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="12" y1="2" x2="12" y2="6"/>
                  <line x1="12" y1="18" x2="12" y2="22"/>
                  <line x1="4.93" y1="4.93" x2="7.76" y2="7.76"/>
                  <line x1="16.24" y1="16.24" x2="19.07" y2="19.07"/>
                  <line x1="2" y1="12" x2="6" y2="12"/>
                  <line x1="18" y1="12" x2="22" y2="12"/>
                  <line x1="4.93" y1="19.07" x2="7.76" y2="16.24"/>
                  <line x1="16.24" y1="7.76" x2="19.07" y2="4.93"/>
                </svg>
              )}
              {item.icon === 'handshake' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m11 17 2 2a1 1 0 0 0 1.4 0l4.3-4.3a1 1 0 0 0 0-1.4l-2-2a1 1 0 0 0-1.4 0l-4.3 4.3a1 1 0 0 0 0 1.4Z"/>
                  <path d="m18 10 1.3-1.3a1 1 0 0 0 0-1.4l-2.6-2.6a1 1 0 0 0-1.4 0L14 6"/>
                  <path d="m6 18 1.3-1.3"/>
                  <path d="M2 14v4a2 2 0 0 0 2 2h4l4-4"/>
                </svg>
              )}
              {item.icon === 'process' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
                </svg>
              )}
            </div>

            <h3 class="value-title">{item.title}</h3>
            <p class="value-desc">{item.desc}</p>
          </div>
        ))
      }
    </div>

    <!-- Depot Infrastructure Callout Banner -->
    <div class="depot-callout-banner">
      <div class="banner-left">
        <span class="banner-tag">HẠ TẦNG HỖ TRỢ SẴN SÀNG</span>
        <h3 class="banner-title">Trang bị đồng bộ tại 4 trung tâm depot toàn quốc</h3>
        <p class="banner-desc">
          Hệ thống xe nâng điện, xe nâng dầu từ 2 đến 7 tấn, cùng hệ thống cẩu xe lên container và pallet tiêu chuẩn được bảo trì định kỳ, đáp ứng ngay lập tức các yêu cầu chuyển tải khẩn cấp.
        </p>
      </div>

      <div class="banner-right">
        <div class="facility-card">
          <div class="facility-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="1" y="3" width="15" height="13" rx="1"/>
              <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
              <circle cx="5.5" cy="18.5" r="2.5"/>
              <circle cx="18.5" cy="18.5" r="2.5"/>
            </svg>
          </div>
          <div class="facility-info">
            <strong class="facility-name">Xe cẩu tự hành</strong>
            <span class="facility-sub">Phục vụ cẩu máy móc công trình</span>
          </div>
        </div>

        <div class="facility-card">
          <div class="facility-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/>
              <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
            </svg>
          </div>
          <div class="facility-info">
            <strong class="facility-name">Pallet gỗ & nhựa chuẩn G7</strong>
            <span class="facility-sub">Sẵn có số lượng lớn tại bãi</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .handling-values-section {
    padding-top: clamp(3rem, 6vw, 4.5rem);
    padding-bottom: clamp(3rem, 6vw, 4.5rem);
    background-color: #ffffff;
  }

  .section-header {
    text-align: center;
    max-width: 48rem;
    margin-inline: auto;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .section-tag {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-brand-orange);
    margin-bottom: 0.625rem;
  }

  .section-title {
    font-size: clamp(1.75rem, 2.5vw + 0.5rem, 2.375rem);
    font-weight: 800;
    color: var(--color-brand-navy);
    line-height: 1.25;
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
  }

  .section-desc {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .values-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  @media (min-width: 640px) {
    .values-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .values-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }
  }

  .value-card {
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg, 16px);
    padding: 1.75rem 1.5rem;
    display: flex;
    flex-direction: column;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.03);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .value-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
    border-color: rgba(249, 80, 22, 0.3);
  }

  .value-icon-box {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.5rem;
    background-color: #eff6ff;
    color: #2563eb;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .value-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-brand-navy);
    line-height: 1.35;
    margin-bottom: 0.625rem;
  }

  .value-desc {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
    margin: 0;
  }

  /* Depot Callout Banner */
  .depot-callout-banner {
    background-color: #f0f7ff;
    border: 1px solid #dbeafe;
    border-radius: var(--radius-lg, 16px);
    padding: clamp(1.75rem, 4vw, 2.5rem);
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .depot-callout-banner {
      grid-template-columns: 1.2fr 0.8fr;
      gap: 2.5rem;
    }
  }

  .banner-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-brand-orange);
    margin-bottom: 0.5rem;
  }

  .banner-title {
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    font-weight: 800;
    color: var(--color-brand-navy);
    line-height: 1.3;
    margin-bottom: 0.625rem;
  }

  .banner-desc {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .banner-right {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .facility-card {
    background-color: #ffffff;
    border: 1px solid #e0e7ff;
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    box-shadow: 0 2px 4px rgba(11, 25, 44, 0.03);
  }

  .facility-icon {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.5rem;
    background-color: #fff7ed;
    color: var(--color-brand-orange);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .facility-name {
    display: block;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-brand-navy);
    line-height: 1.3;
    margin-bottom: 0.125rem;
  }

  .facility-sub {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    line-height: 1.4;
  }
</style>
