---
interface ProcessItem {
  step: string;
  title: string;
  desc: string;
  actionNote: string;
  isHighlight?: boolean;
}

const steps: ProcessItem[] = [
  {
    step: '01',
    title: 'Tiếp nhận yêu cầu',
    desc: 'Khảo sát quy cách hàng, tải trọng kiện và điều kiện bãi bốc dỡ. Đánh giá tính chất kiện hàng để bố trí trang thiết bị phù hợp.',
    actionNote: 'Khảo sát bãi bốc dỡ',
  },
  {
    step: '02',
    title: 'Chuẩn bị hàng hóa',
    desc: 'Chuẩn bị pallet, màng quấn, dây chằng buộc và trang thiết bị hỗ trợ. Gia cố các góc kiện hàng dễ va chạm trước khi nâng.',
    actionNote: 'Vật tư đóng gói tiêu chuẩn',
  },
  {
    step: '03',
    title: 'Bốc xếp & xử lý',
    desc: 'Thực hiện nâng hạ, xếp dỡ hàng vào thùng xe đúng kỹ thuật phân bổ tải. Chèn lót túi khí và chằng dây cảo cố định vững chãi.',
    actionNote: 'Cân đối trọng tâm trục xe',
    isHighlight: true,
  },
  {
    step: '04',
    title: 'Bàn giao',
    desc: 'Kiểm tra độ ổn định hàng hóa và bàn giao biên bản niêm phong. Ký nhận số lượng và hiện trạng kiện cùng tài xế xuất phát.',
    actionNote: 'Niêm phong chì an toàn',
  },
];
---

<section class="handling-process-section" aria-labelledby="handling-process-heading">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">QUY CHUẨN THAO TÁC</span>
      <h2 id="handling-process-heading" class="section-title">Quy trình hỗ trợ</h2>
      <p class="section-desc">
        4 bước đồng bộ nghiêm ngặt từ khâu tiếp nhận quy cách hàng đến lúc niêm phong bàn giao xe.
      </p>
    </div>

    <div class="process-grid">
      {
        steps.map((item) => (
          <div class="process-card">
            <div class="card-top">
              <span class="step-num">{item.step}</span>
              <div class={`icon-badge ${item.isHighlight ? 'badge-orange' : 'badge-navy'}`}>
                {item.step === '01' && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>
                    <rect x="8" y="2" width="8" height="4" rx="1" ry="1"/>
                    <path d="M9 14l2 2 4-4"/>
                  </svg>
                )}
                {item.step === '02' && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                    <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                  </svg>
                )}
                {item.step === '03' && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m16 3 4 4-4 4"/>
                    <path d="M20 7H4"/>
                    <path d="m8 21-4-4 4-4"/>
                    <path d="M4 17h16"/>
                  </svg>
                )}
                {item.step === '04' && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"/>
                    <polyline points="16 10 11 15 8 12"/>
                  </svg>
                )}
              </div>
            </div>

            <h3 class="card-title">{item.title}</h3>
            <p class="card-desc">{item.desc}</p>

            <div class="card-action-note">
              <span>→</span>
              <span>{item.actionNote}</span>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .handling-process-section {
    padding-top: clamp(3rem, 6vw, 4.5rem);
    padding-bottom: clamp(3rem, 6vw, 4.5rem);
    background-color: #f0f7ff;
    border-top: 1px solid var(--color-border);
  }

  .section-header {
    text-align: center;
    max-width: 44rem;
    margin-inline: auto;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .section-tag {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-brand-orange);
    margin-bottom: 0.625rem;
  }

  .section-title {
    font-size: clamp(1.75rem, 2.5vw + 0.5rem, 2.375rem);
    font-weight: 800;
    color: var(--color-brand-navy);
    line-height: 1.25;
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
  }

  .section-desc {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .process-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .process-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .process-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }
  }

  .process-card {
    background-color: #ffffff;
    border: 1px solid #e0e7ff;
    border-radius: var(--radius-lg, 16px);
    padding: 1.75rem 1.5rem;
    display: flex;
    flex-direction: column;
    box-shadow: 0 2px 6px rgba(11, 25, 44, 0.04);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .process-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(11, 25, 44, 0.08);
    border-color: rgba(249, 80, 22, 0.3);
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .step-num {
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1;
    color: #cbd5e1;
    letter-spacing: -0.03em;
  }

  .icon-badge {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .badge-navy {
    background-color: var(--color-brand-navy);
    color: #ffffff;
  }

  .badge-orange {
    background-color: var(--color-brand-orange);
    color: #ffffff;
  }

  .card-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-brand-navy);
    line-height: 1.35;
    margin-bottom: 0.625rem;
  }

  .card-desc {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
    flex-grow: 1;
    margin-bottom: 1.25rem;
  }

  .card-action-note {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-brand-orange);
    padding-top: 0.875rem;
    border-top: 1px dashed var(--color-border);
  }
</style>
