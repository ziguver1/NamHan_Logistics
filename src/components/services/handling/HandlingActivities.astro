---
interface ActivityItem {
  num: string;
  category: string;
  title: string;
  desc: string;
  tag: string;
  iconType: 'boxes' | 'warehouse' | 'forklift' | 'checkdoc';
}

const activities: ActivityItem[] = [
  {
    num: '01',
    category: 'HẠNG MỤC 01',
    title: 'Bốc xếp hàng hóa',
    desc: 'Bốc dỡ thủ công hoặc bằng xe cơ giới, đảm bảo an toàn tuyệt đối cho bao bì và hàng hóa. Từng kiện hàng đều được phân loại tải trọng trước khi bốc dỡ vào thùng xe.',
    tag: 'Thủ công & Cơ giới kết hợp',
    iconType: 'boxes',
  },
  {
    num: '02',
    category: 'HẠNG MỤC 02',
    title: 'Tập kết hàng hóa',
    desc: 'Sắp xếp hàng tại bãi tập kết hoặc kho trung chuyển theo từng tuyến đường phân phối. Lưu trữ tạm an toàn, khô ráo, có phân khu rõ ràng giữa hàng nặng và hàng dễ vỡ.',
    tag: 'Phân line tuyến phân phối',
    iconType: 'warehouse',
  },
  {
    num: '03',
    category: 'HẠNG MỤC 03',
    title: 'Hỗ trợ phương tiện',
    desc: 'Bố trí xe nâng, xe cẩu tự hành, bàn nâng thủy lực phục vụ nâng hạ hàng nặng. Giúp giảm thiểu thời gian chờ của xe tải tại điểm đóng/rút và đảm bảo chuẩn kỹ thuật.',
    tag: 'Xe nâng, bàn nâng thủy lực',
    iconType: 'forklift',
  },
  {
    num: '04',
    category: 'HẠNG MỤC 04',
    title: 'Phối hợp giao nhận',
    desc: 'Phối hợp kiểm tra tem nhãn, phân loại kiện hàng trước khi đưa lên xe vận tải. Đối soát biên bản bàn giao và tình trạng hàng hóa nguyên đai nguyên kiện với các bên.',
    tag: 'Kiểm tra tem nhãn & Niêm phong',
    iconType: 'checkdoc',
  },
];
---

<section class="handling-activities-section" aria-labelledby="handling-activities-heading">
  <div class="container">
    <div class="section-top-row">
      <div class="header-content">
        <span class="section-tag">NGHIỆP VỤ CHI TIẾT</span>
        <h2 id="handling-activities-heading" class="section-title">Các hoạt động hỗ trợ</h2>
        <p class="section-desc">
          Giải pháp chuyên sâu được chuẩn hóa tại các bãi tập kết và kho hàng trung chuyển của Nam Hân.
        </p>
      </div>

      <div class="standard-pill-badge" aria-label="Tiêu chuẩn nhân lực">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="3"/>
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
        </svg>
        <span>Công cụ & Nhân lực đạt chuẩn</span>
      </div>
    </div>

    <!-- 4 Activity Cards Grid -->
    <div class="activities-grid">
      {
        activities.map((item) => (
          <div class="activity-card">
            <div class="card-icon-box" aria-hidden="true">
              {item.iconType === 'boxes' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                  <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                  <line x1="12" y1="22.08" x2="12" y2="12"/>
                </svg>
              )}
              {item.iconType === 'warehouse' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                  <polyline points="9 22 9 12 15 12 15 22"/>
                </svg>
              )}
              {item.iconType === 'forklift' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="1" y="3" width="15" height="13" rx="1"/>
                  <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
                  <circle cx="5.5" cy="18.5" r="2.5"/>
                  <circle cx="18.5" cy="18.5" r="2.5"/>
                </svg>
              )}
              {item.iconType === 'checkdoc' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                  <polyline points="14 2 14 8 20 8"/>
                  <path d="m9 15 2 2 4-4"/>
                </svg>
              )}
            </div>

            <span class="card-category">{item.category}</span>
            <h3 class="card-title">{item.title}</h3>
            <p class="card-desc">{item.desc}</p>

            <div class="card-bottom-tag">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              <span>{item.tag}</span>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .handling-activities-section {
    padding-top: clamp(3rem, 6vw, 4.5rem);
    padding-bottom: clamp(3rem, 6vw, 4.5rem);
    background-color: #f8fafc;
    border-top: 1px solid var(--color-border);
  }

  .section-top-row {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  @media (min-width: 768px) {
    .section-top-row {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }

  .section-tag {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-brand-orange);
    margin-bottom: 0.625rem;
  }

  .section-title {
    font-size: clamp(1.75rem, 2.5vw + 0.5rem, 2.375rem);
    font-weight: 800;
    color: var(--color-brand-navy);
    line-height: 1.25;
    letter-spacing: -0.02em;
    margin-bottom: 0.625rem;
  }

  .section-desc {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    max-width: 36rem;
  }

  .standard-pill-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: #e0f2fe;
    color: #0369a1;
    border: 1px solid #bae6fd;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-full);
    font-size: 0.8125rem;
    font-weight: 700;
    white-space: nowrap;
    align-self: flex-start;
  }

  .activities-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .activities-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .activities-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }
  }

  .activity-card {
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg, 16px);
    padding: 1.75rem 1.5rem;
    display: flex;
    flex-direction: column;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.03);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast), border-color var(--transition-fast);
  }

  .activity-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
    border-color: rgba(249, 80, 22, 0.3);
  }

  .card-icon-box {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.5rem;
    background-color: #eff6ff;
    color: #2563eb;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .card-category {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-brand-orange);
    text-transform: uppercase;
    margin-bottom: 0.375rem;
  }

  .card-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-brand-navy);
    line-height: 1.35;
    margin-bottom: 0.75rem;
  }

  .card-desc {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
    flex-grow: 1;
    margin-bottom: 1.25rem;
  }

  .card-bottom-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    background-color: #f1f5f9;
    color: #334155;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.4rem 0.75rem;
    border-radius: var(--radius-sm);
    line-height: 1.3;
  }

  .card-bottom-tag svg {
    color: var(--color-brand-orange);
    flex-shrink: 0;
  }
</style>
