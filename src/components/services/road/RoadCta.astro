---
import { ROUTES } from '@/lib/routes';
---

<section class="road-cta-section" aria-label="Kêu gọi hành động tư vấn vận chuyển">
  <div class="container">
    <div class="cta-banner">
      <div class="cta-content">
        <span class="cta-tag">ĐỒNG HÀNH CÙNG NAM HÂN LOGISTICS</span>
        <h2 class="cta-title">
          Bạn đang cần vận chuyển<br />
          hàng hóa?
        </h2>
        <p class="cta-desc">
          Liên hệ Nam Hân Logistics để được tư vấn phương án phù hợp.
        </p>
      </div>

      <div class="cta-actions">
        <a href={ROUTES.CONTACT} class="btn-primary">
          <span>Yêu cầu báo giá</span>
          <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4.167 10h11.666m-4.166-4.167L15.833 10l-4.166 4.167"/>
          </svg>
        </a>

        <a href="tel:19006868" class="btn-hotline">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          <span>Hotline: 1900 6868</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .road-cta-section {
    padding-top: clamp(2rem, 4vw, 3.5rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
    background-color: #ffffff;
  }

  .cta-banner {
    background-color: #0b1e36;
    border-radius: var(--radius-xl, 20px);
    padding: clamp(2.5rem, 5vw, 3.5rem) clamp(1.75rem, 4vw, 3.5rem);
    display: flex;
    flex-direction: column;
    gap: 2rem;
    box-shadow: 0 12px 32px rgba(11, 30, 54, 0.15);
  }

  @media (min-width: 900px) {
    .cta-banner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .cta-content {
    max-width: 38rem;
  }

  .cta-tag {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fb923c;
    margin-bottom: 0.875rem;
  }

  .cta-title {
    font-size: clamp(1.875rem, 3vw, 2.5rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.25;
    letter-spacing: -0.02em;
    margin-bottom: 0.875rem;
  }

  .cta-desc {
    font-size: 1rem;
    color: #94a3b8;
    line-height: 1.6;
  }

  .cta-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    flex-shrink: 0;
  }

  @media (min-width: 600px) {
    .cta-actions {
      flex-direction: row;
      align-items: center;
    }
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    min-height: var(--touch-target-min, 44px);
    background-color: var(--color-brand-orange, #ea580c);
    color: #ffffff;
    font-weight: 700;
    font-size: 0.9375rem;
    padding: 0.875rem 1.75rem;
    border-radius: var(--radius-md, 8px);
    box-shadow: 0 4px 14px rgba(234, 88, 12, 0.35);
    transition: all var(--transition-fast);
    text-decoration: none;
    white-space: nowrap;
  }

  .btn-primary:hover {
    background-color: var(--color-brand-orange-hover, #c2410c);
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(234, 88, 12, 0.45);
  }

  .btn-hotline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    min-height: var(--touch-target-min, 44px);
    background-color: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.18);
    font-weight: 700;
    font-size: 0.9375rem;
    padding: 0.875rem 1.75rem;
    border-radius: var(--radius-md, 8px);
    transition: all var(--transition-fast);
    text-decoration: none;
    white-space: nowrap;
  }

  .btn-hotline:hover {
    background-color: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.3);
  }
</style>
