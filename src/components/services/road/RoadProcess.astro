---
interface ProcessStep {
  step: string;
  title: string;
  desc: string;
  note: string;
  iconBg?: string;
  noteHighlight?: boolean;
}

const steps: ProcessStep[] = [
  {
    step: '01',
    title: 'Tiếp nhận yêu cầu',
    desc: 'Ghi nhận chủng loại hàng, khối lượng và lộ trình giao nhận.',
    note: 'Bước khởi đầu chuẩn hóa thông tin',
  },
  {
    step: '02',
    title: 'Tư vấn phương án',
    desc: 'Đề xuất loại xe và lịch trình vận chuyển tối ưu nhất.',
    note: 'Cân đối loại xe & chi phí hợp lý',
  },
  {
    step: '03',
    title: 'Điều phối phương tiện',
    desc: 'Bố trí xe kiểm định đạt chuẩn và tài xế chuyên tuyến.',
    note: 'Xe sẵn sàng, tài xế đúng lịch',
  },
  {
    step: '04',
    title: 'Giao nhận hàng hóa',
    desc: 'Bàn giao đủ số lượng, ký biên bản giao nhận đúng hẹn.',
    note: 'Bàn giao đầy đủ hóa đơn, chứng từ',
    noteHighlight: true,
  },
];
---

<section class="road-process-section" aria-labelledby="road-process-heading">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">QUY CHUẨN CHUYÊN NGHIỆP</span>
      <h2 id="road-process-heading" class="section-title">Quy trình vận chuyển</h2>
      <p class="section-desc">
        4 bước thực hiện mạch lạc từ khâu tiếp nhận thông tin tới khi bàn giao chứng từ hoàn tất.
      </p>
    </div>

    <div class="process-grid">
      {
        steps.map((item) => (
          <div class="process-card">
            <div class="card-top">
              <span class="step-num">{item.step}</span>
              <div class={`icon-badge ${item.noteHighlight ? 'badge-orange' : 'badge-blue'}`}>
                {item.step === '01' && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>
                    <rect x="8" y="2" width="8" height="4" rx="1" ry="1"/>
                    <path d="M9 14l2 2 4-4"/>
                  </svg>
                )}
                {item.step === '02' && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                    <line x1="3" y1="9" x2="21" y2="9"/>
                    <line x1="9" y1="21" x2="9" y2="9"/>
                  </svg>
                )}
                {item.step === '03' && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="1" y="3" width="15" height="13"/>
                    <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
                    <circle cx="5.5" cy="18.5" r="2.5"/>
                    <circle cx="18.5" cy="18.5" r="2.5"/>
                  </svg>
                )}
                {item.step === '04' && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                    <polyline points="14 2 14 8 20 8"/>
                    <path d="m9 15 2 2 4-4"/>
                  </svg>
                )}
              </div>
            </div>

            <h3 class="card-title">{item.title}</h3>
            <p class="card-desc">{item.desc}</p>
            <div class={`card-note ${item.noteHighlight ? 'note-highlight' : ''}`}>
              {item.note}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .road-process-section {
    padding-top: clamp(3rem, 6vw, 4.5rem);
    padding-bottom: clamp(3rem, 6vw, 4.5rem);
    background-color: #f8fafc;
    border-top: 1px solid var(--color-border);
  }

  .section-header {
    text-align: center;
    max-width: 44rem;
    margin-inline: auto;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .section-tag {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-brand-orange);
    margin-bottom: 0.625rem;
  }

  .section-title {
    font-size: clamp(1.75rem, 2.5vw + 0.5rem, 2.375rem);
    font-weight: 800;
    color: var(--color-brand-navy);
    line-height: 1.25;
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
  }

  .section-desc {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .process-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .process-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .process-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }
  }

  .process-card {
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg, 16px);
    padding: 1.75rem 1.5rem;
    display: flex;
    flex-direction: column;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.03);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .process-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
    border-color: rgba(249, 80, 22, 0.3);
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .step-num {
    font-size: 1.875rem;
    font-weight: 800;
    line-height: 1;
    color: var(--color-brand-orange);
    letter-spacing: -0.02em;
  }

  .icon-badge {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .badge-blue {
    background-color: #eff6ff;
    color: #2563eb;
  }

  .badge-orange {
    background-color: #fff7ed;
    color: var(--color-brand-orange);
  }

  .card-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-brand-navy);
    line-height: 1.35;
    margin-bottom: 0.5rem;
  }

  .card-desc {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
    flex-grow: 1;
    margin-bottom: 1.25rem;
  }

  .card-note {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-text-muted, #64748b);
    padding-top: 0.875rem;
    border-top: 1px dashed var(--color-border);
    line-height: 1.4;
  }

  .card-note.note-highlight {
    color: var(--color-brand-orange);
    font-weight: 600;
  }
</style>
