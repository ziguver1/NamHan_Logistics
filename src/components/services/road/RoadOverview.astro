---
import { roadAssets } from '@/content/road-assets';
import ImageSlot from '@/components/ui/ImageSlot.astro';

const depotImage = roadAssets.overviewWarehouse;
---

<section class="road-overview-section" aria-label="Tổng quan giải pháp vận tải đường bộ">
  <div class="container overview-container">
    <!-- Left Column: Text & Features -->
    <div class="overview-left">
      <div class="section-tag-row">
        <span class="tag-bar" aria-hidden="true"></span>
        <span class="section-tag">TỔNG QUAN GIẢI PHÁP</span>
      </div>

      <h2 class="section-title">Nam Hân – Vận chuyển hàng hóa đường bộ</h2>

      <p class="overview-desc">
        Nam Hân Logistics cung cấp dịch vụ vận chuyển hàng hóa bằng đường bộ, phục vụ nhu cầu giao nhận trên các tuyến Bắc – Trung – Nam. Dịch vụ được tổ chức phù hợp với loại hàng, tuyến đường và yêu cầu vận chuyển của khách hàng.
      </p>

      <!-- 2 Feature Cards -->
      <div class="feature-cards">
        <div class="feat-card">
          <div class="feat-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <polyline points="9 12 11 14 15 10"/>
            </svg>
          </div>
          <div class="feat-info">
            <h3 class="feat-title">Chuyên tuyến liên tỉnh</h3>
            <p class="feat-text">Lộ trình tối ưu xuyên suốt các trục công nghiệp.</p>
          </div>
        </div>

        <div class="feat-card">
          <div class="feat-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="1" y="3" width="15" height="13" rx="1"/>
              <polygon points="16 8 20 8 23 11 23 16 16 16 8"/>
              <circle cx="5.5" cy="18.5" r="2.5"/>
              <circle cx="18.5" cy="18.5" r="2.5"/>
            </svg>
          </div>
          <div class="feat-info">
            <h3 class="feat-title">Điều phối linh hoạt</h3>
            <p class="feat-text">Đáp ứng theo từng lô hàng và tiến độ thực tế.</p>
          </div>
        </div>
      </div>

      <!-- 2 Bottom Bullets -->
      <div class="overview-bullets">
        <div class="bullet-item">
          <svg class="check-icon" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="4 11 8 15 16 6"/>
          </svg>
          <span>Đội ngũ lái xe kinh nghiệm chuyên tuyến</span>
        </div>

        <div class="bullet-item">
          <svg class="check-icon" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="4 11 8 15 16 6"/>
          </svg>
          <span>Biên bản giao nhận đầy đủ, minh bạch</span>
        </div>
      </div>
    </div>

    <!-- Right Column: Media Slot with Floating Badge -->
    <div class="overview-right">
      <div class="media-card-wrap">
        <ImageSlot
          src={depotImage?.src}
          alt={depotImage?.alt}
          label={depotImage?.label}
          aspectRatio="16/10"
          rounded="xl"
          class="overview-slot"
        />

        <div class="floating-infra-badge">
          <div class="infra-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="3"/>
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
            </svg>
          </div>
          <div class="infra-text">
            <span class="infra-label">HẠ TẦNG XE Ô TÔ TẢI</span>
            <span class="infra-title">Vận hành an toàn 24/7</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .road-overview-section {
    padding-top: var(--section-space);
    padding-bottom: var(--section-space);
    background-color: var(--color-bg-page);
    border-bottom: 1px solid var(--color-border);
  }

  .overview-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .overview-container {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 3.5rem;
    }
  }

  .overview-left {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .section-tag-row {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .tag-bar {
    width: 1.5rem;
    height: 3px;
    background-color: var(--color-brand-orange);
    border-radius: var(--radius-full);
  }

  .section-tag {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-brand-orange);
  }

  .section-title {
    font-size: clamp(1.75rem, 2.5vw + 0.75rem, 2.5rem);
    font-weight: 800;
    color: var(--color-brand-navy);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .overview-desc {
    font-size: var(--font-body);
    color: var(--color-text-secondary);
    line-height: 1.65;
  }

  .feature-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  @media (min-width: 640px) {
    .feature-cards {
      grid-template-columns: 1fr 1fr;
    }
  }

  .feat-card {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    padding: 1.25rem;
    background-color: #f8fafc;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .feat-icon {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-md);
    background-color: #fff1eb;
    color: var(--color-brand-orange);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .feat-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .feat-title {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-brand-navy);
  }

  .feat-text {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    line-height: 1.45;
  }

  .overview-bullets {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin-top: 0.5rem;
  }

  .bullet-item {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: #334155;
  }

  .check-icon {
    color: var(--color-brand-orange);
    flex-shrink: 0;
  }

  /* Right Media Column */
  .overview-right {
    position: relative;
  }

  .media-card-wrap {
    position: relative;
    border-radius: var(--radius-xl);
    overflow: visible;
  }

  .floating-infra-badge {
    position: absolute;
    bottom: -1rem;
    left: 1.5rem;
    background-color: var(--color-brand-navy);
    color: #ffffff;
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    box-shadow: 0 10px 20px -3px rgba(11, 25, 44, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.15);
    z-index: 2;
  }

  .infra-icon {
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-sm);
    background-color: rgba(249, 80, 22, 0.2);
    color: #fdba74;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .infra-text {
    display: flex;
    flex-direction: column;
  }

  .infra-label {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #94a3b8;
    text-transform: uppercase;
  }

  .infra-title {
    font-size: 0.875rem;
    font-weight: 700;
    color: #ffffff;
  }

  @media (max-width: 639px) {
    .floating-infra-badge {
      position: static;
      margin-top: 1rem;
    }
  }
</style>
