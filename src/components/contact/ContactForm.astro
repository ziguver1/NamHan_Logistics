---
/**
 * Main Shipping Contact Form (Figma Node 101:1859 & Voice UI 101:1937)
 * Design Reference: 08-lien-he.png (Lead Point 1)
 *
 * Compliance:
 * - Customer Type: Cá nhân / Doanh nghiệp toggle (Doanh nghiệp active by default)
 * - Fields: Tên công ty / Họ tên, Điểm đi, Điểm đến, Bạn cần vận chuyển gì?, Khối lượng / số lượng (nếu biết), SĐT / Zalo
 * - Voice Input: Browser-native Web Speech API with fallback according to docs/06-VOICE-INPUT.md
 * - Phase 1 Demo Compliance: Informative preview banner with direct hotline (no false success message)
 */
import { companyInfo } from '@/content/company';
import { VIETNAM_PROVINCES, MAJOR_LOGISTICS_HUBS } from '@/content/vietnam-provinces';
---

<div class="contact-form-card" id="shipping-form">
  <div class="form-header">
    <h2 class="form-title">Thông tin yêu cầu vận chuyển</h2>
    <p class="form-subtitle">Điền thông tin để Nam Hân tư vấn giải pháp phù hợp cho bạn.</p>
  </div>

  <form id="contactShippingForm" class="shipping-form" data-hotline={companyInfo.hotline} novalidate>
    <!-- Honeypot anti-spam field (hidden from real users) -->
    <div style="display:none !important; position:absolute; left:-9999px;" aria-hidden="true">
      <label for="company_tax_id_bypass">Không điền vào ô này</label>
      <input type="text" id="company_tax_id_bypass" name="company_tax_id_bypass" tabindex="-1" autocomplete="off" />
    </div>

    <!-- Hidden metadata fields -->
    <input type="hidden" id="formRequestId" name="requestId" value="" />
    <input type="hidden" id="formSourceUrl" name="sourceUrl" value="/lien-he/" />
    <!-- Embedded Vietnam Provinces & Hubs dataset for instant suggestion (0ms fallback) -->
    <script type="application/json" id="provincesStaticData" set:html={JSON.stringify({ provinces: VIETNAM_PROVINCES, hubs: MAJOR_LOGISTICS_HUBS })}></script>

    <!-- Radio Toggle: Bạn là -->
    <fieldset class="form-group customer-type-group">
      <legend class="form-label">Bạn là</legend>
      <div class="radio-options" role="radiogroup" aria-label="Loại khách hàng">
        <label class="radio-label">
          <input type="radio" name="customerType" value="individual" class="radio-input" />
          <span class="radio-custom" aria-hidden="true"></span>
          <span class="radio-text">Cá nhân</span>
        </label>
        <label class="radio-label">
          <input type="radio" name="customerType" value="business" class="radio-input" checked />
          <span class="radio-custom" aria-hidden="true"></span>
          <span class="radio-text active">Doanh nghiệp</span>
        </label>
      </div>
    </fieldset>

    <!-- Field 1: Tên công ty / Họ tên -->
    <div class="form-group">
      <label for="clientName" class="form-label">
        <span id="clientNameLabelText">Tên công ty / Họ tên</span>
      </label>
      <div class="input-with-icon">
        <span class="input-icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
        </span>
        <input
          type="text"
          id="clientName"
          name="clientName"
          class="form-input"
          placeholder="Nhập tên công ty hoặc họ tên của bạn"
          required
          aria-required="true"
        />
      </div>
      <span class="field-error" id="clientNameError" aria-live="polite"></span>
    </div>

    <!-- 2-col Row: Điểm đi & Điểm đến -->
    <div class="form-row-2">
      <!-- Điểm đi -->
      <div class="form-group location-field-group" id="pickupLocationGroup">
        <label for="pickupLocation" class="form-label">Điểm đi</label>
        <div class="input-with-icon">
          <span class="input-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
          </span>
          <input
            type="text"
            id="pickupLocation"
            name="pickupLocation"
            class="form-input location-suggest-input"
            placeholder="Nhập hoặc chọn tỉnh / thành đi"
            required
            aria-required="true"
            autocomplete="off"
            aria-autocomplete="list"
            aria-expanded="false"
            aria-controls="pickupLocationDropdown"
          />
          <button type="button" class="btn-clear-loc" id="pickupClearBtn" aria-label="Xóa điểm đi" style="display:none;">✕</button>
        </div>
        <!-- Location Suggestions Dropdown -->
        <div id="pickupLocationDropdown" class="location-dropdown" role="listbox" style="display:none;" aria-label="Gợi ý tỉnh thành điểm đi"></div>
        <span class="field-error" id="pickupLocationError" aria-live="polite"></span>
      </div>

      <!-- Điểm đến -->
      <div class="form-group location-field-group" id="deliveryLocationGroup">
        <label for="deliveryLocation" class="form-label">Điểm đến</label>
        <div class="input-with-icon">
          <span class="input-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
          </span>
          <input
            type="text"
            id="deliveryLocation"
            name="deliveryLocation"
            class="form-input location-suggest-input"
            placeholder="Nhập hoặc chọn tỉnh / thành đến"
            required
            aria-required="true"
            autocomplete="off"
            aria-autocomplete="list"
            aria-expanded="false"
            aria-controls="deliveryLocationDropdown"
          />
          <button type="button" class="btn-clear-loc" id="deliveryClearBtn" aria-label="Xóa điểm đến" style="display:none;">✕</button>
        </div>
        <!-- Location Suggestions Dropdown -->
        <div id="deliveryLocationDropdown" class="location-dropdown" role="listbox" style="display:none;" aria-label="Gợi ý tỉnh thành điểm đến"></div>
        <span class="field-error" id="deliveryLocationError" aria-live="polite"></span>
      </div>
    </div>

    <!-- Field: Bạn cần vận chuyển gì? (Cargo Description) -->
    <div class="form-group">
      <label for="cargoDescription" class="form-label">Bạn cần vận chuyển gì?</label>
      <div class="textarea-with-icon">
        <span class="textarea-icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
            <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
            <line x1="12" y1="22.08" x2="12" y2="12"/>
          </svg>
        </span>
        <textarea
          id="cargoDescription"
          name="cargoDescription"
          class="form-textarea"
          rows="3"
          placeholder="Mô tả hàng hóa, ví dụ: máy móc, nông sản, hàng tiêu dùng, ..."
          required
          aria-required="true"
        ></textarea>
      </div>
      <span class="field-error" id="cargoDescriptionError" aria-live="polite"></span>
    </div>

    <!-- 2-col Row: Khối lượng / số lượng & Số điện thoại / Zalo -->
    <div class="form-row-2">
      <!-- Khối lượng -->
      <div class="form-group">
        <label for="cargoWeight" class="form-label">Khối lượng / số lượng (nếu biết)</label>
        <div class="input-with-icon">
          <span class="input-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/>
              <path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/>
              <path d="M7 21h10"/>
              <path d="M12 3v18"/>
              <path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/>
            </svg>
          </span>
          <input
            type="text"
            id="cargoWeight"
            name="cargoWeight"
            class="form-input"
            placeholder="Ví dụ: 2 tấn, 10 pallet, 50 thùng, ..."
          />
        </div>
        <span class="field-error" id="cargoWeightError" aria-live="polite"></span>
      </div>

      <!-- Số điện thoại / Zalo -->
      <div class="form-group">
        <label for="contactPhone" class="form-label">Số điện thoại / Zalo</label>
        <div class="input-with-icon">
          <span class="input-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
          </span>
          <input
            type="tel"
            id="contactPhone"
            name="contactPhone"
            class="form-input"
            placeholder="Nhập số điện thoại hoặc Zalo"
            required
            aria-required="true"
          />
        </div>
        <span class="field-error" id="contactPhoneError" aria-live="polite"></span>
      </div>
    </div>

    <!-- Field: Ghi chú thêm (Notes - Tùy chọn) -->
    <div class="form-group">
      <label for="contactNotes" class="form-label">Ghi chú thêm (nếu có)</label>
      <div class="textarea-with-icon">
        <span class="textarea-icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
          </svg>
        </span>
        <textarea
          id="contactNotes"
          name="notes"
          class="form-textarea form-textarea-sm"
          rows="2"
          placeholder="Yêu cầu bốc xếp, lưu ý đặc biệt về hàng hóa, thời gian giao nhận mong muốn..."
        ></textarea>
      </div>
      <span class="field-error" id="contactNotesError" aria-live="polite"></span>
    </div>

    <!-- Voice Input UI Banner (Node 101:1937) -->
    <div class="voice-input-banner" id="voiceBannerContainer">
      <button
        type="button"
        id="voiceInputTrigger"
        class="voice-banner-btn"
        aria-label="Nói thay vì nhập - Nhấn để ghi âm mô tả yêu cầu vận chuyển"
      >
        <div class="voice-icon-circle" id="voiceIconCircle">
          <svg class="mic-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/>
            <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
            <line x1="12" y1="19" x2="12" y2="22"/>
          </svg>
        </div>
        <div class="voice-text-content">
          <strong class="voice-main-title" id="voiceMainTitle">Nói thay vì nhập</strong>
          <span class="voice-sub-title" id="voiceSubTitle">Nhấn để ghi âm mô tả yêu cầu vận chuyển của bạn</span>
        </div>
        <div class="voice-arrow-icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"/>
          </svg>
        </div>
      </button>

      <!-- Live Voice Status Indicator -->
      <div id="voiceStatusIndicator" class="voice-status-box" style="display: none;" aria-live="polite">
        <span class="voice-pulse-dot" aria-hidden="true"></span>
        <span id="voiceStatusText">Đang lắng nghe... Hãy nói yêu cầu của bạn (Bấm lại để dừng)</span>
      </div>
    </div>

    <!-- Submit Button -->
    <div class="form-submit-group">
      <button type="submit" class="btn-submit" id="submitShippingBtn">
        <span id="submitBtnText">Gửi yêu cầu vận chuyển</span>
        <svg class="btn-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="12 5 19 12 12 19"/>
        </svg>
      </button>
    </div>

    <!-- Submission Status Banner -->
    <div id="contactFormStatus" class="form-status-banner" role="status" aria-live="polite" style="display: none;">
      <svg id="statusIconSuccess" class="status-info-icon status-icon-success" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display: none;">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
        <polyline points="22 4 12 14.01 9 11.01"/>
      </svg>
      <svg id="statusIconError" class="status-info-icon status-icon-error" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display: none;">
        <circle cx="12" cy="12" r="10"/>
        <line x1="12" y1="8" x2="12" y2="12"/>
        <line x1="12" y1="16" x2="12.01" y2="16"/>
      </svg>
      <div class="status-content">
        <strong id="statusTitle">Gửi yêu cầu vận chuyển</strong>
        <span id="statusMessage"></span>
      </div>
    </div>
  </form>
</div>

<style>
  .contact-form-card {
    background-color: #ffffff;
    border-radius: var(--radius-xl, 20px);
    border: 1px solid #eef2f6;
    box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.04);
    padding: clamp(1rem, 3.5vw, 2.25rem);
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .form-header {
    margin-bottom: 1.25rem;
  }

  .form-title {
    font-family: var(--font-sans);
    font-size: clamp(1.25rem, 1.15rem + 0.4vw, 1.375rem);
    font-weight: 800;
    color: var(--color-brand-navy, #072238);
    margin: 0 0 0.375rem 0;
    letter-spacing: -0.01em;
  }

  .form-subtitle {
    font-size: 0.875rem;
    color: var(--color-text-secondary, #64748b);
    margin: 0;
    line-height: 1.45;
  }

  .shipping-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .customer-type-group {
    border: none;
    padding: 0;
    margin: 0;
  }

  .form-label {
    font-size: 0.84375rem;
    font-weight: 600;
    color: var(--color-text-primary, #0f172a);
    display: block;
  }

  .radio-options {
    display: flex;
    gap: 1.75rem;
    margin-top: 0.35rem;
  }

  .radio-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    font-size: 0.875rem;
    font-weight: 500;
    color: #475569;
    user-select: none;
    min-height: 44px;
    padding: 0.25rem 0.625rem;
    border-radius: 8px;
    transition: background-color var(--transition-fast, 150ms ease);
  }

  .radio-label:hover {
    background-color: #f8fafc;
  }

  .radio-input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .radio-custom {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 2px solid #cbd5e1;
    background-color: #ffffff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-fast, 150ms ease);
    position: relative;
    flex-shrink: 0;
  }

  .radio-input:checked + .radio-custom {
    border-color: #1d68d8;
  }

  .radio-input:checked + .radio-custom::after {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #1d68d8;
    position: absolute;
  }

  .radio-input:checked ~ .radio-text {
    font-weight: 600;
    color: #0f172a;
  }

  .radio-input:focus-visible + .radio-custom {
    outline: 2px solid #1d68d8;
    outline-offset: 2px;
  }

  .form-row-2 {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 600px) {
    .form-row-2 {
      grid-template-columns: 1fr 1fr;
    }
  }

  .input-with-icon {
    position: relative;
    display: flex;
    align-items: center;
  }

  .input-icon {
    position: absolute;
    left: 0.875rem;
    color: #94a3b8;
    display: flex;
    align-items: center;
    pointer-events: none;
    z-index: 1;
  }

  .form-input {
    width: 100%;
    height: 46px;
    padding: 0 0.875rem 0 2.5rem;
    border-radius: 10px;
    border: 1px solid #e2e8f0;
    background-color: #ffffff;
    color: var(--color-text-primary, #0f172a);
    font-size: 0.875rem;
    font-family: inherit;
    transition: border-color var(--transition-fast, 150ms ease), box-shadow var(--transition-fast, 150ms ease);
  }

  /* Location Autocomplete & Suggestion Dropdown */
  .location-field-group {
    position: relative;
  }

  .location-suggest-input {
    padding-right: 2.25rem;
  }

  .btn-clear-loc {
    position: absolute;
    right: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background-color: #f1f5f9;
    color: #64748b;
    border: 1px solid #cbd5e1;
    cursor: pointer;
    font-size: 0.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    line-height: 1;
    transition: all var(--transition-fast, 150ms ease);
    z-index: 2;
  }

  .btn-clear-loc:hover {
    background-color: #fee2e2;
    border-color: #fca5a5;
    color: #dc2626;
  }

  .location-dropdown {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    right: 0;
    max-height: 280px;
    overflow-y: auto;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 12px;
    box-shadow: 0 12px 28px -4px rgba(15, 23, 42, 0.16), 0 4px 8px -2px rgba(15, 23, 42, 0.06);
    z-index: 1000;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
  }

  /* Custom Slim Scrollbar */
  .location-dropdown::-webkit-scrollbar {
    width: 6px;
  }

  .location-dropdown::-webkit-scrollbar-track {
    background: #f8fafc;
    border-radius: 0 12px 12px 0;
  }

  .location-dropdown::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 9999px;
  }

  .location-dropdown::-webkit-scrollbar-thumb:hover {
    background: #94a3b8;
  }

  .location-dropdown :global(.location-dropdown-header) {
    padding: 0.5rem 0.85rem;
    background-color: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: #64748b;
    text-transform: uppercase;
  }

  .location-dropdown :global(.loc-sub-hint) {
    font-weight: 500;
    font-size: 0.65rem;
    color: #94a3b8;
    text-transform: none;
    letter-spacing: normal;
  }

  .location-dropdown :global(.loc-count-pill) {
    font-size: 0.6875rem;
    font-weight: 700;
    color: #0284c7;
    background-color: #e0f2fe;
    padding: 0.125rem 0.45rem;
    border-radius: 9999px;
    text-transform: none;
    letter-spacing: normal;
  }

  .location-dropdown :global(.location-popular-chips) {
    padding: 0.5rem 0.65rem;
    display: flex !important;
    flex-wrap: wrap !important;
    gap: 0.35rem !important;
    background-color: #ffffff;
    border-bottom: 1px solid #f1f5f9;
  }

  .location-dropdown :global(.loc-chip) {
    display: inline-flex !important;
    align-items: center !important;
    padding: 0.25rem 0.6rem !important;
    background-color: #f1f5f9;
    border: 1px solid #e2e8f0;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 600;
    color: #1e293b;
    cursor: pointer;
    transition: all var(--transition-fast, 150ms ease);
    min-height: 28px;
    line-height: 1;
  }

  .location-dropdown :global(.loc-chip:hover) {
    background-color: #e0f2fe;
    border-color: #7dd3fc;
    color: #0284c7;
    transform: translateY(-1px);
  }

  .location-dropdown :global(.location-items-list) {
    list-style: none !important;
    margin: 0 !important;
    padding: 0.25rem 0 !important;
  }

