<script>
  function initContactForm() {
    const form = document.getElementById('contactShippingForm') as HTMLFormElement | null;
    if (!form) return;

    const clientName = document.getElementById('clientName') as HTMLInputElement | null;
    const pickupLocation = document.getElementById('pickupLocation') as HTMLInputElement | null;
    const deliveryLocation = document.getElementById('deliveryLocation') as HTMLInputElement | null;
    const cargoDescription = document.getElementById('cargoDescription') as HTMLTextAreaElement | null;
    const cargoWeight = document.getElementById('cargoWeight') as HTMLInputElement | null;
    const contactPhone = document.getElementById('contactPhone') as HTMLInputElement | null;
    const contactNotes = document.getElementById('contactNotes') as HTMLTextAreaElement | null;
    const statusBanner = document.getElementById('contactFormStatus');
    const statusTitle = document.getElementById('statusTitle');
    const statusMessage = document.getElementById('statusMessage');
    const submitBtn = document.getElementById('submitShippingBtn') as HTMLButtonElement | null;
    const submitBtnText = document.getElementById('submitBtnText');
    const formRequestId = document.getElementById('formRequestId') as HTMLInputElement | null;

    // Generate stable idempotency requestId if empty
    function ensureRequestId() {
      if (formRequestId && !formRequestId.value) {
        const todayStr = new Date().toISOString().slice(0, 10).replace(/-/g, '');
        const randStr = Math.random().toString(36).substring(2, 7).toUpperCase();
        formRequestId.value = `NHL-${todayStr}-${randStr}`;
      }
      return formRequestId?.value || '';
    }
    ensureRequestId();

    // Customer Type toggle label enhancement
    const customerTypeRadios = form.querySelectorAll<HTMLInputElement>('input[name="customerType"]');
    const clientNameLabel = document.getElementById('clientNameLabelText');

    customerTypeRadios.forEach((radio) => {
      radio.addEventListener('change', () => {
        if (clientNameLabel) {
          clientNameLabel.textContent = radio.value === 'individual' ? 'Họ và tên của bạn' : 'Tên công ty / Họ tên';
        }
      });
    });

    // Validation helper
    function validateField(input: HTMLInputElement | HTMLTextAreaElement | null, errorId: string, message: string): boolean {
      if (!input) return true;
      const errorEl = document.getElementById(errorId);
      const val = input.value.trim();

      if (!val) {
        input.classList.add('is-invalid');
        input.setAttribute('aria-invalid', 'true');
        if (errorEl) errorEl.textContent = message;
        return false;
      }

      if (input.type === 'tel' && val.length < 9) {
        input.classList.add('is-invalid');
        input.setAttribute('aria-invalid', 'true');
        if (errorEl) errorEl.textContent = 'Vui lòng nhập số điện thoại hoặc Zalo hợp lệ (từ 9 số).';
        return false;
      }

      input.classList.remove('is-invalid');
      input.removeAttribute('aria-invalid');
      if (errorEl) errorEl.textContent = '';
      return true;
    }

    // Clear validation error on input
    [clientName, pickupLocation, deliveryLocation, cargoDescription, cargoWeight, contactPhone, contactNotes].forEach((field) => {
      field?.addEventListener('input', () => {
        field.classList.remove('is-invalid');
        field.removeAttribute('aria-invalid');
        const err = document.getElementById(`${field.id}Error`);
        if (err) err.textContent = '';
      });
    });

    // Form submission
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const isNameValid = validateField(clientName, 'clientNameError', 'Vui lòng nhập tên công ty hoặc họ tên.');
      const isPickupValid = validateField(pickupLocation, 'pickupLocationError', 'Vui lòng nhập địa điểm lấy hàng.');
      const isDeliveryValid = validateField(deliveryLocation, 'deliveryLocationError', 'Vui lòng nhập địa điểm giao hàng.');
      const isCargoValid = validateField(cargoDescription, 'cargoDescriptionError', 'Vui lòng mô tả loại hàng hóa cần vận chuyển.');
      const isPhoneValid = validateField(contactPhone, 'contactPhoneError', 'Vui lòng nhập số điện thoại hoặc Zalo liên hệ.');

      if (!isNameValid || !isPickupValid || !isDeliveryValid || !isCargoValid || !isPhoneValid) {
        return;
      }

      const activeRadio = form.querySelector<HTMLInputElement>('input[name="customerType"]:checked');
      const customerType = activeRadio?.value || 'business';
      const currentRequestId = ensureRequestId();
      const notesEl = document.getElementById('contactNotes') as HTMLTextAreaElement | null;

      const payload = {
        requestId: currentRequestId,
        customerType,
        clientName: clientName?.value.trim() || '',
        pickupLocation: pickupLocation?.value.trim() || '',
        deliveryLocation: deliveryLocation?.value.trim() || '',
        cargoDescription: cargoDescription?.value.trim() || '',
        cargoWeight: cargoWeight?.value.trim() || '',
        contactPhone: contactPhone?.value.trim() || '',
        notes: notesEl?.value.trim() || '',
        sourceUrl: '/lien-he/',
        company_tax_id_bypass: (document.getElementById('company_tax_id_bypass') as HTMLInputElement)?.value || ''
      };

      // Set Submitting State
      if (submitBtn) submitBtn.disabled = true;
      if (submitBtnText) submitBtnText.textContent = 'Đang gửi yêu cầu...';
      form.setAttribute('aria-busy', 'true');

      try {
        const res = await fetch('/api/contact/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await res.json().catch(() => ({}));

        if (res.ok && data.success) {
          // Success State
          if (statusBanner) {
            statusBanner.className = 'form-status-banner status-success';
            if (statusTitle) statusTitle.textContent = 'Gửi yêu cầu vận chuyển thành công!';
            if (statusMessage) {
              statusMessage.innerHTML = `Mã yêu cầu: <strong>${data.requestId || currentRequestId}</strong>.<br/>Đội ngũ Nam Hân Logistics đã ghi nhận thông tin và sẽ liên hệ tư vấn lộ trình & báo giá qua số điện thoại/Zalo trong thời gian sớm nhất.`;
            }
            statusBanner.style.display = 'flex';
            statusBanner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }

          if (submitBtnText) submitBtnText.textContent = 'Đã gửi thành công (Bấm để gửi yêu cầu mới)';
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.onclick = () => {
              submitBtn.onclick = null;
              if (submitBtnText) submitBtnText.textContent = 'Gửi yêu cầu vận chuyển';
              if (statusBanner) statusBanner.style.display = 'none';
              if (formRequestId) formRequestId.value = '';
              ensureRequestId();
              form.reset();
              const defaultRadio = form.querySelector<HTMLInputElement>('input[value="business"]');
              if (defaultRadio) defaultRadio.checked = true;
            };
          }
        } else {
          // Error State: Keep user inputs intact
          if (statusBanner) {
            statusBanner.className = 'form-status-banner status-error';
            if (statusTitle) statusTitle.textContent = 'Chưa thể gửi yêu cầu';
            const errorMsg = data.message || data.error || 'Đã có sự cố khi gửi dữ liệu. Quý khách vui lòng thử lại hoặc liên hệ Hotline.';
            if (statusMessage) {
              statusMessage.innerHTML = `${errorMsg}`;
            }
            statusBanner.style.display = 'flex';
            statusBanner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }

          if (data.errors && typeof data.errors === 'object') {
            for (const [fName, fMsg] of Object.entries(data.errors)) {
              const errEl = document.getElementById(`${fName}Error`);
              if (errEl) errEl.textContent = String(fMsg);
            }
          }

          if (submitBtnText) submitBtnText.textContent = 'Thử gửi lại';
          if (submitBtn) submitBtn.disabled = false;
        }
      } catch (networkErr) {
        console.error('Submission network error:', networkErr);
        if (statusBanner) {
          statusBanner.className = 'form-status-banner status-error';
          if (statusTitle) statusTitle.textContent = 'Lỗi kết nối';
          if (statusMessage) {
            statusMessage.innerHTML = 'Không thể kết nối đến máy chủ. Dữ liệu của quý khách đã được giữ nguyên, vui lòng bấm "Thử gửi lại" hoặc gọi Hotline trực tiếp.';
          }
          statusBanner.style.display = 'flex';
          statusBanner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
        if (submitBtnText) submitBtnText.textContent = 'Thử gửi lại';
        if (submitBtn) submitBtn.disabled = false;
      } finally {
        form.removeAttribute('aria-busy');
      }
    });

    // Voice input
    const voiceTrigger = document.getElementById('voiceInputTrigger');
    const voiceStatus = document.getElementById('voiceStatusIndicator');
    const voiceStatusText = document.getElementById('voiceStatusText');
    const voiceMainTitle = document.getElementById('voiceMainTitle');
    const voiceSubTitle = document.getElementById('voiceSubTitle');

    type SpeechRecognitionType = typeof window & {
      SpeechRecognition?: any;
      webkitSpeechRecognition?: any;
    };

    const windowWithSpeech = window as unknown as SpeechRecognitionType;
    const SpeechRecognition = windowWithSpeech.SpeechRecognition || windowWithSpeech.webkitSpeechRecognition;

    let recognition: any = null;
    let isListening = false;

    if (voiceTrigger) {
      if (!SpeechRecognition) {
        voiceTrigger.addEventListener('click', () => {
          if (voiceStatus && voiceStatusText) {
            voiceStatus.style.display = 'flex';
            voiceStatusText.textContent = 'Trình duyệt hiện tại chưa hỗ trợ nhận diện giọng nói. Quý khách vui lòng nhập tay vào ô mô tả hàng hóa.';
          }
        });
      } else {
        try {
          recognition = new SpeechRecognition();
          recognition.lang = 'vi-VN';
          recognition.continuous = true;
          recognition.interimResults = true;

          recognition.onstart = () => {
            isListening = true;
            voiceTrigger.classList.add('is-listening');
            if (voiceMainTitle) voiceMainTitle.textContent = 'Đang lắng nghe...';
            if (voiceSubTitle) voiceSubTitle.textContent = 'Hãy nói rõ loại hàng và quy cách vận chuyển (Bấm lại để dừng)';
            if (voiceStatus && voiceStatusText) {
              voiceStatus.style.display = 'flex';
              voiceStatusText.textContent = 'Hệ thống đang chuyển giọng nói thành văn bản...';
            }
          };

          recognition.onresult = (event: any) => {
            let finalTranscript = '';
            for (let i = event.resultIndex; i < event.results.length; ++i) {
              if (event.results[i].isFinal) {
                finalTranscript += event.results[i][0].transcript;
              }
            }

            if (finalTranscript && cargoDescription) {
              const currentText = cargoDescription.value.trim();
              cargoDescription.value = currentText ? `${currentText} ${finalTranscript.trim()}` : finalTranscript.trim();
              cargoDescription.classList.remove('is-invalid');
              const err = document.getElementById('cargoDescriptionError');
              if (err) err.textContent = '';
            }
          };

          recognition.onerror = (event: any) => {
            console.warn('Speech recognition warning:', event.error);
            stopListening();
            if (voiceStatus && voiceStatusText) {
              voiceStatus.style.display = 'flex';
              if (event.error === 'not-allowed') {
                voiceStatusText.textContent = 'Quyền truy cập Microphone bị từ chối. Vui lòng cho phép Microphone hoặc nhập tay.';
              } else {
                voiceStatusText.textContent = 'Đã dừng nhận diện giọng nói. Quý khách có thể kiểm tra và chỉnh sửa nội dung bên trên.';
              }
            }
          };

          recognition.onend = () => {
            stopListening();
          };

          function stopListening() {
            isListening = false;
            voiceTrigger?.classList.remove('is-listening');
            if (voiceMainTitle) voiceMainTitle.textContent = 'Nói thay vì nhập';
            if (voiceSubTitle) voiceSubTitle.textContent = 'Nhấn để ghi âm mô tả yêu cầu vận chuyển của bạn';
          }

          voiceTrigger.addEventListener('click', () => {
            if (isListening) {
              recognition.stop();
              stopListening();
            } else {
              try {
                recognition.start();
              } catch (err) {
                console.warn('Recognition start error:', err);
              }
            }
          });
        } catch (e) {
          console.warn('Speech recognition init error:', e);
        }
      }
    }

    // Initialize Vietnam Provinces Autocomplete for "Điểm đi" & "Điểm đến"
    initLocationAutocomplete();
  }

  function initLocationAutocomplete() {
    const pickupInput = document.getElementById('pickupLocation') as HTMLInputElement | null;
    const pickupDropdown = document.getElementById('pickupLocationDropdown');
    const pickupClear = document.getElementById('pickupClearBtn') as HTMLButtonElement | null;
    const pickupGroup = document.getElementById('pickupLocationGroup');

    const deliveryInput = document.getElementById('deliveryLocation') as HTMLInputElement | null;
    const deliveryDropdown = document.getElementById('deliveryLocationDropdown');
    const deliveryClear = document.getElementById('deliveryClearBtn') as HTMLButtonElement | null;
    const deliveryGroup = document.getElementById('deliveryLocationGroup');

    if (!pickupInput || !deliveryInput) return;

    // Load prerendered data (guarantees 0ms instant display offline)
    interface ProvinceRecord {
      code?: string;
      name: string;
      fullName?: string;
      region: string;
      isHub?: boolean;
      aliases?: string[];
      badge?: string;
    }

    const staticDataEl = document.getElementById('provincesStaticData');
    let provincesList: ProvinceRecord[] = [];
    let hubsList: ProvinceRecord[] = [];

    if (staticDataEl && staticDataEl.textContent) {
      try {
        const parsed = JSON.parse(staticDataEl.textContent);
        if (Array.isArray(parsed.provinces)) provincesList = parsed.provinces;
        if (Array.isArray(parsed.hubs)) hubsList = parsed.hubs;
      } catch (_) {}
    }

    // Connect to Vietnam Provinces API endpoint
    fetch('/api/locations/provinces')
      .then((res) => res.json())
      .then((resData) => {
        if (resData && resData.success && Array.isArray(resData.data) && resData.data.length > 0) {
          provincesList = resData.data;
          if (Array.isArray(resData.hubs)) hubsList = resData.hubs;
        }
      })
      .catch(() => {
        // Fallback already loaded
      });

    // Helper: remove Vietnamese tones for flexible searching
    function removeTones(str: string): string {
      if (!str) return '';
      return str
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/đ/g, 'd')
        .replace(/Đ/g, 'D')
        .toLowerCase()
        .trim();
    }

    const POPULAR_CHIPS = [
      'TP. Hồ Chí Minh',
      'Bình Dương',
      'Bình Phước',
      'Đồng Nai',
      'Thanh Hóa',
      'Hà Nội',
      'Hải Phòng',
      'Đà Nẵng',
      'Long An',
      'Bà Rịa - Vũng Tàu',
      'Cần Thơ',
      'Bắc Ninh'
    ];

    function filterLocations(query: string) {
      const qClean = removeTones(query);
      if (!qClean) return [];

      const matches: ProvinceRecord[] = [];
      const seen = new Set<string>();

      // 1. Search provinces
      for (const p of provincesList) {
        const nameClean = removeTones(p.name);
        const fullNameClean = removeTones(p.fullName || '');
        const aliasMatch = Array.isArray(p.aliases) && p.aliases.some((a) => removeTones(a).includes(qClean));

        if (nameClean.includes(qClean) || fullNameClean.includes(qClean) || aliasMatch) {
          if (!seen.has(p.name)) {
            seen.add(p.name);
            matches.push({
              name: p.name,
              region: p.region,
              badge: p.isHub ? 'Trọng điểm' : p.region,
              isHub: p.isHub
            });
          }
        }
      }

      // 2. Search hubs
      for (const h of hubsList) {
        const hubClean = removeTones(h.name);
        if (hubClean.includes(qClean)) {
          if (!seen.has(h.name)) {
            seen.add(h.name);
            matches.push({
              name: h.name,
              region: h.region,
              badge: h.badge || 'Hub Nam Hân',
              isHub: true
            });
          }
        }
      }

      return matches.slice(0, 8);
    }

    function escapeHtml(str: string): string {
      return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function setupField(
      input: HTMLInputElement,
      dropdown: HTMLElement | null,
      clearBtn: HTMLButtonElement | null,
      nextInput: HTMLInputElement | null
    ) {
      if (!dropdown) return { close: () => {} };
      const dropdownEl = dropdown;
      let activeIndex = -1;

      function updateClearBtn() {
        if (clearBtn) {
          clearBtn.style.display = input.value.trim() ? 'inline-flex' : 'none';
        }
      }

      function renderDefault() {
        let html = `
          <div class="location-dropdown-header">
            <span>Tỉnh / thành phổ biến</span>
            <span class="loc-sub-hint">1 chạm để chọn</span>
          </div>
          <div class="location-popular-chips">
        `;
        for (const chip of POPULAR_CHIPS) {
          html += `<button type="button" class="loc-chip" data-val="${chip}">${chip}</button>`;
        }
        html += `</div>`;

        html += `
          <div class="location-dropdown-header" style="margin-top: 2px;">
            <span>Toàn bộ 63 tỉnh thành Việt Nam</span>
          </div>
          <ul class="location-items-list" role="listbox">
        `;

        const displayList = provincesList.length > 0 ? provincesList : [
          { name: 'TP. Hồ Chí Minh', region: 'Đông Nam Bộ', isHub: true },
          { name: 'Bình Dương', region: 'Đông Nam Bộ', isHub: true },
          { name: 'Bình Phước', region: 'Đông Nam Bộ', isHub: true },
          { name: 'Đồng Nai', region: 'Đông Nam Bộ', isHub: true },
          { name: 'Thanh Hóa', region: 'Miền Trung', isHub: true },
          { name: 'Hà Nội', region: 'Miền Bắc', isHub: true },
          { name: 'Hải Phòng', region: 'Miền Bắc', isHub: true },
          { name: 'Đà Nẵng', region: 'Miền Trung', isHub: true }
        ];

        for (const p of displayList) {
          html += `
            <li class="location-item" role="option" data-val="${p.name}">
              <div class="location-item-left">
                <span class="loc-pin-icon-wrap" aria-hidden="true">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8z"/>
                    <circle cx="12" cy="10" r="3"/>
                  </svg>
                </span>
                <span class="loc-name">${p.name}</span>
              </div>
              <span class="loc-region-badge ${p.isHub ? 'loc-hub-badge' : ''}">${p.isHub ? 'Trọng điểm' : p.region}</span>
            </li>
          `;
        }
        html += `</ul>`;

        dropdownEl.innerHTML = html;
        bindDropdownEvents();
      }

      function renderFiltered(query: string) {
        const matches = filterLocations(query);
        if (matches.length === 0) {
          dropdownEl.innerHTML = `
            <div class="location-empty-item">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2" style="margin-bottom: 6px; display: inline-block;">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              <div>Không tìm thấy tỉnh thành có tên "<strong>${escapeHtml(query)}</strong>".</div>
              <div style="font-size: 0.75rem; color: #64748b; margin-top: 4px;">
                Quý khách có thể giữ nguyên địa chỉ chi tiết vừa nhập (KCN, số nhà, phường/xã).
              </div>
            </div>
          `;
          return;
        }

        let html = `
          <div class="location-dropdown-header">
            <span>Gợi ý tỉnh / thành</span>
            <span class="loc-count-pill">${matches.length} kết quả</span>
          </div>
          <ul class="location-items-list" role="listbox">
        `;
        for (const m of matches) {
          html += `
            <li class="location-item" role="option" data-val="${m.name}">
              <div class="location-item-left">
                <span class="loc-pin-icon-wrap" aria-hidden="true">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8z"/>
                    <circle cx="12" cy="10" r="3"/>
                  </svg>
                </span>
                <span class="loc-name">${m.name}</span>
              </div>
              <span class="loc-region-badge ${m.isHub ? 'loc-hub-badge' : ''}">${m.badge || m.region}</span>
            </li>
          `;
        }
        html += `</ul>`;

        dropdownEl.innerHTML = html;
        bindDropdownEvents();
      }

      function selectValue(val: string) {
        input.value = val;
        input.classList.remove('is-invalid');
        const err = document.getElementById(`${input.id}Error`);
        if (err) err.textContent = '';
        updateClearBtn();
        close();

        // Forward focus to next input if empty
        if (nextInput && !nextInput.value.trim()) {
          setTimeout(() => {
            nextInput.focus();
          }, 60);
        }
      }

      function bindDropdownEvents() {
        // Quick chips
        dropdownEl.querySelectorAll<HTMLButtonElement>('.loc-chip').forEach((btn) => {
          btn.addEventListener('mousedown', (e) => {
            e.preventDefault();
            const val = btn.getAttribute('data-val') || '';
            if (val) selectValue(val);
          });
        });

        // Item rows
        const items = dropdownEl.querySelectorAll<HTMLElement>('.location-item');
        items.forEach((item, idx) => {
          item.addEventListener('mousedown', (e) => {
            e.preventDefault();
            const val = item.getAttribute('data-val') || '';
            if (val) selectValue(val);
          });
          item.addEventListener('mouseenter', () => {
            items.forEach((it) => it.classList.remove('is-active'));
            item.classList.add('is-active');
            activeIndex = idx;
          });
        });
      }

      function open() {
        const q = input.value.trim();
        if (!q) {
          renderDefault();
        } else {
          renderFiltered(q);
        }
        dropdownEl.style.display = 'block';
        input.setAttribute('aria-expanded', 'true');
        activeIndex = -1;
      }

      function close() {
        dropdownEl.style.display = 'none';
        input.setAttribute('aria-expanded', 'false');
        activeIndex = -1;
      }

      input.addEventListener('input', () => {
        updateClearBtn();
        const q = input.value.trim();
        if (!q) {
          renderDefault();
        } else {
          renderFiltered(q);
        }
        dropdownEl.style.display = 'block';
        input.setAttribute('aria-expanded', 'true');
      });

      input.addEventListener('focus', () => {
        open();
      });

      input.addEventListener('keydown', (e) => {
        if (dropdownEl.style.display !== 'block') {
          if (e.key === 'ArrowDown' || e.key === 'Enter') {
            open();
            e.preventDefault();
          }
          return;
        }

        const items = dropdownEl.querySelectorAll<HTMLElement>('.location-item');
        if (items.length === 0) return;

        if (e.key === 'ArrowDown') {
          e.preventDefault();
          activeIndex = (activeIndex + 1) % items.length;
          items.forEach((it, i) => it.classList.toggle('is-active', i === activeIndex));
          const currentItem = items[activeIndex];
          if (currentItem) currentItem.scrollIntoView({ block: 'nearest' });
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          activeIndex = (activeIndex - 1 + items.length) % items.length;
          items.forEach((it, i) => it.classList.toggle('is-active', i === activeIndex));
          const currentItem = items[activeIndex];
          if (currentItem) currentItem.scrollIntoView({ block: 'nearest' });
        } else if (e.key === 'Enter') {
          if (activeIndex >= 0) {
            const selectedItem = items[activeIndex];
            if (selectedItem) {
              e.preventDefault();
              const val = selectedItem.getAttribute('data-val') || '';
              if (val) selectValue(val);
            }
          }
        } else if (e.key === 'Escape') {
          e.preventDefault();
          close();
        }
      });

      if (clearBtn) {
        clearBtn.addEventListener('click', () => {
          input.value = '';
          updateClearBtn();
          input.focus();
          open();
        });
      }

      updateClearBtn();

      return { close };
    }

    const pickupCtrl = setupField(pickupInput, pickupDropdown, pickupClear, deliveryInput);
    const deliveryCtrl = setupField(deliveryInput, deliveryDropdown, deliveryClear, null);

    // Close on outside clicks or taps
    document.addEventListener('pointerdown', (e) => {
      const target = e.target as Node;
      if (pickupGroup && !pickupGroup.contains(target)) {
        pickupCtrl.close();
      }
      if (deliveryGroup && !deliveryGroup.contains(target)) {
        deliveryCtrl.close();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initContactForm);
  } else {
    initContactForm();
  }
  document.addEventListener('astro:page-load', initContactForm);
</script>
