<script>
  // Admin Login Handler
  const loginForm = document.getElementById('adminLoginForm') as HTMLFormElement | null;
  const loginError = document.getElementById('loginError');
  const loginBtn = document.getElementById('loginBtn');

  if (loginForm) {
    loginForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (loginError) loginError.style.display = 'none';
      if (loginBtn) {
        loginBtn.setAttribute('disabled', 'true');
        loginBtn.textContent = 'Đang xác thực...';
      }

      const passwordInput = document.getElementById('adminPassword') as HTMLInputElement | null;
      const password = passwordInput?.value || '';

      try {
        const res = await fetch('/api/admin/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ password })
        });

        const data = await res.json();
        if (data.success) {
          window.location.reload();
        } else {
          if (loginError) {
            loginError.textContent = data.error || 'Mật khẩu không chính xác.';
            loginError.style.display = 'block';
          }
          if (loginBtn) {
            loginBtn.removeAttribute('disabled');
            loginBtn.textContent = 'Đăng nhập hệ thống';
          }
        }
      } catch {
        if (loginError) {
          loginError.textContent = 'Không thể kết nối với máy chủ.';
          loginError.style.display = 'block';
        }
        if (loginBtn) {
          loginBtn.removeAttribute('disabled');
          loginBtn.textContent = 'Đăng nhập hệ thống';
        }
      }
    });
  }

  // Account switch confirm
  const btnConfirm = document.getElementById('btnConfirmSwitch');
  if (btnConfirm) {
    btnConfirm.addEventListener('click', async () => {
      if (!confirm('Bạn có chắc chắn muốn chuyển nơi nhận dữ liệu sang tài khoản Google mới này? Các form mới sẽ được ghi vào bảng tính mới.')) {
        return;
      }
      btnConfirm.setAttribute('disabled', 'true');
      btnConfirm.textContent = 'Đang chuyển đổi...';

      try {
        const res = await fetch('/api/admin/confirm-switch', { method: 'POST' });
        const data = await res.json();
        if (data.success) {
          alert(data.message);
          window.location.href = '/admin/google-sheets?success=switched';
        } else {
          alert('Lỗi: ' + (data.error || 'Không thể chuyển đổi'));
          btnConfirm.removeAttribute('disabled');
          btnConfirm.textContent = 'Xác nhận chuyển sang tài khoản này';
        }
      } catch {
        alert('Lỗi kết nối máy chủ');
        btnConfirm.removeAttribute('disabled');
      }
    });
  }

  // Account switch cancel
  const btnCancel = document.getElementById('btnCancelSwitch');
  if (btnCancel) {
    btnCancel.addEventListener('click', async () => {
      if (!confirm('Bạn có chắc muốn hủy bỏ liên kết tài khoản mới?')) return;
      try {
        const res = await fetch('/api/admin/cancel-switch', { method: 'POST' });
        const data = await res.json();
        if (data.success) {
          window.location.href = '/admin/google-sheets';
        }
      } catch {
        alert('Lỗi khi hủy liên kết');
      }
    });
  }

  // Copy helper
  document.querySelectorAll('.btn-copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.getAttribute('data-copy');
      if (text) {
        await navigator.clipboard.writeText(text);
        const originalText = btn.textContent;
        btn.textContent = 'Đã chép!';
        setTimeout(() => {
          btn.textContent = originalText;
        }, 2000);
      }
    });
  });
</script>
