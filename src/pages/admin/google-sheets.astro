---
/**
 * Admin Panel for Google Sheets Form Reception Management
 * SSR route: Protected by administrative session.
 * Dedicated channel: Google Apps Script Web App
 */
import SiteLayout from '@/layouts/SiteLayout.astro';
import AdminHeader from '@/components/admin/AdminHeader.astro';
import AdminLoginForm from '@/components/admin/AdminLoginForm.astro';
import { isAuthenticatedAdmin } from '@/lib/server/admin-auth';
import { getConfig } from '@/lib/server/storage';
import fs from 'node:fs/promises';
import path from 'node:path';

export const prerender = false;

const request = Astro.request;
const isAdmin = await isAuthenticatedAdmin(request);
const url = new URL(request.url);

const successParam = url.searchParams.get('success');
const errorParam = url.searchParams.get('error');

const config = isAdmin ? await getConfig() : null;
const appsConn = config?.appsScriptConnection;
const isConnected = appsConn?.status === 'active';

// Pre-load Apps Script source files so they render instantly into the in-browser code editor
let initialCodeGs = '';
let initialAppsscriptJson = '';

if (isAdmin) {
  try {
    const codePath = path.resolve('./integrations/google-apps-script/Code.gs');
    const jsonPath = path.resolve('./integrations/google-apps-script/appsscript.json');
    const [c, m] = await Promise.all([
      fs.readFile(codePath, 'utf8').catch(() => ''),
      fs.readFile(jsonPath, 'utf8').catch(() => '')
    ]);
    initialCodeGs = c;
    initialAppsscriptJson = m;
  } catch (err) {
    console.error('[Admin Apps Script] Error reading script files:', err);
  }
}
---

<SiteLayout
  title="Quản trị kết nối Google Sheets | Nam Hân Logistics"
  description="Trang cấu hình kết nối Google Sheets nhận dữ liệu form liên hệ tự động cho Nam Hân Logistics."
  hidePublicNav={true}
  noindex={true}
>
  {isAdmin && <AdminHeader activeTab="google-sheets" />}

  <main class="admin-main">
    <div class="container admin-container">
      {/* Case 1: Not logged in */}
      {!isAdmin ? (
        <AdminLoginForm />
      ) : (
        /* Case 2: Logged in Dashboard */
        <div class="dashboard-grid">
          {/* Header */}
          <header class="admin-header">
            <div class="admin-badge">HỆ THỐNG NỘI BỘ</div>
            <h1 class="admin-title">Cấu hình tiếp nhận Google Sheets</h1>
            <p class="admin-desc">
              Tự động lưu yêu cầu vận chuyển từ biểu mẫu website vào Google Sheets qua Google Apps Script Web App.
            </p>
          </header>

          {/* Notifications */}
          {successParam && (
            <div class="alert alert-success" role="alert">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                <polyline points="22 4 12 14.01 9 11.01"/>
              </svg>
              <div>
                <strong>Thao tác thành công!</strong> Cấu hình tiếp nhận Google Sheets đã được cập nhật an toàn.
              </div>
            </div>
          )}

          {errorParam && (
            <div class="alert alert-danger" role="alert">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <line x1="15" y1="9" x2="9" y2="15"/>
                <line x1="9" y1="9" x2="15" y2="15"/>
              </svg>
              <div>
                <strong>Lỗi kết nối:</strong> {decodeURIComponent(errorParam)}
              </div>
            </div>
          )}

          {/* Current Active Channel Status Banner */}
          <div class={`active-channel-banner ${isConnected ? 'banner-active' : 'banner-warning'}`}>
            <div class="banner-icon">
              {isConnected ? (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2">
                  <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                  <polyline points="22 4 12 14.01 9 11.01"/>
                </svg>
              ) : (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2">
                  <circle cx="12" cy="12" r="10"/>
                  <line x1="12" y1="8" x2="12" y2="12"/>
                  <line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
              )}
            </div>
            <div class="banner-content">
              <div class="banner-title">
                {isConnected
                  ? '🟢 Kênh đang nhận dữ liệu: Google Apps Script Web App (Đang hoạt động)'
                  : '⚪ Kênh tiếp nhận Google Sheets chưa được kết nối'}
              </div>
              <p class="banner-desc">
                {isConnected
                  ? 'Mỗi lượt gửi từ form website sẽ được gửi bảo mật qua Web App và tự động ghi thẳng vào bảng tính Google Sheets theo thời gian thực (chống trùng lặp, chống formula injection).'
                  : 'Vui lòng làm theo hướng dẫn từng bước bên dưới để tạo bảng tính, dán mã kịch bản và kết nối URL Web App.'}
              </p>
            </div>
          </div>

          {/* Section 1: Active Connection Status Card (If configured) */}
          {isConnected && appsConn && (
            <section class="card mb-4" aria-labelledby="apps-status-heading">
              <div class="card-header-flex">
                <div>
                  <h2 id="apps-status-heading" class="card-title">Trạng thái kết nối Google Sheets hiện tại</h2>
                  <p class="card-subtitle">Kịch bản Web App tiếp nhận dữ liệu và tự động ghi vào trang tính.</p>
                </div>
                <div class="badges-group">
                  <span class="badge badge-active">🟢 Đang nhận form</span>
                </div>
              </div>

              <div class="connection-details">
                <div class="detail-row">
                  <span class="detail-label">Tên bảng tính:</span>
                  <strong class="detail-value">{appsConn.sheetTitle || 'Khách hàng Nam Hân'}</strong>
                </div>

                <div class="detail-row">
                  <span class="detail-label">URL Web App:</span>
                  <code class="detail-code text-truncate">{appsConn.webAppUrl}</code>
                </div>

                <div class="detail-row">
                  <span class="detail-label">Khóa kết nối:</span>
                  <span class="detail-value text-muted">•••••••••••••••• (Đã mã hóa AES-256 an toàn)</span>
                </div>

                <div class="detail-row">
                  <span class="detail-label">Thời gian kết nối:</span>
                  <span class="detail-value">{new Date(appsConn.connectedAt).toLocaleString('vi-VN')}</span>
                </div>

                {appsConn.sheetUrl && (
                  <div class="detail-row">
                    <span class="detail-label">Mở Google Sheets:</span>
                    <a href={appsConn.sheetUrl} target="_blank" rel="noopener noreferrer" class="link-external">
                      <span>Mở trực tiếp bảng tính</span>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                        <polyline points="15 3 21 3 21 9"/>
                        <line x1="10" y1="14" x2="21" y2="3"/>
                      </svg>
                    </a>
                  </div>
                )}
              </div>

              <div class="action-buttons-group mt-3 pt-3 border-top">
                <button type="button" id="btnRetestAppsScript" class="btn btn-outline">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"/>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                  </svg>
                  <span>Kiểm tra lại kết nối</span>
                </button>
              </div>
            </section>
          )}

          {/* Section 2: Setup / Update Form Card */}
          <section class="card mb-4" aria-labelledby="apps-setup-heading">
            <h2 id="apps-setup-heading" class="card-title">
              {isConnected ? 'Cập nhật cấu hình kết nối Web App' : 'Thiết lập kết nối Google Sheets (Apps Script)'}
            </h2>
            <p class="card-subtitle">
              Điền URL Web App và Khóa kết nối bí mật đã được sinh từ menu "Nam Hân" trong Google Sheets.
            </p>

            {/* Dynamic Alert Box for AJAX Actions */}
            <div id="appsScriptAlert" class="alert mt-3" style="display: none;" role="alert"></div>

            <form id="appsScriptForm" class="apps-form mt-4">
              <div class="form-group">
                <label for="webAppUrl" class="form-label required">URL Ứng dụng Web (Web App URL)</label>
                <input
                  type="url"
                  id="webAppUrl"
                  name="webAppUrl"
                  class="form-input"
                  placeholder="https://script.google.com/macros/s/AKfycb.../exec"
                  value={appsConn?.webAppUrl || ''}
                  required
                />
                <small class="form-hint">
                  Lấy từ nút: <strong>Triển khai (Deploy) &rarr; Quản lý bản triển khai &rarr; URL ứng dụng web (kết thúc bằng /exec)</strong>.
                </small>
              </div>

              <div class="form-group">
                <label for="apiKey" class="form-label required">Khóa kết nối bí mật (Connection Key)</label>
                <div class="password-input-wrap">
                  <input
                    type="password"
                    id="apiKey"
                    name="apiKey"
                    class="form-input password-input"
                    placeholder="nhl_sec_..."
                    required
                  />
                  <button type="button" id="btnToggleApiKey" class="btn-toggle-pw" title="Ẩn/Hiện khóa">
                    👁️
                  </button>
                </div>
                <small class="form-hint">
                  Lấy từ bảng tính: Bấm menu <strong>"🚛 Nam Hân" &rarr; "🔑 Kiểm tra cấu hình & Khóa kết nối"</strong> để sao chép.
                </small>
              </div>

              <div class="form-group">
                <label for="sheetUrl" class="form-label">Đường dẫn Google Sheets (Tùy chọn)</label>
                <input
                  type="url"
                  id="sheetUrl"
                  name="sheetUrl"
                  class="form-input"
                  placeholder="https://docs.google.com/spreadsheets/d/.../edit"
                  value={appsConn?.sheetUrl || ''}
                />
                <small class="form-hint">
                  Dán link bảng tính để thuận tiện mở xem nhanh từ giao diện quản trị này.
                </small>
              </div>

              <div class="form-actions mt-4 pt-3 border-top">
                <button type="button" id="btnTestAppsScript" class="btn btn-outline">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"/>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                  </svg>
                  <span>Kiểm tra kết nối</span>
                </button>

                <button type="button" id="btnSaveAppsScript" class="btn btn-primary">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
                    <polyline points="17 21 17 13 7 13 7 21"/>
                    <polyline points="7 3 7 8 15 8"/>
                  </svg>
                  <span>Lưu & Kích hoạt nhận dữ liệu</span>
                </button>
              </div>
            </form>
          </section>

          {/* Section 3: In-Browser Code Editor & Viewer */}
          <section class="card mb-4" aria-labelledby="editor-heading">
            <div class="card-header-flex">
              <div>
                <div class="tag-badge">TRÌNH CHỈNH SỬA & SAO CHÉP MÃ</div>
                <h2 id="editor-heading" class="card-title mt-1">Mã kịch bản Google Apps Script</h2>
                <p class="card-subtitle">
                  Bạn có thể xem, chỉnh sửa trực tiếp mã nguồn tại đây, bấm lưu để lưu vào website hoặc sao chép 1-click để dán vào Google Sheet.
                </p>
              </div>
            </div>

            {/* Code action status notice */}
            <div id="codeAlert" class="alert mt-2" style="display: none;" role="alert"></div>

            <div class="code-editor-wrapper">
              <div class="code-editor-header">
                <div class="code-file-tabs">
                  <button type="button" class="code-tab-btn active" id="tabCodeGs">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                      <polyline points="14 2 14 8 20 8"/>
                    </svg>
                    <span>Code.gs (Kịch bản chính)</span>
                  </button>
                  <button type="button" class="code-tab-btn" id="tabManifest">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <polyline points="16 18 22 12 16 6"/>
                      <polyline points="8 6 2 12 8 18"/>
                    </svg>
                    <span>appsscript.json (Cấu hình)</span>
                  </button>
                </div>

                <div class="code-actions">
                  <button type="button" class="btn-code-action btn-copy-code" id="btnCopyCode" title="Sao chép toàn bộ mã vào bộ nhớ tạm">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
                      <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
                    </svg>
                    <span id="copyCodeText">Sao chép mã (1 Click)</span>
                  </button>

                  <button type="button" class="btn-code-action btn-save-code" id="btnSaveCode" title="Lưu thay đổi trực tiếp vào hệ thống">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
                      <polyline points="17 21 17 13 7 13 7 21"/>
                      <polyline points="7 3 7 8 15 8"/>
                    </svg>
                    <span id="saveCodeText">Lưu vào hệ thống</span>
                  </button>

                  <button type="button" class="btn-code-action btn-reload-code" id="btnReloadCode" title="Tải lại mã gốc từ máy chủ">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/>
                      <path d="M21 3v5h-5"/>
                      <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/>
                      <path d="M8 16H3v5"/>
                    </svg>
                    <span>Nạp lại</span>
                  </button>
                </div>
              </div>

              {/* Textareas for editing */}
              <div class="code-editor-body">
                <textarea
                  id="editorCodeGs"
                  class="code-textarea active"
                  spellcheck="false"
                  placeholder="Đang tải mã nguồn Code.gs..."
                >{initialCodeGs}</textarea>

                <textarea
                  id="editorManifest"
                  class="code-textarea"
                  spellcheck="false"
                  placeholder="Đang tải tệp appsscript.json..."
                >{initialAppsscriptJson}</textarea>
              </div>
            </div>

            {/* Feature Highlights built into Code.gs */}
            <div class="code-features-grid mt-3">
              <div class="feature-pill">
                <span class="pill-icon">📐</span>
                <span class="pill-text">Tự động giãn dòng <strong>42px</strong> & căn giữa <em>(vertical-align: middle)</em></span>
              </div>
              <div class="feature-pill">
                <span class="pill-icon">0️⃣</span>
                <span class="pill-text">Khóa dạng chuỗi cho <strong>SĐT & Mã yêu cầu</strong> <em>(giữ nguyên số 0 đầu)</em></span>
              </div>
              <div class="feature-pill">
                <span class="pill-icon">📋</span>
                <span class="pill-text">Tự tạo dropdown <strong>4 Trạng thái xử lý</strong></span>
              </div>
              <div class="feature-pill">
                <span class="pill-icon">📝</span>
                <span class="pill-text">Nhận trường <strong>Ghi chú</strong> (Cột 13) từ form liên hệ website</span>
              </div>
              <div class="feature-pill">
                <span class="pill-icon">🛡️</span>
                <span class="pill-text">Chống trùng lặp dữ liệu bằng <strong>LockService 25 giây</strong></span>
              </div>
              <div class="feature-pill">
                <span class="pill-icon">🛡️</span>
                <span class="pill-text">Chống chèn mã độc <strong>Formula Injection (=, +, -, @)</strong></span>
              </div>
            </div>
          </section>

          {/* Section 4: Expanded Step-by-Step Master Guide (For Non-Programmers) */}
          <section class="card mb-4" aria-labelledby="guide-heading">
            <div class="card-header-flex">
              <div>
                <div class="tag-badge tag-guide">HƯỚNG DẪN DỄ HIỂU</div>
                <h2 id="guide-heading" class="card-title mt-1">Cẩm nang hướng dẫn cài đặt & bàn giao chi tiết</h2>
                <p class="card-subtitle">
                  Dành riêng cho người quản trị không cần biết code. Hãy làm theo đúng 7 bước đơn giản bên dưới:
                </p>
              </div>
            </div>

            <div class="steps-flow">
              {/* Step 1 */}
              <div class="guide-step-card">
                <div class="step-badge">BƯỚC 1</div>
                <div class="step-content">
                  <h3 class="step-title">Tạo bảng tính Google Sheets mới</h3>
                  <p class="step-desc">
                    Truy cập vào <a href="https://sheets.google.com" target="_blank" rel="noopener noreferrer" class="link-inline">Google Sheets (sheets.google.com) ↗</a>, đăng nhập tài khoản Google của công ty hoặc tài khoản của bạn, sau đó bấm <strong>+ Bảng tính trống (Blank)</strong>. Đặt tên file, ví dụ: <code>Khách hàng Nam Hân Logistics</code>.
                  </p>
                </div>
              </div>

              {/* Step 2 */}
              <div class="guide-step-card">
                <div class="step-badge">BƯỚC 2</div>
                <div class="step-content">
                  <h3 class="step-title">Mở Apps Script & Dán mã nguồn</h3>
                  <div class="step-desc">
                    <ol class="step-sublist">
                      <li>Trên thanh menu trên cùng của Google Sheet, bấm <strong>Tiện ích mở rộng (Extensions)</strong> &rarr; chọn <strong>Apps Script</strong>.</li>
                      <li>Trong màn hình soạn thảo code mở ra, hãy xóa hết đoạn mã mẫu <code>function myFunction() &#123;&#125;</code> có sẵn.</li>
                      <li>Quay lại trang này, nhìn lên khung <strong>Mã kịch bản Google Apps Script</strong> ở trên và bấm nút <strong>"📋 Sao chép mã (1 Click)"</strong>.</li>
                      <li>Dán toàn bộ mã vừa sao chép vào ô soạn thảo của Google Apps Script.</li>
                      <li>Bấm biểu tượng 💾 <strong>Lưu dự án</strong> (hoặc nhấn phím tắt <code>Ctrl + S</code>).</li>
                    </ol>
                  </div>
                </div>
              </div>

              {/* Step 3 */}
              <div class="guide-step-card highlight-step">
                <div class="step-badge badge-danger">BƯỚC 3 (QUAN TRỌNG)</div>
                <div class="step-content">
                  <h3 class="step-title">Khởi tạo bảng & Cấp quyền Google</h3>
                  <div class="step-desc">
                    <ol class="step-sublist">
                      <li>Quay lại tab Google Sheet và bấm <strong>Tải lại trang (F5)</strong>.</li>
                      <li>Bạn sẽ thấy xuất hiện một menu mới có tên là <strong>"🚛 Nam Hân"</strong> nằm cạnh menu Trợ giúp.</li>
                      <li>Bấm menu <strong>"🚛 Nam Hân" &rarr; chọn "⚙️ Khởi tạo / Kiểm tra cấu hình bảng"</strong>.</li>
                      <li>Một cửa sổ nhỏ hiện lên thông báo <em>"Cần được cấp quyền" (Authorization Required)</em>. Bấm <strong>Tiếp tục (Continue)</strong> &rarr; Chọn tài khoản Google của bạn.</li>
                    </ol>

                    <div class="alert alert-callout mt-2">
                      <div class="callout-header">
                        <strong>⚠️ HƯỚNG DẪN VƯỢT QUA MÀN HÌNH CẢNH BÁO "Google chưa xác minh ứng dụng này":</strong>
                      </div>
                      <p class="callout-text">
                        Khi Google hiện màn hình cảnh báo có dấu chấm than đỏ <em>"Google chưa xác minh ứng dụng này" (Google hasn't verified this app)</em>: Đừng lo lắng, đây là cảnh báo chuẩn của Google cho code tự viết.
                      </p>
                      <ul class="callout-steps">
                        <li>Bấm vào dòng chữ nhỏ <strong>"Nâng cao" (Advanced)</strong> ở góc dưới bên trái màn hình cảnh báo.</li>
                        <li>Bấm tiếp vào liên kết <strong>"Đi tới Kịch bản tiếp nhận Nam Hân Logistics (không an toàn)"</strong> / <em>"Go to ... (unsafe)"</em>.</li>
                        <li>Kéo xuống và bấm nút <strong>"Cho phép" (Allow)</strong>.</li>
                      </ul>
                      <p class="callout-sub">
                        <em>Sau khi cấp quyền xong, Google Sheet sẽ tự động kẻ 13 cột với màu xanh thương hiệu Nam Hân, tự động ghim hàng tiêu đề, tạo bộ lọc, tạo dropdown trạng thái và sinh mã khóa bí mật.</em>
                      </p>
                    </div>
                  </div>
                </div>
              </div>

              {/* Step 4 */}
              <div class="guide-step-card">
                <div class="step-badge">BƯỚC 4</div>
                <div class="step-content">
                  <h3 class="step-title">Triển khai Web App (Nhận dữ liệu)</h3>
                  <div class="step-desc">
                    <ol class="step-sublist">
                      <li>Quay lại tab Apps Script, nhìn lên góc trên bên phải bấm nút màu xanh <strong>Triển khai (Deploy)</strong> &rarr; chọn <strong>Bản triển khai mới (New deployment)</strong>.</li>
                      <li>Bấm vào biểu tượng Bánh răng ⚙️ (Chọn loại) &rarr; Chọn <strong>Ứng dụng web (Web app)</strong>.</li>
                      <li>
                        Cấu hình chính xác 2 mục bắt buộc sau:
                        <ul class="sub-bullets">
                          <li><strong>Thực thi dưới dạng (Execute as):</strong> Chọn <code>Tôi (địa_chỉ_email_của_bạn)</code>.</li>
                          <li><strong>Ai có quyền truy cập (Who has access):</strong> Chọn <code>Bất kỳ ai (Anyone)</code> <em>(Bắt buộc để máy chủ website có thể gửi dữ liệu vào mà không bị Google chặn).</em></li>
                        </ul>
                      </li>
                      <li>Bấm nút <strong>Triển khai (Deploy)</strong>.</li>
                      <li>Sao chép đường link ở mục <strong>URL ứng dụng web</strong> (đường link kết thúc bằng chữ <code>/exec</code>).</li>
                    </ol>
                  </div>
                </div>
              </div>

              {/* Step 5 */}
              <div class="guide-step-card">
                <div class="step-badge">BƯỚC 5</div>
                <div class="step-content">
                  <h3 class="step-title">Lấy Khóa kết nối & Hoàn tất trên website</h3>
                  <div class="step-desc">
                    <ol class="step-sublist">
                      <li>Quay lại tab Google Sheet, bấm menu <strong>"🚛 Nam Hân" &rarr; chọn "🔑 Kiểm tra cấu hình & Khóa kết nối"</strong>.</li>
                      <li>Một hộp thoại hiện ra, hãy sao chép toàn bộ chuỗi <strong>Khóa kết nối bí mật</strong> (dạng <code>nhl_sec_...</code>).</li>
                      <li>Quay lại trang quản trị này, dán <strong>URL Web App</strong> (bước 4) và <strong>Khóa kết nối</strong> (bước 5) vào biểu mẫu ở khung phía trên.</li>
                      <li>Bấm nút <strong>"Kiểm tra kết nối"</strong>. Khi có thông báo màu xanh thành công, hãy bấm <strong>"Lưu & Kích hoạt nhận dữ liệu"</strong>. Hoàn tất!</li>
                    </ol>
                  </div>
                </div>
              </div>

              {/* Step 6 */}
              <div class="guide-step-card highlight-step">
                <div class="step-badge badge-warning">BƯỚC 6 (KHI CẬP NHẬT CODE)</div>
                <div class="step-content">
                  <h3 class="step-title">Cách cập nhật mã mới cho Google Sheets (Dành cho lần sau)</h3>
                  <div class="step-desc">
                    <p>
                      Khi bạn chỉnh sửa mã nguồn trực tiếp trong ô soạn thảo ở trên (hoặc copy code mới), để Google Sheets thực sự chạy mã mới, <strong>BẮT BUỘC</strong> phải làm theo 4 thao tác sau:
                    </p>
                    <ol class="step-sublist">
                      <li>Bấm <strong>"Lưu vào hệ thống"</strong> trên web & bấm <strong>"📋 Sao chép mã"</strong>.</li>
                      <li>Vào tab Apps Script, dán đè lên toàn bộ code cũ và bấm Lưu (<code>Ctrl + S</code>).</li>
                      <li>
                        Nhìn lên góc trên bên phải, bấm nút <strong>Triển khai (Deploy)</strong> &rarr; Chọn <strong>Quản lý bản triển khai (Manage deployments)</strong>.
                      </li>
                      <li>
                        Bấm vào biểu tượng <strong>Cây bút chì ✏️ (Chỉnh sửa / Edit)</strong> ở góc trên bên phải của bảng triển khai:
                        <ul class="sub-bullets">
                          <li>Tại dòng <strong>Phiên bản (Version)</strong>: Bấm vào menu thả xuống và chọn <strong>"Phiên bản mới" (New version)</strong>.</li>
                          <li>Bấm nút màu xanh <strong>Triển khai (Deploy)</strong> & bấm <strong>Xong (Done)</strong>.</li>
                        </ul>
                      </li>
                    </ol>
                    <div class="alert alert-tip mt-2">
                      💡 <strong>Mẹo sống còn:</strong> Nếu không chọn <em>"Phiên bản mới" (New version)</em>, Google sẽ mãi mãi chạy phiên bản code cũ và không áp dụng bất kỳ thay đổi nào mới sửa!
                    </div>
                  </div>
                </div>
              </div>

              {/* Step 7 */}
              <div class="guide-step-card">
                <div class="step-badge">BƯỚC 7</div>
                <div class="step-content">
                  <h3 class="step-title">Tối ưu chiều cao dòng & Làm đẹp bảng bất cứ lúc nào</h3>
                  <p class="step-desc">
                    Trong quá trình sử dụng Google Sheet, nếu có dòng nào chữ bị chật hoặc muốn giãn cách dòng 42px thông thoáng và căn giữa thẳng thớm, bạn chỉ cần mở Google Sheet và bấm:
                    <br />
                    <strong>Menu "🚛 Nam Hân" &rarr; "✨ Tối ưu chiều cao & Làm đẹp bảng"</strong>. Bảng tính sẽ tự động làm mới giao diện ngay lập tức mà không làm mất bất kỳ dữ liệu nào.
                  </p>
                </div>
              </div>
            </div>

            {/* Troubleshooting / FAQ Accordion */}
            <div class="faq-container mt-4 pt-4 border-top">
              <h3 class="faq-heading">❓ Các câu hỏi & Xử lý sự cố thường gặp (FAQ)</h3>

              <details class="faq-item">
                <summary class="faq-summary">
                  <span>Bấm "Kiểm tra kết nối" báo lỗi: "Khóa kết nối bí mật không chính xác hoặc đã bị thay đổi"?</span>
                </summary>
                <div class="faq-answer">
                  <p>
                    Khóa kết nối được tạo ngẫu nhiên và lưu bên trong Script Properties của Google Sheet. Bạn hãy vào lại Google Sheet, bấm menu <strong>"🚛 Nam Hân" &rarr; "🔑 Kiểm tra cấu hình & Khóa kết nối"</strong>, sao chép lại toàn bộ chuỗi ký tự hiển thị trong hộp thoại rồi dán lại vào ô "Khóa kết nối bí mật" trên web này.
                  </p>
                </div>
              </details>

              <details class="faq-item">
                <summary class="faq-summary">
                  <span>Khách gửi form báo thành công nhưng không thấy dòng mới xuất hiện trong Sheet?</span>
                </summary>
                <div class="faq-answer">
                  <p>
                    Nguyên nhân phổ biến nhất là lúc Triển khai Web App bạn chưa chọn <strong>"Ai có quyền truy cập: Bất kỳ ai" (Anyone)</strong>. Hãy vào Apps Script &rarr; Triển khai &rarr; Quản lý bản triển khai &rarr; Bút chì ✏️ &rarr; kiểm tra lại mục "Ai có quyền truy cập" phải là <strong>Bất kỳ ai (Anyone)</strong> &rarr; Chọn "Phiên bản mới" &rarr; Triển khai lại.
                  </p>
                </div>
              </details>

              <details class="faq-item">
                <summary class="faq-summary">
                  <span>Có cần phải mở máy tính hoặc mở tab Google Sheet 24/7 không?</span>
                </summary>
                <div class="faq-answer">
                  <p>
                    <strong>Hoàn toàn không cần!</strong> Google Apps Script chạy trực tiếp trên máy chủ điện toán đám mây của Google 24/7. Bất kể khi nào khách gửi đơn trên website, dữ liệu sẽ tự động được ghi vào bảng tính ngay lập tức.
                  </p>
                </div>
              </details>

              <details class="faq-item">
                <summary class="faq-summary">
                  <span>Khi muốn bàn giao cho tài khoản Google của nhân viên khác thì làm sao?</span>
                </summary>
                <div class="faq-answer">
                  <p>
                    Rất đơn giản! Nhân viên mới chỉ cần tạo một Google Sheet mới trên tài khoản của họ, làm theo Bước 1 đến Bước 5 ở trên để lấy URL Web App và Khóa kết nối mới, rồi dán vào trang quản trị này và bấm Lưu. Hệ thống website sẽ ngay lập tức chuyển sang ghi dữ liệu vào bảng của nhân viên mới một cách an toàn mà không làm mất dữ liệu cũ.
                  </p>
                </div>
              </details>
            </div>


          </section>

          {/* Section 5: Quick Links & Actions Card */}
          <section class="card" aria-labelledby="links-heading">
