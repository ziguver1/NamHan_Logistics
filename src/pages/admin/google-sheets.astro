  .mt-2 { margin-top: 0.5rem; }
  .mt-3 { margin-top: 0.75rem; }
  .mt-4 { margin-top: 1rem; }
  .mb-4 { margin-bottom: 1rem; }
  .pt-3 { padding-top: 0.75rem; }
  .pt-4 { padding-top: 1rem; }

  .flex-between {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .action-buttons-group {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
</style>

<script>
  // =========================================================================
  // 1. Password Visibility Toggle
  // =========================================================================
  const btnToggleApiKey = document.getElementById('btnToggleApiKey');
  const apiKeyInput = document.getElementById('apiKey') as HTMLInputElement | null;
  btnToggleApiKey?.addEventListener('click', () => {
    if (apiKeyInput) {
      if (apiKeyInput.type === 'password') {
        apiKeyInput.type = 'text';
        btnToggleApiKey.textContent = '🙈';
      } else {
        apiKeyInput.type = 'password';
        btnToggleApiKey.textContent = '👁️';
      }
    }
  });

  // =========================================================================
  // 2. Alert Box Helpers
  // =========================================================================
  const appsAlert = document.getElementById('appsScriptAlert');
  function showAppsAlert(type: 'success' | 'danger' | 'warning', text: string) {
    if (!appsAlert) return;
    appsAlert.className = `alert alert-${type} mt-3`;
    appsAlert.innerHTML = text;
    appsAlert.style.display = 'block';
  }

  const codeAlert = document.getElementById('codeAlert');
  function showCodeAlert(type: 'success' | 'danger' | 'warning', text: string) {
    if (!codeAlert) return;
    codeAlert.className = `alert alert-${type} mt-2`;
    codeAlert.innerHTML = text;
    codeAlert.style.display = 'block';
    setTimeout(() => {
      if (codeAlert && type === 'success') {
        codeAlert.style.display = 'none';
      }
    }, 6000);
  }

  // =========================================================================
  // 3. Test & Save Apps Script Connection Form
  // =========================================================================
  const btnTestAppsScript = document.getElementById('btnTestAppsScript');
  const btnRetestAppsScript = document.getElementById('btnRetestAppsScript');

  async function handleTestAppsScript() {
    const webAppUrl = (document.getElementById('webAppUrl') as HTMLInputElement)?.value.trim();
    const apiKey = (document.getElementById('apiKey') as HTMLInputElement)?.value.trim();

    if (!webAppUrl || !apiKey) {
      showAppsAlert('warning', 'Vui lòng nhập cả URL Web App và Khóa kết nối trước khi kiểm tra.');
      return;
    }

    if (btnTestAppsScript) {
      btnTestAppsScript.setAttribute('disabled', 'true');
      btnTestAppsScript.textContent = 'Đang kiểm tra kết nối...';
    }

    try {
      const res = await fetch('/api/admin/apps-script/test', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ webAppUrl, apiKey })
      });
      const data = await res.json();

      if (data.success) {
        showAppsAlert(
          'success',
          `✅ <strong>Kết nối thành công!</strong> ${data.message} (Bảng tính: <em>${data.sheetTitle || 'Khách hàng Nam Hân'}</em>)`
        );
      } else {
        showAppsAlert('danger', `❌ <strong>Thất bại:</strong> ${data.error || 'Không thể kết nối.'}`);
      }
    } catch {
      showAppsAlert('danger', '❌ <strong>Lỗi kết nối:</strong> Không thể gửi yêu cầu kiểm tra tới máy chủ.');
    } finally {
      if (btnTestAppsScript) {
        btnTestAppsScript.removeAttribute('disabled');
        btnTestAppsScript.innerHTML = `
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"/>
            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
          <span>Kiểm tra kết nối</span>
        `;
      }
    }
  }

  btnTestAppsScript?.addEventListener('click', handleTestAppsScript);
  btnRetestAppsScript?.addEventListener('click', () => {
    const apiKey = (document.getElementById('apiKey') as HTMLInputElement)?.value.trim();
    if (!apiKey) {
      apiKeyInput?.focus();
      showAppsAlert('warning', 'Vui lòng nhập lại Khóa kết nối bí mật để kiểm tra lại.');
    } else {
      handleTestAppsScript();
    }
  });

  const btnSaveAppsScript = document.getElementById('btnSaveAppsScript');
  btnSaveAppsScript?.addEventListener('click', async () => {
    const webAppUrl = (document.getElementById('webAppUrl') as HTMLInputElement)?.value.trim();
    const apiKey = (document.getElementById('apiKey') as HTMLInputElement)?.value.trim();
    const sheetUrl = (document.getElementById('sheetUrl') as HTMLInputElement)?.value.trim();

    if (!webAppUrl || !apiKey) {
      showAppsAlert('warning', 'Vui lòng điền đầy đủ URL Web App và Khóa kết nối bí mật.');
      return;
    }

    btnSaveAppsScript.setAttribute('disabled', 'true');
    btnSaveAppsScript.textContent = 'Đang lưu & kích hoạt...';

    try {
      const res = await fetch('/api/admin/apps-script/save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ webAppUrl, apiKey, sheetUrl, activateImmediately: true })
      });
      const data = await res.json();

      if (data.success) {
        alert(data.message || 'Lưu cấu hình thành công!');
        window.location.href = '/admin/google-sheets?success=appsscript_saved';
      } else {
        showAppsAlert('danger', `❌ <strong>Lưu cấu hình thất bại:</strong> ${data.error}`);
        btnSaveAppsScript.removeAttribute('disabled');
        btnSaveAppsScript.innerHTML = `
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
            <polyline points="17 21 17 13 7 13 7 21"/>
            <polyline points="7 3 7 8 15 8"/>
          </svg>
          <span>Lưu & Kích hoạt nhận dữ liệu</span>
        `;
      }
    } catch {
      showAppsAlert('danger', '❌ Lỗi kết nối máy chủ khi lưu cấu hình.');
      btnSaveAppsScript.removeAttribute('disabled');
    }
  });

  // =========================================================================
  // 4. In-Browser Code Editor Logic (Tabs, Copy, Save, Reload)
  // =========================================================================
  const tabCodeGs = document.getElementById('tabCodeGs');
  const tabManifest = document.getElementById('tabManifest');
  const editorCodeGs = document.getElementById('editorCodeGs') as HTMLTextAreaElement | null;
  const editorManifest = document.getElementById('editorManifest') as HTMLTextAreaElement | null;
  let activeCodeTab: 'code' | 'manifest' = 'code';

  tabCodeGs?.addEventListener('click', () => {
    activeCodeTab = 'code';
    tabCodeGs.classList.add('active');
    tabManifest?.classList.remove('active');
    editorCodeGs?.classList.add('active');
    editorManifest?.classList.remove('active');
  });

  tabManifest?.addEventListener('click', () => {
    activeCodeTab = 'manifest';
    tabManifest.classList.add('active');
    tabCodeGs?.classList.remove('active');
    editorManifest?.classList.add('active');
    editorCodeGs?.classList.remove('active');
  });

  // 4.1 Copy active code to clipboard
  const btnCopyCode = document.getElementById('btnCopyCode');
  const copyCodeText = document.getElementById('copyCodeText');

  btnCopyCode?.addEventListener('click', async () => {
    const textToCopy = activeCodeTab === 'code' ? editorCodeGs?.value : editorManifest?.value;
    if (!textToCopy) {
      showCodeAlert('warning', 'Không có nội dung mã để sao chép.');
      return;
    }

    try {
      await navigator.clipboard.writeText(textToCopy);
      if (copyCodeText) copyCodeText.textContent = '✅ Đã sao chép!';
      showCodeAlert(
        'success',
        `📋 <strong>Đã sao chép ${activeCodeTab === 'code' ? 'Code.gs' : 'appsscript.json'} vào bộ nhớ tạm!</strong> Bạn có thể mở Google Apps Script và dán (Ctrl + V) ngay.`
      );
      setTimeout(() => {
        if (copyCodeText) copyCodeText.textContent = 'Sao chép mã (1 Click)';
      }, 2500);
    } catch {
      showCodeAlert('danger', 'Không thể tự động sao chép. Vui lòng bấm vào ô code và nhấn Ctrl + A rồi Ctrl + C.');
    }
  });

  // 4.2 Save modified code back to server
  const btnSaveCode = document.getElementById('btnSaveCode');
  const saveCodeText = document.getElementById('saveCodeText');

  btnSaveCode?.addEventListener('click', async () => {
    const code = editorCodeGs?.value || '';
    const manifest = editorManifest?.value || '';

    if (btnSaveCode) {
      btnSaveCode.setAttribute('disabled', 'true');
      if (saveCodeText) saveCodeText.textContent = 'Đang lưu...';
    }

    try {
      const res = await fetch('/api/admin/apps-script/code', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ code, manifest })
      });
      const data = await res.json();

      if (data.success) {
        const timeStr = new Date().toLocaleTimeString('vi-VN');
        showCodeAlert(
          'success',
          `💾 <strong>Đã lưu thay đổi vào hệ thống lúc ${timeStr}!</strong> Nhớ bấm nút <em>"Sao chép mã"</em> và dán sang Google Sheet, sau đó chọn <strong>"Phiên bản mới" (New version)</strong> khi Triển khai để có hiệu lực.`
        );
      } else {
        showCodeAlert('danger', `❌ Lỗi khi lưu mã: ${data.error}`);
      }
    } catch {
      showCodeAlert('danger', '❌ Lỗi kết nối máy chủ khi lưu mã.');
    } finally {
      if (btnSaveCode) {
        btnSaveCode.removeAttribute('disabled');
        if (saveCodeText) saveCodeText.textContent = 'Lưu vào hệ thống';
      }
    }
  });

  // 4.3 Reload code from server
  const btnReloadCode = document.getElementById('btnReloadCode');
  btnReloadCode?.addEventListener('click', async () => {
    if (!confirm('Bạn có chắc muốn tải lại mã nguồn gốc từ máy chủ? Các chỉnh sửa chưa lưu sẽ bị hủy.')) return;
    try {
      const res = await fetch('/api/admin/apps-script/code');
      const data = await res.json();
      if (data.success) {
        if (editorCodeGs && typeof data.code === 'string') editorCodeGs.value = data.code;
        if (editorManifest && typeof data.manifest === 'string') editorManifest.value = data.manifest;
        showCodeAlert('success', '🔄 Đã nạp lại mã nguồn mới nhất từ máy chủ.');
      } else {
        showCodeAlert('danger', `Lỗi tải lại mã: ${data.error}`);
      }
    } catch {
      showCodeAlert('danger', 'Lỗi kết nối máy chủ khi tải lại mã.');
    }
  });
</script>
