---
/**
 * Public Announcement Detail Page
 * SSR Route: Displays full official notice, cover image, sanitized content, and attachments.
 * Protected preview for drafts.
 */
import SiteLayout from '@/layouts/SiteLayout.astro';
import { getAnnouncementBySlug } from '@/lib/server/news-storage';
import { isAuthenticatedAdmin } from '@/lib/server/admin-auth';
import { ROUTES } from '@/lib/routes';
import { companyInfo } from '@/content/company';

export const prerender = false;

const { slug } = Astro.params;
if (!slug) {
  return new Response(null, { status: 404 });
}

const announcement = await getAnnouncementBySlug(slug);

// Handle non-existent or deleted articles
if (!announcement || announcement.status === 'deleted') {
  return new Response(null, { status: 404 });
}

// Handle draft articles: ONLY authenticated admins can preview
const isAdmin = await isAuthenticatedAdmin(Astro.request);
const isDraft = announcement.status === 'draft';

if (isDraft) {
  if (!isAdmin) {
    return new Response(null, { status: 404 });
  }
  // Ensure preview is never cached publicly
  Astro.response.headers.set('Cache-Control', 'private, no-store, must-revalidate');
} else {
  // Published article: standard public caching
  Astro.response.headers.set('Cache-Control', 'public, max-age=300, stale-while-revalidate=86400');
}
---

<SiteLayout
  title={`${announcement.title} | Bảng tin ${companyInfo.shortName}`}
  description={announcement.summary}
  canonicalPath={`/bang-tin/${announcement.slug}`}
>
  <!-- Draft Preview Notice Banner (For Admins Only) -->
  {isDraft && (
    <div class="draft-preview-banner" role="alert">
      <div class="container draft-banner-inner">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/>
          <line x1="12" y1="9" x2="12" y2="13"/>
          <line x1="12" y1="17" x2="12.01" y2="17"/>
        </svg>
        <div>
          <strong>BẢN XEM TRƯỚC (DRAFT):</strong> Thông báo này đang ở trạng thái nháp và chưa xuất bản công khai. Chỉ quản trị viên đã đăng nhập mới thấy trang này.
        </div>
        <a href={`/admin/bang-tin/editor?id=${announcement.id}`} class="btn-draft-edit">Chỉnh sửa bài này</a>
      </div>
    </div>
  )}

  <main class="article-page">
    <!-- Breadcrumb Bar -->
    <div class="breadcrumb-bar">
      <div class="container">
        <nav aria-label="Breadcrumb">
          <ol class="breadcrumb-list">
            <li><a href={ROUTES.HOME} class="breadcrumb-link">Trang chủ</a></li>
            <li class="breadcrumb-separator" aria-hidden="true">/</li>
            <li><a href="/bang-tin/" class="breadcrumb-link">Bảng tin</a></li>
            <li class="breadcrumb-separator" aria-hidden="true">/</li>
            <li class="breadcrumb-current" aria-current="page" title={announcement.title}>
              {announcement.title.length > 45 ? `${announcement.title.slice(0, 45)}...` : announcement.title}
            </li>
          </ol>
        </nav>
      </div>
    </div>

    <!-- Article Main Container -->
    <article class="article-container container">
      <!-- Article Header -->
      <header class="article-header">
        <div class="article-meta-top">
          <span class="meta-tag">THÔNG BÁO CHÍNH THỨC</span>
          {announcement.isPinned && <span class="meta-pinned">⭐ Ghim nổi bật</span>}
          <time class="meta-date" datetime={announcement.publishedAt || announcement.createdAt}>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect width="18" height="18" x="3" y="4" rx="2" ry="2"/>
              <line x1="16" x2="16" y1="2" y2="6"/>
              <line x1="8" x2="8" y1="2" y2="6"/>
              <line x1="3" x2="21" y1="10" y2="10"/>
            </svg>
            {new Date(announcement.publishedAt || announcement.createdAt).toLocaleDateString('vi-VN', {
              day: '2-digit',
              month: '2-digit',
              year: 'numeric'
            })}
          </time>
        </div>

        <h1 class="article-title">{announcement.title}</h1>

        <div class="article-summary-lead">
          <p>{announcement.summary}</p>
        </div>
      </header>

      <!-- Featured Cover Image (if present) -->
      {announcement.coverImage?.url && (
        <figure class="article-cover-figure">
          <img
            src={announcement.coverImage.url}
            alt={announcement.coverImage.alt || announcement.title}
            class="article-cover-img"
          />
          {announcement.coverImage.caption && (
            <figcaption class="article-cover-caption">{announcement.coverImage.caption}</figcaption>
          )}
        </figure>
      )}

      <!-- Main Rich Content Body -->
      <div class="article-body-content" set:html={announcement.content} />

      <!-- Attachments Section (PDF Documents) -->
      {announcement.attachments && announcement.attachments.length > 0 && (
        <section class="article-attachments-section" aria-labelledby="attachments-heading">
          <h2 id="attachments-heading" class="attachments-title">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2" aria-hidden="true">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
            </svg>
            <span>Tài liệu đính kèm ({announcement.attachments.length})</span>
          </h2>

          <div class="attachments-grid">
            {announcement.attachments.map((file) => (
              <div class="attachment-card">
                <div class="att-card-icon">
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                    <polyline points="14 2 14 8 20 8"/>
                    <line x1="16" x2="8" y1="13" y2="13"/>
                    <line x1="16" x2="8" y1="17" y2="17"/>
                    <polyline points="10 9 9 9 8 9"/>
                  </svg>
                </div>
                <div class="att-card-details">
                  <span class="att-card-name" title={file.originalName}>{file.originalName}</span>
                  <span class="att-card-size">Định dạng PDF • {(file.sizeBytes / 1024).toFixed(0)} KB</span>
                </div>
                <a
                  href={`/api/news/files/${file.id}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-att-download"
                  title="Tải xuống hoặc xem tệp PDF"
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                    <polyline points="7 10 12 15 17 10"/>
                    <line x1="12" y1="15" x2="12" y2="3"/>
                  </svg>
                  <span>Tải về</span>
                </a>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Bottom Nav & Hotline Support -->
      <footer class="article-footer">
        <div class="article-footer-inner">
          <a href="/bang-tin/" class="btn-back-list">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
            <span>Quay lại Bảng tin</span>
          </a>

          <div class="article-hotline-note">
            <span>Cần xác minh thông báo hoặc hỗ trợ dịch vụ? Hotline trực 24/7:</span>
            <a href={`tel:${companyInfo.hotline}`} class="hotline-link"><strong>{companyInfo.hotline}</strong></a>
          </div>
        </div>
      </footer>
    </article>
  </main>
</SiteLayout>

<style>
  .article-page {
    background-color: #ffffff;
    padding-bottom: 5rem;
  }

  /* Draft Banner */
  .draft-preview-banner {
    background-color: #fffbeb;
    border-bottom: 2px solid #f59e0b;
    color: #92400e;
    padding: 0.75rem 0;
  }

  .draft-banner-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: 0.9rem;
  }

  .btn-draft-edit {
    padding: 0.35rem 0.75rem;
    background: #f59e0b;
    color: #ffffff;
    font-weight: 700;
    border-radius: 4px;
    text-decoration: none;
    font-size: 0.825rem;
  }

  /* Breadcrumb */
  .breadcrumb-bar {
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
    padding: 0.75rem 0;
  }

  .breadcrumb-list {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.85rem;
    flex-wrap: wrap;
  }

  .breadcrumb-link {
    color: #64748b;
    text-decoration: none;
  }
  .breadcrumb-link:hover {
    color: #0284c7;
    text-decoration: underline;
  }

  .breadcrumb-separator {
    color: #cbd5e1;
  }

  .breadcrumb-current {
    color: #0f172a;
    font-weight: 600;
  }

  /* Container */
  .article-container {
    max-width: 860px;
    margin: 0 auto;
    padding-top: 2.5rem;
  }

  /* Header */
  .article-header {
    margin-bottom: 2rem;
  }

  .article-meta-top {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1rem;
    font-size: 0.85rem;
  }

  .meta-tag {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    background: #e0f2fe;
    color: #0369a1;
    font-weight: 700;
    border-radius: 4px;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }

  .meta-pinned {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    background: #fffbeb;
    color: #b45309;
    font-weight: 700;
    border-radius: 4px;
    font-size: 0.75rem;
  }

  .meta-date {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: #64748b;
  }

  .article-title {
    font-size: 1.85rem;
    font-weight: 800;
    line-height: 1.3;
    color: #0f172a;
    margin-bottom: 1.25rem;
  }

  @media (min-width: 768px) {
    .article-title {
      font-size: 2.25rem;
    }
  }

  .article-summary-lead {
    padding: 1.25rem 1.5rem;
    background: #f8fafc;
    border-left: 4px solid #0284c7;
    border-radius: 0 8px 8px 0;
    color: #334155;
    font-size: 1.05rem;
    line-height: 1.6;
    font-weight: 500;
  }

  .article-summary-lead p {
    margin: 0;
  }

  /* Cover figure */
  .article-cover-figure {
    margin: 2rem 0;
    border-radius: 12px;
    overflow: hidden;
    background: #f1f5f9;
  }

  .article-cover-img {
    width: 100%;
    max-height: 480px;
    object-fit: cover;
    display: block;
  }

  .article-cover-caption {
    padding: 0.6rem 1rem;
    font-size: 0.85rem;
    color: #64748b;
    text-align: center;
    background: #f8fafc;
    border-top: 1px solid #e2e8f0;
  }

  /* Rich Body Content */
  .article-body-content {
    font-size: 1.05rem;
    line-height: 1.8;
    color: #1e293b;
    margin-bottom: 3rem;
  }

  .article-body-content :global(h2) {
    font-size: 1.5rem;
    font-weight: 800;
    color: #0f172a;
    margin: 2rem 0 1rem;
  }

  .article-body-content :global(h3) {
    font-size: 1.25rem;
    font-weight: 700;
    color: #0f172a;
    margin: 1.75rem 0 0.75rem;
  }

  .article-body-content :global(p) {
    margin-bottom: 1.25rem;
  }

  .article-body-content :global(ul), .article-body-content :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.75rem;
  }

  .article-body-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .article-body-content :global(blockquote) {
    border-left: 4px solid #0284c7;
    padding: 0.75rem 1.25rem;
    margin: 1.5rem 0;
    background: #f0f9ff;
    color: #0369a1;
    border-radius: 0 6px 6px 0;
    font-style: italic;
  }

  .article-body-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 1.5rem 0;
  }

  .article-body-content :global(a) {
    color: #0284c7;
    text-decoration: underline;
  }
  .article-body-content :global(a:hover) {
    color: #0369a1;
  }

  /* Attachments */
  .article-attachments-section {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 1.5rem;
    margin-bottom: 3rem;
  }

  .attachments-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.15rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 1rem;
  }

  .attachments-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.85rem;
  }

  @media (min-width: 640px) {
    .attachments-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .attachment-card {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.85rem 1rem;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
  }

  .att-card-icon {
    flex-shrink: 0;
  }

  .att-card-details {
    flex: 1;
    overflow: hidden;
  }

  .att-card-name {
    display: block;
    font-weight: 600;
    font-size: 0.9rem;
    color: #0f172a;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .att-card-size {
    display: block;
    font-size: 0.75rem;
    color: #64748b;
    margin-top: 0.15rem;
  }

  .btn-att-download {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.75rem;
    background: #0284c7;
    color: #ffffff;
    font-size: 0.8rem;
    font-weight: 600;
    border-radius: 6px;
    text-decoration: none;
    flex-shrink: 0;
    transition: background 0.15s;
  }
  .btn-att-download:hover {
    background: #0369a1;
  }

  /* Footer */
  .article-footer {
    padding-top: 2rem;
    border-top: 1px solid #e2e8f0;
  }

  .article-footer-inner {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }

  @media (min-width: 640px) {
    .article-footer-inner {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .btn-back-list {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: #0284c7;
    font-weight: 700;
    text-decoration: none;
    font-size: 0.95rem;
  }
  .btn-back-list:hover {
    text-decoration: underline;
  }

  .article-hotline-note {
    font-size: 0.875rem;
    color: #64748b;
  }

  .hotline-link {
    color: #f95016;
    text-decoration: none;
  }
  .hotline-link:hover {
    text-decoration: underline;
  }
</style>

