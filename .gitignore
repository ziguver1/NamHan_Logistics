# ==========================================
# NAM HÂN LOGISTICS - Git Ignore Rules
# ==========================================

# 1. Build & Compilation Outputs
dist/
.astro/
build/
out/

# 2. Dependencies
node_modules/
.pnp
.pnp.js

# 3. Environment Variables & Credentials (BẢO MẬT: Tuyệt đối không commit)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# 4. Runtime & Local Data Storage (Dữ liệu chạy local)
.data/
*.enc
*.db
*.sqlite
*.sqlite3

# 5. Netlify Tooling & Deployment Cache
.netlify/
.netlify

# 6. Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 7. Scratch, Test Artifacts & Temporary Files
scratch/
temp/
tmp/
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/

# 8. Raw Design Assets & Figma Reference Dumps
# (Toàn bộ ảnh webp chuẩn đã được chọn lọc và tối ưu tại public/images/)
NAM HAN LOGISTICS/
NAM HÂN LOGISTICS/
design-reference/
*.fig

# 9. Operating System Files
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.trash

# 10. IDE & Code Editor Configurations
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.project
.classpath
.settings/

# 11. Lockfiles of unused package managers (Giữ package-lock.json cho npm)
yarn.lock
pnpm-lock.yaml
bun.lockb
